# ====================================================================
# MAHARAJA INSTITUTE OF TECHNOLOGY MYSORE - EXAMINATION MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# ====================================================================

# --------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CREDENTIALS
# --------------------------------------------------------------------
DB_NAME=campusexam_test
DB_USER=campusexam
DB_PASSWORD=your_secure_database_password_here

# --------------------------------------------------------------------
# 2. LAB SERVER CONFIGURATION
# --------------------------------------------------------------------
LAB_ID=LAB-CSE-01

# --------------------------------------------------------------------
# 3. PUBLIC ACCESS URLs (FOR BROWSER & LAN ACCESS)
# In standalone mode, use localhost.
# In LAN deployment, replace localhost with the Central Server's LAN IP
# (e.g. http://192.168.1.50:8081/api/v1).
# --------------------------------------------------------------------
CENTRAL_PUBLIC_URL=http://localhost:8081/api/v1
LAB_PUBLIC_URL=http://localhost:8082
