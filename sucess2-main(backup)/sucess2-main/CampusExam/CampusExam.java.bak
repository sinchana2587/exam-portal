    static String uploadV1HodStudentList(Connection db, User user, Form form) throws Exception {
        user.require("HOD");
        UserSession session = user.toSession(db);
        int sem = form.number("semesterNumber");
        String section = form.need("section");
        String fileName = form.get("fileName");
        String sourceType = form.get("sourceType");
        boolean isReplacement = "true".equalsIgnoreCase(form.get("isReplacement")) || "1".equals(form.get("isReplacement"));

        List<Object> students = form.list("students");
        if (students.isEmpty()) students = form.list("rows");
        List<Map<String, Object>> rowMaps = new ArrayList<>();
        for (Object o : students) {
            if (o instanceof Map<?,?> m) {
                Map<String, Object> r = new LinkedHashMap<>();
                for (Map.Entry<?,?> e : m.entrySet()) {
                    r.put(String.valueOf(e.getKey()), e.getValue());
                }
                rowMaps.add(r);
            }
        }

        if (rowMaps.isEmpty() && !form.get("fileBase64").isBlank()) {
            byte[] bytes = Base64.getDecoder().decode(form.get("fileBase64"));
            Map<String, Object> parsed = studentService.parseAndValidateExcelBytes(db, session, sem, section, bytes);
            int invalidCount = (int) parsed.get("invalidCount");
            if (invalidCount > 0) {
                List<?> errors = (List<?>) parsed.get("errors");
                String firstError = errors.isEmpty() ? "Invalid rows detected" : errors.get(0).toString();
                throw new IllegalArgumentException("Upload rejected: " + invalidCount + " invalid row(s) detected. " + firstError);
            }
            @SuppressWarnings("unchecked")
            List<Map<String, Object>> valRows = (List<Map<String, Object>>) parsed.get("validRecords");
            rowMaps = valRows;
        }

        Map<String, Object> res = studentService.commitStudentList(db, session, sem, section, fileName, sourceType, rowMaps, isReplacement);
        return Json.stringify(res);
    }

    static String replaceV1HodStudentList(Connection db, User user, Form form) throws Exception {
        user.require("HOD");
        UserSession session = user.toSession(db);
        int sem = form.number("semesterNumber");
        String section = form.need("section");
        String fileName = form.get("fileName");
        String sourceType = form.get("sourceType");

        List<Object> students = form.list("students");
        if (students.isEmpty()) students = form.list("rows");
        List<Map<String, Object>> rowMaps = new ArrayList<>();
        for (Object o : students) {
            if (o instanceof Map<?,?> m) {
                Map<String, Object> r = new LinkedHashMap<>();
                for (Map.Entry<?,?> e : m.entrySet()) {
                    r.put(String.valueOf(e.getKey()), e.getValue());
                }
                rowMaps.add(r);
            }
        }

        if (rowMaps.isEmpty() && !form.get("fileBase64").isBlank()) {
            byte[] bytes = Base64.getDecoder().decode(form.get("fileBase64"));
            Map<String, Object> parsed = studentService.parseAndValidateExcelBytes(db, session, sem, section, bytes);
            int invalidCount = (int) parsed.get("invalidCount");
            if (invalidCount > 0) {
                List<?> errors = (List<?>) parsed.get("errors");
                String firstError = errors.isEmpty() ? "Invalid rows detected" : errors.get(0).toString();
                throw new IllegalArgumentException("Upload rejected: " + invalidCount + " invalid row(s) detected. " + firstError);
            }
            @SuppressWarnings("unchecked")
            List<Map<String, Object>> valRows = (List<Map<String, Object>>) parsed.get("validRecords");
            rowMaps = valRows;
        }

        Map<String, Object> res = studentService.commitStudentList(db, session, sem, section, fileName, sourceType, rowMaps, true);
        return Json.stringify(res);
    }

    static String validateV1HodExcel(Connection db, User user, Form form) throws Exception {
        user.require("HOD");
        UserSession session = user.toSession(db);
        int sem = form.number("semesterNumber");
        String section = form.need("section");

        if (!form.get("fileBase64").isBlank()) {
            byte[] bytes = Base64.getDecoder().decode(form.get("fileBase64"));
            Map<String, Object> res = studentService.parseAndValidateExcelBytes(db, session, sem, section, bytes);
            return v1Success(res, "Excel validation complete");
        }

        List<Object> students = form.list("students");
        if (students.isEmpty()) students = form.list("rows");
        List<Map<String, Object>> rowMaps = new ArrayList<>();
        for (Object o : students) {
            if (o instanceof Map<?,?> m) {
                Map<String, Object> r = new LinkedHashMap<>();
                for (Map.Entry<?,?> e : m.entrySet()) {
                    r.put(String.valueOf(e.getKey()), e.getValue());
                }
                rowMaps.add(r);
            }
        }
        Map<String, Object> res = studentService.validateStudentRecords(db, session, sem, section, rowMaps);
        return v1Success(res, "Student validation complete");
    }

    static long ensureHodQuestionBank(Connection db, User user, long subjectId, Long deptId) throws SQLException {
        String bankIdStr = one(db, "SELECT id FROM question_bank WHERE subject_id=? AND department_id=? ORDER BY id DESC LIMIT 1", subjectId, deptId);
        if (!bankIdStr.isEmpty()) {
            return Long.parseLong(bankIdStr);
        }
        String semStr = one(db, "SELECT coalesce(semester, 5) FROM subject WHERE id=?", subjectId);
        int sem = semStr.isBlank() ? 5 : Integer.parseInt(semStr);
        String subCode = one(db, "SELECT coalesce(code, 'SUB') FROM subject WHERE id=?", subjectId);
        return insert(db, """
                INSERT INTO question_bank(department_id, subject_id, academic_session, semester, title, created_by, state, revision_number, total_questions)
                VALUES(?, ?, '2026-27', ?, ?, ?, 'DRAFT', 1, 0)
                """, deptId, subjectId, sem, subCode + " Question Bank", user.id());
    }

    static String getV1HodQuestions(Connection db, User user, Form form) throws SQLException {
        user.require("HOD");
        long subjectId = form.id("subjectId");
        String subDeptStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!subDeptStr.isBlank(), 404, "Subject not found");
        check(user.departmentId() != null && user.departmentId().equals(Long.parseLong(subDeptStr)), 403, "Access denied: Subject does not belong to your department");

        List<Map<String, Object>> items = new ArrayList<>();
        try (var st = sql(db, """
                SELECT qbi.id, qbi.question_uid, qbi.module_number, qbi.prompt, qbi.options, qbi.correct, qbi.marks,
                       qbi.has_images, qbi.stem_images, qbi.option_images, qbi.created_at, coalesce(qbi.status, 'Active')
                FROM question_bank_item qbi
                JOIN question_bank qb ON qb.id = qbi.bank_id
                WHERE qb.subject_id = ? AND qb.department_id = ?
                ORDER BY qbi.module_number, qbi.id
                """, subjectId, user.departmentId()); var rs = st.executeQuery()) {
            while (rs.next()) {
                long qId = rs.getLong(1);
                String qUid = rs.getString(2);
                int mod = rs.getInt(3);
                String prompt = rs.getString(4);
                Array optsArr = rs.getArray(5);
                String[] opts = optsArr != null ? (String[]) optsArr.getArray() : new String[]{"", "", "", ""};
                int cor = rs.getInt(6);
                String corLetter = cor == 2 ? "B" : cor == 3 ? "C" : cor == 4 ? "D" : "A";
                boolean hasImgs = rs.getBoolean(8);
                String stemStr = rs.getString(9);
                String optImgsStr = rs.getString(10);
                String createdAt = rs.getTimestamp(11) != null ? rs.getTimestamp(11).toInstant().toString() : Instant.now().toString();
                String statusVal = rs.getString(12);
                if (statusVal == null || statusVal.isBlank()) statusVal = "Active";

                List<Object> qImgs = new ArrayList<>();
                if (stemStr != null && !stemStr.isBlank() && !stemStr.equals("[]")) {
                    try {
                        Object parsed = Json.parse(stemStr);
                        if (parsed instanceof List<?> l) qImgs.addAll(l);
                    } catch (Exception ignored) {}
                }

                List<Object> optAImgs = new ArrayList<>();
                List<Object> optBImgs = new ArrayList<>();
                List<Object> optCImgs = new ArrayList<>();
                List<Object> optDImgs = new ArrayList<>();
                if (optImgsStr != null && !optImgsStr.isBlank() && !optImgsStr.equals("[]")) {
                    try {
                        Object parsed = Json.parse(optImgsStr);
                        if (parsed instanceof List<?> l) {
                            for (Object o : l) {
                                if (o instanceof Map<?,?> m) {
                                    String tf = String.valueOf(m.get("targetField")).toUpperCase(Locale.ROOT);
                                    if ("OPTION_A".equals(tf)) optAImgs.add(m);
                                    else if ("OPTION_B".equals(tf)) optBImgs.add(m);
                                    else if ("OPTION_C".equals(tf)) optCImgs.add(m);
                                    else if ("OPTION_D".equals(tf)) optDImgs.add(m);
                                }
                            }
                        }
                    } catch (Exception ignored) {}
                }

                Map<String, Object> item = new LinkedHashMap<>();
                item.put("id", String.valueOf(qId));
                item.put("questionId", qUid != null ? qUid : ("Q-" + qId));
                item.put("subjectId", String.valueOf(subjectId));
                item.put("departmentId", String.valueOf(user.departmentId()));
                item.put("moduleNumber", mod);
                item.put("questionText", prompt != null ? prompt : "");
                item.put("optionA", opts.length > 0 && opts[0] != null ? opts[0] : "");
                item.put("optionB", opts.length > 1 && opts[1] != null ? opts[1] : "");
                item.put("optionC", opts.length > 2 && opts[2] != null ? opts[2] : "");
                item.put("optionD", opts.length > 3 && opts[3] != null ? opts[3] : "");
                item.put("correctOption", corLetter);
                item.put("status", statusVal);
                item.put("hasImages", hasImgs || !qImgs.isEmpty() || !optAImgs.isEmpty() || !optBImgs.isEmpty() || !optCImgs.isEmpty() || !optDImgs.isEmpty());
                item.put("questionImages", qImgs);
                item.put("optionAImages", optAImgs);
                item.put("optionBImages", optBImgs);
                item.put("optionCImages", optCImgs);
                item.put("optionDImages", optDImgs);
                item.put("createdAt", createdAt);
                item.put("updatedAt", createdAt);
                items.add(item);
            }
        }
        return v1Success(items, "Questions loaded");
    }

    static String uploadV1HodQuestions(Connection db, User user, Form form) throws SQLException {
        user.require("HOD");
        long subjectId = form.id("subjectId");
        Long userDeptId = user.departmentId();

        Long subDeptId = null;
        String subStatus = null;
        int maxModules = 5;
        try (var st = sql(db, "SELECT department_id, status, module_count FROM subject WHERE id=?", subjectId);
             var rs = st.executeQuery()) {
            if (!rs.next()) {
                throw new Problem(404, "Subject not found");
            }
            subDeptId = rs.getObject(1) != null ? rs.getLong(1) : null;
            subStatus = rs.getString(2);
            maxModules = rs.getInt(3);
        }

        check("ACTIVE".equalsIgnoreCase(subStatus), 400, "Cannot add questions to an inactive or archived subject.");
        if (userDeptId != null && subDeptId != null && !userDeptId.equals(subDeptId)) {
            throw new Problem(403, "Access denied. Subject does not belong to your department.");
        }

        long bankId = ensureHodQuestionBank(db, user, subjectId, subDeptId != null ? subDeptId : userDeptId);

        int module = form.number("moduleNumber");
        if (module < 1) module = 1;
        check(module <= maxModules, 400, "Module number " + module + " exceeds the subject's maximum of " + maxModules + " modules.");

        String prompt = form.get("questionText").trim();
        String optA = form.get("optionA").trim();
        String optB = form.get("optionB").trim();
        String optC = form.get("optionC").trim();
        String optD = form.get("optionD").trim();
        String[] opts = {optA, optB, optC, optD};
        String correctStr = form.need("correctOption").toUpperCase(Locale.ROOT);
        int correct = correctStr.equals("A") ? 1 : correctStr.equals("B") ? 2 : correctStr.equals("C") ? 3 : 4;
        String qUid = "Q-M" + module + "-" + HexFormat.of().formatHex(RANDOM.generateSeed(5)).toUpperCase(Locale.ROOT);

        long qId = insert(db, """
                INSERT INTO question_bank_item(bank_id, question_uid, module_number, prompt, options, correct, marks, has_images, stem_images, option_images)
                VALUES(?,?,?,?,?,?,1.00,false,'[]'::jsonb,'[]'::jsonb)
                """, bankId, qUid, module, prompt, db.createArrayOf("text", opts), correct);
        run(db, "UPDATE question_bank SET total_questions = (SELECT count(*) FROM question_bank_item WHERE bank_id=?) WHERE id=?", bankId, bankId);

        String nowIso = Instant.now().toString();
        Map<String, Object> item = new LinkedHashMap<>();
        item.put("id", String.valueOf(qId));
        item.put("questionId", qUid);
        item.put("subjectId", String.valueOf(subjectId));
        item.put("departmentId", String.valueOf(userDeptId));
        item.put("moduleNumber", module);
        item.put("questionText", prompt);
        item.put("optionA", optA);
        item.put("optionB", optB);
        item.put("optionC", optC);
        item.put("optionD", optD);
        item.put("correctOption", correctStr);
        item.put("status", "Active");
        item.put("hasImages", false);
        item.put("questionImages", List.of());
        item.put("optionAImages", List.of());
        item.put("optionBImages", List.of());
        item.put("optionCImages", List.of());
        item.put("optionDImages", List.of());
        item.put("createdAt", nowIso);
        item.put("updatedAt", nowIso);
        return v1Success(item, "Question uploaded successfully");
    }

    static String bulkUploadV1HodQuestions(Connection db, User user, Form form) throws SQLException {
        user.require("HOD");
        long subjectId = form.id("subjectId");
        Long userDeptId = user.departmentId();

        // 1. Verify subject existence, status, department authorization and module count
        Long subDeptId = null;
        String subStatus = null;
        int maxModules = 5;
        try (var st = sql(db, "SELECT department_id, status, module_count FROM subject WHERE id=?", subjectId);
             var rs = st.executeQuery()) {
            if (!rs.next()) {
                throw new Problem(404, "Subject not found");
            }
            subDeptId = rs.getObject(1) != null ? rs.getLong(1) : null;
            subStatus = rs.getString(2);
            maxModules = rs.getInt(3);
        }

        check("ACTIVE".equalsIgnoreCase(subStatus), 400, "Cannot import questions into an inactive or archived subject.");

        if (userDeptId != null && subDeptId != null && !userDeptId.equals(subDeptId)) {
            throw new Problem(403, "Access denied. Subject does not belong to your department.");
        }

        long bankId = ensureHodQuestionBank(db, user, subjectId, subDeptId != null ? subDeptId : userDeptId);

        Integer selectedModule = null;
        if (!form.get("selectedModuleNumber").isBlank()) {
            try { selectedModule = Integer.parseInt(form.get("selectedModuleNumber").trim()); } catch (Exception ignored) {}
        } else if (!form.get("moduleNumber").isBlank()) {
            try { selectedModule = Integer.parseInt(form.get("moduleNumber").trim()); } catch (Exception ignored) {}
        }

        List<Object> rows = form.list("rows");
        if (rows.isEmpty()) {
            rows = form.list("questions");
        }
        check(!rows.isEmpty(), 400, "No questions provided for import.");

        // Preload existing normalized prompts in this bank to skip duplicates cleanly
        Set<String> existingPrompts = new HashSet<>();
        try (var st = sql(db, "SELECT lower(btrim(prompt)), stem_images FROM question_bank_item WHERE bank_id=?", bankId);
             var rs = st.executeQuery()) {
            while (rs.next()) {
                String p = rs.getString(1);
                if (p != null && !p.isBlank()) {
                    existingPrompts.add(p);
                } else {
                    String si = rs.getString(2);
                    if (si != null && !si.isBlank()) existingPrompts.add(si);
                }
            }
        }

        int count = 0;
        int skippedDuplicates = 0;
        List<String> assignedIds = new ArrayList<>();

        boolean originalAutoCommit = db.getAutoCommit();
        db.setAutoCommit(false);
        try {
            for (Object item : rows) {
                if (item instanceof Map<?,?> m) {
                    int mod = 1;
                    if (m.get("moduleNumber") != null) {
                        try { mod = Integer.parseInt(String.valueOf(m.get("moduleNumber")).trim()); } catch (Exception ignored) {}
                    } else if (selectedModule != null) {
                        mod = selectedModule;
                    }

                    check(mod >= 1 && mod <= maxModules, 400,
                            "Module number " + mod + " exceeds the subject's maximum of " + maxModules + " modules.");
                    if (selectedModule != null) {
                        check(mod == selectedModule, 400,
                                "Strict Module-Wise Rule: Question belongs to Module " + mod + ", but selected upload batch is Module " + selectedModule);
                    }

                    String prompt = "";
                    for (String k : new String[]{"questionText", "prompt", "Questions", "Question Text", "question"}) {
                        if (m.get(k) != null && !String.valueOf(m.get(k)).trim().isEmpty()) {
                            prompt = String.valueOf(m.get(k)).trim();
                            break;
                        }
                    }
                    String optA = "";
                    for (String k : new String[]{"optionA", "option A", "Option A", "A"}) {
                        if (m.get(k) != null && !String.valueOf(m.get(k)).trim().isEmpty()) {
                            optA = String.valueOf(m.get(k)).trim();
                            break;
                        }
                    }
                    String optB = "";
                    for (String k : new String[]{"optionB", "option B", "Option B", "B"}) {
                        if (m.get(k) != null && !String.valueOf(m.get(k)).trim().isEmpty()) {
                            optB = String.valueOf(m.get(k)).trim();
                            break;
                        }
                    }
                    String optC = "";
                    for (String k : new String[]{"optionC", "option C", "Option C", "C"}) {
                        if (m.get(k) != null && !String.valueOf(m.get(k)).trim().isEmpty()) {
                            optC = String.valueOf(m.get(k)).trim();
                            break;
                        }
                    }
                    String optD = "";
                    for (String k : new String[]{"optionD", "option D ", "option D", "Option D", "D"}) {
                        if (m.get(k) != null && !String.valueOf(m.get(k)).trim().isEmpty()) {
                            optD = String.valueOf(m.get(k)).trim();
                            break;
                        }
                    }

                    // Extract question stem images
                    List<Object> qImgs = new ArrayList<>();
                    if (m.get("questionImages") instanceof List<?> l) {
                        qImgs.addAll(l);
                    }

                    // Extract option images
                    List<Object> optAImgs = new ArrayList<>();
                    if (m.get("optionAImages") instanceof List<?> l) optAImgs.addAll(l);
                    List<Object> optBImgs = new ArrayList<>();
                    if (m.get("optionBImages") instanceof List<?> l) optBImgs.addAll(l);
                    List<Object> optCImgs = new ArrayList<>();
                    if (m.get("optionCImages") instanceof List<?> l) optCImgs.addAll(l);
                    List<Object> optDImgs = new ArrayList<>();
                    if (m.get("optionDImages") instanceof List<?> l) optDImgs.addAll(l);

                    List<Object> allOptionImages = new ArrayList<>();
                    for (Object o : optAImgs) {
                        if (o instanceof Map<?,?> imgMap) {
                            Map<String, Object> copy = new LinkedHashMap<>();
                            imgMap.forEach((k, v) -> copy.put(String.valueOf(k), v));
                            copy.put("targetField", "OPTION_A");
                            allOptionImages.add(copy);
                        }
                    }
                    for (Object o : optBImgs) {
                        if (o instanceof Map<?,?> imgMap) {
                            Map<String, Object> copy = new LinkedHashMap<>();
                            imgMap.forEach((k, v) -> copy.put(String.valueOf(k), v));
                            copy.put("targetField", "OPTION_B");
                            allOptionImages.add(copy);
                        }
                    }
                    for (Object o : optCImgs) {
                        if (o instanceof Map<?,?> imgMap) {
                            Map<String, Object> copy = new LinkedHashMap<>();
                            imgMap.forEach((k, v) -> copy.put(String.valueOf(k), v));
                            copy.put("targetField", "OPTION_C");
                            allOptionImages.add(copy);
                        }
                    }
                    for (Object o : optDImgs) {
                        if (o instanceof Map<?,?> imgMap) {
                            Map<String, Object> copy = new LinkedHashMap<>();
                            imgMap.forEach((k, v) -> copy.put(String.valueOf(k), v));
                            copy.put("targetField", "OPTION_D");
                            allOptionImages.add(copy);
                        }
                    }

                    // Support image-only questions and image-only options
                    boolean hasStem = !prompt.isEmpty() || !qImgs.isEmpty();
                    boolean hasOptA = !optA.isEmpty() || !optAImgs.isEmpty();
                    boolean hasOptB = !optB.isEmpty() || !optBImgs.isEmpty();
                    boolean hasOptC = !optC.isEmpty() || !optCImgs.isEmpty();
                    boolean hasOptD = !optD.isEmpty() || !optDImgs.isEmpty();

                    if (!hasStem || !hasOptA || !hasOptB || !hasOptC || !hasOptD) {
                        continue;
                    }

                    String corStr = "";
                    for (String k : new String[]{"correctOption", "keyAnswer", "Key Answer", "correct", "key"}) {
                        if (m.get(k) != null && !String.valueOf(m.get(k)).trim().isEmpty()) {
                            corStr = String.valueOf(m.get(k)).trim().toUpperCase(Locale.ROOT);
                            break;
                        }
                    }
                    if (corStr.startsWith("OPTION ")) corStr = corStr.substring(7).trim();
                    if (corStr.startsWith("OPTION")) corStr = corStr.substring(6).trim();
                    int correct = corStr.equals("B") ? 2 : corStr.equals("C") ? 3 : corStr.equals("D") ? 4 : 1;

                    // Deduplication against existing questions
                    String normPrompt = prompt.toLowerCase(Locale.ROOT);
                    if (normPrompt.isEmpty()) {
                        normPrompt = "[image:" + Json.stringify(qImgs) + "]";
                    }
                    if (existingPrompts.contains(normPrompt)) {
                        skippedDuplicates++;
                        continue;
                    }
                    existingPrompts.add(normPrompt);

                    String qUid = "Q-M" + mod + "-" + HexFormat.of().formatHex(RANDOM.generateSeed(5)).toUpperCase(Locale.ROOT);
                    String[] opts = {optA, optB, optC, optD};
                    boolean hasImages = !qImgs.isEmpty() || !allOptionImages.isEmpty();
                    String stemJson = Json.stringify(qImgs);
                    String optJson = Json.stringify(allOptionImages);

                    insert(db, """
                            INSERT INTO question_bank_item(bank_id, question_uid, module_number, prompt, options, correct, marks, has_images, stem_images, option_images)
                            VALUES(?,?,?,?,?,?,1.00,?,?::jsonb,?::jsonb)
                            """, bankId, qUid, mod, prompt, db.createArrayOf("text", opts), correct, hasImages, stemJson, optJson);
                    assignedIds.add(qUid);
                    count++;
                }
            }

            run(db, "UPDATE question_bank SET total_questions = (SELECT count(*) FROM question_bank_item WHERE bank_id=?) WHERE id=?", bankId, bankId);
            db.commit();
        } catch (Exception ex) {
            db.rollback();
            throw ex;
        } finally {
            db.setAutoCommit(originalAutoCommit);
        }

        audit(db, user.id(), "BULK_UPLOAD_QUESTIONS", "question_bank:" + bankId, "Imported " + count + " questions into question bank (" + skippedDuplicates + " skipped duplicates)");
        Map<String, Object> result = new LinkedHashMap<>();
        result.put("importedCount", count);
        result.put("skippedDuplicates", skippedDuplicates);
        result.put("assignedQuestionIds", assignedIds);
        return v1Success(result, "Imported " + count + " question(s) successfully");
    }

    static Map<String, Object> buildAndPersistStageASets(
            Connection db,
            User user,
            long subjectId,
            long bankId,
            Map<Integer, Integer> dist,
            String generationId
    ) throws SQLException {
        int maxModules = Integer.parseInt(one(db, "SELECT coalesce(module_count, 5) FROM subject WHERE id=?", subjectId));

        // Count available questions per module - ONLY valid, active, non-archived questions
        Map<Integer, List<Long>> poolByMod = new LinkedHashMap<>();
        int totalPool = 0;
        for (int m = 1; m <= maxModules; m++) poolByMod.put(m, new ArrayList<>());

        try (var st = sql(db, """
                SELECT id, module_number, prompt, options, correct, stem_images, option_images, coalesce(status, 'Active')
                FROM question_bank_item
                WHERE bank_id=? AND coalesce(status, 'Active') = 'Active'
                ORDER BY id
                """, bankId);
             var rs = st.executeQuery()) {
            while (rs.next()) {
                long qId = rs.getLong(1);
                int m = rs.getInt(2);
                String prompt = rs.getString(3);
                Array optsArr = rs.getArray(4);
                String[] opts = optsArr != null ? (String[]) optsArr.getArray() : new String[0];
                int cor = rs.getInt(5);
                String stemImg = rs.getString(6);
                String optImg = rs.getString(7);

                // Validity check: stem containing text or valid image
                boolean hasStem = (prompt != null && !prompt.trim().isEmpty()) || (stemImg != null && !stemImg.trim().isEmpty() && !stemImg.equals("[]"));
                if (!hasStem) continue;
                // Correct answer must be between 1 and 4
                if (cor < 1 || cor > 4) continue;
                // All 4 options must contain text or valid associated images
                if (opts.length < 4) continue;
                boolean optValid = true;
                for (int i = 0; i < 4; i++) {
                    String optText = opts[i] != null ? opts[i].trim() : "";
                    boolean hasOptImg = optImg != null && optImg.contains("OPTION_" + (char)('A' + i));
                    if (optText.isEmpty() && !hasOptImg) {
                        optValid = false;
                        break;
                    }
                }
                if (!optValid) continue;

                if (m >= 1 && m <= maxModules) {
                    poolByMod.get(m).add(qId);
                    totalPool++;
                }
            }
        }

        // Compute max strictly disjoint sets supported
        int maxSets = Integer.MAX_VALUE;
        int questionsPerSet = 0;
        Map<String, Integer> distOut = new LinkedHashMap<>();
        for (Map.Entry<Integer, Integer> e : dist.entrySet()) {
            int m = e.getKey();
            int req = Math.max(0, e.getValue());
            distOut.put(String.valueOf(m), req);
            questionsPerSet += req;
            if (req > 0) {
                int avail = poolByMod.getOrDefault(m, List.of()).size();
                maxSets = Math.min(maxSets, avail / req);
            }
        }
        if (questionsPerSet == 0 || maxSets == Integer.MAX_VALUE) maxSets = 0;
        check(maxSets >= 1, 400, "Insufficient questions across configured modules to generate even 1 complete disjoint set.");

        // Persist ALL disjoint paper sets in generated_paper / generated_paper_question (FK-safe upsert)
        // NO ARTIFICIAL 4-SET LIMIT!
        List<Map<String, Object>> setStatuses = new ArrayList<>();
        for (int p = 1; p <= maxSets; p++) {
            long paperId = insert(db,
                    "INSERT INTO generated_paper(bank_id, paper_number, title, status) VALUES(?, ?, ?, 'READY') " +
                    "ON CONFLICT (bank_id, paper_number) DO UPDATE SET title=EXCLUDED.title, status='READY'",
                    bankId, p, "Set " + p);
            run(db, "DELETE FROM generated_paper_question WHERE paper_id=?", paperId);
            int pos = 1;
            for (Map.Entry<Integer, Integer> e : dist.entrySet()) {
                int m = e.getKey();
                int req = Math.max(0, e.getValue());
                if (req == 0) continue;
                List<Long> modIds = poolByMod.getOrDefault(m, List.of());
                int offset = (p - 1) * req;
                for (int i = 0; i < req && (offset + i) < modIds.size() && pos <= questionsPerSet; i++) {
                    run(db, "INSERT INTO generated_paper_question(paper_id, question_id, module_number, paper_position) VALUES(?,?,?,?)",
                            paperId, modIds.get(offset + i), m, pos);
                    pos++;
                }
            }
        }
        // Clean up any extra sets if previously maxSets was higher
        run(db, "DELETE FROM generated_paper WHERE bank_id=? AND paper_number > ?", bankId, maxSets);

        for (int s = 1; s <= maxSets; s++) {
            Map<String, Object> stItem = new LinkedHashMap<>();
            stItem.put("setNumber", s);
            stItem.put("setLabel", "Set " + s);
            stItem.put("questionCount", questionsPerSet);
            stItem.put("totalQuestions", questionsPerSet);
            stItem.put("status", "Available");
            stItem.put("publicationStatus", "Not Published");
            setStatuses.add(stItem);
        }

        String semStr = one(db, "SELECT coalesce(semester, 5) FROM subject WHERE id=?", subjectId);
        int sem = semStr.isBlank() ? 5 : Integer.parseInt(semStr);

        Map<String, Object> summary = new LinkedHashMap<>();
        summary.put("generationId", generationId);
        summary.put("departmentId", String.valueOf(user.departmentId()));
        summary.put("semesterNumber", sem);
        summary.put("subjectId", String.valueOf(subjectId));
        summary.put("questionBankRevisionId", "QBR-" + bankId + "-" + totalPool);
        summary.put("blueprintRevisionId", "BPR-" + questionsPerSet);
        summary.put("generatedSetCount", maxSets);
        summary.put("questionsPerSet", questionsPerSet);
        summary.put("moduleDistribution", distOut);
        summary.put("totalUniqueQuestionsAllocated", maxSets * questionsPerSet);
        summary.put("poolQuestionCount", totalPool);
        summary.put("overlapAcrossSets", 0);
        summary.put("integrityVerified", true);
        summary.put("publicationStatus", "Not Published");
        summary.put("setStatuses", setStatuses);
        return summary;
    }

    static String getV1HodBlueprint(Connection db, User user, long subjectId) throws SQLException {
        user.require("HOD", "PRINCIPAL", "COE", "ADMIN");
        String subDeptStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!subDeptStr.isBlank(), 404, "Subject not found");
        if (user.role().equalsIgnoreCase("HOD")) {
            Long deptId = user.departmentId();
            check(deptId != null && deptId.equals(Long.parseLong(subDeptStr)), 403, "Access denied: Subject does not belong to your department");
        }
        try (var st = sql(db, "SELECT total_questions, module_distribution FROM paper_blueprint WHERE subject_id=?", subjectId);
             var rs = st.executeQuery()) {
            if (rs.next()) {
                int totalQ = rs.getInt(1);
                String modDistJson = rs.getString(2);
                Map<String, Object> bp = new LinkedHashMap<>();
                bp.put("totalQuestions", totalQ);
                bp.put("moduleDistribution", Json.parse(modDistJson));
                return v1Success(bp, "Blueprint loaded");
            } else {
                return v1Success(null, "No blueprint configured");
            }
        }
    }

    static String saveV1HodBlueprint(Connection db, User user, long subjectId, Form form) throws SQLException {
        user.require("HOD");
        String subDeptStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!subDeptStr.isBlank(), 404, "Subject not found");
        Long deptId = user.departmentId();
        check(deptId != null && deptId.equals(Long.parseLong(subDeptStr)), 403, "Access denied: Subject does not belong to your department");

        int maxModules = Integer.parseInt(one(db, "SELECT coalesce(module_count, 5) FROM subject WHERE id=?", subjectId));
        int totalQuestions = 0;
        if (form.values().get("totalQuestions") != null) {
            try {
                totalQuestions = (int) Math.floor(Double.parseDouble(String.valueOf(form.values().get("totalQuestions"))));
            } catch (Exception ignored) {}
        }
        check(totalQuestions > 0, 400, "Total number of questions must be greater than zero.");

        Map<String, Integer> dist = new LinkedHashMap<>();
        Object rawDist = form.values().get("moduleDistribution");
        check(rawDist instanceof Map<?, ?>, 400, "Module distribution must be provided as a map of module number to question count.");
        Map<?, ?> distMap = (Map<?, ?>) rawDist;

        int sum = 0;
        for (int m = 1; m <= maxModules; m++) {
            Object val = distMap.get(String.valueOf(m));
            if (val == null) val = distMap.get(m);
            int count = 0;
            if (val != null) {
                try {
                    count = (int) Math.floor(Double.parseDouble(String.valueOf(val)));
                } catch (Exception ignored) {}
            }
            check(count >= 0, 400, "Question requirement for Module " + m + " cannot be negative.");
            dist.put(String.valueOf(m), count);
            sum += count;
        }

        // Verify no modules outside 1..maxModules have requirements > 0
        for (Map.Entry<?, ?> entry : distMap.entrySet()) {
            try {
                int modNum = Integer.parseInt(String.valueOf(entry.getKey()).trim());
                if (modNum < 1 || modNum > maxModules) {
                    int c = (int) Math.floor(Double.parseDouble(String.valueOf(entry.getValue())));
                    check(c == 0, 400, "Module " + modNum + " is invalid. This subject only has " + maxModules + " modules.");
                }
            } catch (NumberFormatException ignored) {}
        }

        check(sum == totalQuestions, 400, "Sum of module question counts (" + sum + ") must equal configured total questions (" + totalQuestions + ").");

        String distJson = Json.stringify(dist);
        run(db, """
                INSERT INTO paper_blueprint(subject_id, total_questions, module_distribution, updated_by, updated_at)
                VALUES(?, ?, ?::jsonb, ?, clock_timestamp())
                ON CONFLICT (subject_id) DO UPDATE SET
                    total_questions = EXCLUDED.total_questions,
                    module_distribution = EXCLUDED.module_distribution,
                    updated_by = EXCLUDED.updated_by,
                    updated_at = clock_timestamp()
                """, subjectId, totalQuestions, distJson, user.id());

        audit(db, user.id(), "HOD_BLUEPRINT_SAVED", "subject_blueprint:" + subjectId, "Saved blueprint with " + totalQuestions + " questions across " + maxModules + " modules.");

        Map<String, Object> result = new LinkedHashMap<>();
        result.put("totalQuestions", totalQuestions);
        result.put("moduleDistribution", dist);
        return v1Success(result, "Paper blueprint saved successfully");
    }

    static String setV1HodQuestionStatus(Connection db, User user, String qIdStr, Form form) throws SQLException {
        user.require("HOD");
        Long deptId = user.departmentId();

        long qbiId = -1;
        try { qbiId = Long.parseLong(qIdStr); } catch (Exception ignored) {}

        String bankDeptIdStr = one(db, """
                SELECT qb.department_id FROM question_bank_item qbi
                JOIN question_bank qb ON qb.id = qbi.bank_id
                WHERE qbi.id = ? OR qbi.question_uid = ?
                LIMIT 1
                """, qbiId, qIdStr);
        check(!bankDeptIdStr.isBlank(), 404, "Question not found");
        check(deptId != null && deptId.equals(Long.parseLong(bankDeptIdStr)), 403, "Access denied: Question does not belong to your department");

        String status = form.get("status");
        if (status.isBlank() && form.values().get("status") != null) {
            status = String.valueOf(form.values().get("status"));
        }
        check(status.equals("Active") || status.equals("Archived"), 400, "Invalid status: must be Active or Archived");

        run(db, "UPDATE question_bank_item SET status = ? WHERE id = ? OR question_uid = ?", status, qbiId, qIdStr);
        audit(db, user.id(), "HOD_QUESTION_STATUS_UPDATED", "question:" + qIdStr, "Updated status to " + status);

        Map<String, Object> res = new LinkedHashMap<>();
        res.put("questionId", qIdStr);
        res.put("status", status);
        return v1Success(res, "Question status updated to " + status);
    }

    static String updateV1HodQuestion(Connection db, User user, String qIdStr, Form form) throws SQLException {
        user.require("HOD");
        Long deptId = user.departmentId();

        long qbiId = -1;
        try { qbiId = Long.parseLong(qIdStr); } catch (Exception ignored) {}

        String bankDeptIdStr = one(db, """
                SELECT qb.department_id FROM question_bank_item qbi
                JOIN question_bank qb ON qb.id = qbi.bank_id
                WHERE qbi.id = ? OR qbi.question_uid = ?
                LIMIT 1
                """, qbiId, qIdStr);
        check(!bankDeptIdStr.isBlank(), 404, "Question not found");
        check(deptId != null && deptId.equals(Long.parseLong(bankDeptIdStr)), 403, "Access denied: Question does not belong to your department");

        String prompt = form.get("questionText");
        String optA = form.get("optionA");
        String optB = form.get("optionB");
        String optC = form.get("optionC");
        String optD = form.get("optionD");
        String corStr = form.get("correctOption").toUpperCase(Locale.ROOT);
        int correct = "B".equals(corStr) ? 2 : "C".equals(corStr) ? 3 : "D".equals(corStr) ? 4 : 1;
        String[] opts = {optA, optB, optC, optD};

        run(db, """
                UPDATE question_bank_item
                SET prompt = ?, options = ?, correct = ?
                WHERE id = ? OR question_uid = ?
                """, prompt, db.createArrayOf("text", opts), correct, qbiId, qIdStr);

        audit(db, user.id(), "HOD_QUESTION_UPDATED", "question:" + qIdStr, "Updated question text/options");

        Map<String, Object> res = new LinkedHashMap<>();
        res.put("questionId", qIdStr);
        res.put("questionText", prompt);
        res.put("correctOption", corStr);
        return v1Success(res, "Question updated successfully");
    }

    static String getV1CoePublishedSetsComposition(Connection db, User user, long subjectId) throws SQLException {
        if (user.role().equalsIgnoreCase("HOD") || user.role().equalsIgnoreCase("PRINCIPAL")) {
            check(false, 403, "Forbidden: Generated question set composition and Question ID mappings are confidential and inaccessible to HOD/Principal roles.");
        }
        user.require("COE", "ADMIN");

        String bankIdStr = one(db, "SELECT id FROM question_bank WHERE subject_id=? ORDER BY CASE WHEN state='FINALIZED' THEN 0 ELSE 1 END, id DESC LIMIT 1", subjectId);
        check(!bankIdStr.isBlank(), 404, "No question bank found for this subject");
        long bankId = Long.parseLong(bankIdStr);

        List<Map<String, Object>> setsList = new ArrayList<>();
        try (var st = sql(db, "SELECT id, paper_number FROM generated_paper WHERE bank_id=? ORDER BY paper_number ASC", bankId);
             var rs = st.executeQuery()) {
            while (rs.next()) {
                long paperId = rs.getLong(1);
                int pNum = rs.getInt(2);

                List<String> qUids = new ArrayList<>();
                Map<String, Integer> modCounts = new LinkedHashMap<>();
                try (var qSt = sql(db, """
                        SELECT coalesce(qbi.question_uid, 'Q-' || qbi.id), gpq.module_number
                        FROM generated_paper_question gpq
                        JOIN question_bank_item qbi ON qbi.id = gpq.question_id
                        WHERE gpq.paper_id = ?
                        ORDER BY gpq.paper_position ASC
                        """, paperId); var qRs = qSt.executeQuery()) {
                    while (qRs.next()) {
                        qUids.add(qRs.getString(1));
                        int m = qRs.getInt(2);
                        modCounts.put(String.valueOf(m), modCounts.getOrDefault(String.valueOf(m), 0) + 1);
                    }
                }

                Map<String, Object> setObj = new LinkedHashMap<>();
                setObj.put("setNumber", pNum);
                setObj.put("totalQuestions", qUids.size());
                setObj.put("moduleCounts", modCounts);
                setObj.put("questionIds", qUids);
                setsList.add(setObj);
            }
        }

        Map<String, Object> resp = new LinkedHashMap<>();
        resp.put("revisionNumber", "R1");
        resp.put("setsGeneratedCount", setsList.size());
        resp.put("numberedSets", setsList);
        return v1Success(resp, "Published set composition loaded");
    }

    static String generateV1HodQuestionSets(Connection db, User user, long subjectId, Form form) throws SQLException {
        user.require("HOD");
        String subDeptStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!subDeptStr.isBlank(), 404, "Subject not found");
        Long deptId = user.departmentId();
        check(deptId != null && deptId.equals(Long.parseLong(subDeptStr)), 403, "Access denied: Subject does not belong to your department");

        String bankIdStr = one(db, "SELECT id FROM question_bank WHERE subject_id=? AND department_id=? ORDER BY id DESC LIMIT 1", subjectId, deptId);
        check(!bankIdStr.isEmpty(), 400, "No question bank found for this subject. Upload questions first.");
        long bankId = Long.parseLong(bankIdStr);

        int maxModules = Integer.parseInt(one(db, "SELECT coalesce(module_count, 5) FROM subject WHERE id=?", subjectId));

        Map<Integer, Integer> dist = new LinkedHashMap<>();
        Object rawDist = form.values().get("moduleDistribution");
        if (rawDist instanceof Map<?, ?> m) {
            for (int mod = 1; mod <= maxModules; mod++) {
                Object v = m.get(String.valueOf(mod));
                if (v == null) v = m.get(mod);
                int req = v != null ? (int) Math.floor(Double.parseDouble(String.valueOf(v))) : 0;
                dist.put(mod, Math.max(0, req));
            }
        } else {
            String savedDistJson = one(db, "SELECT module_distribution::text FROM paper_blueprint WHERE subject_id=?", subjectId);
            if (!savedDistJson.isBlank()) {
                Object parsed = Json.parse(savedDistJson);
                if (parsed instanceof Map<?, ?> sm) {
                    for (int mod = 1; mod <= maxModules; mod++) {
                        Object v = sm.get(String.valueOf(mod));
                        if (v == null) v = sm.get(mod);
                        int req = v != null ? (int) Math.floor(Double.parseDouble(String.valueOf(v))) : 0;
                        dist.put(mod, Math.max(0, req));
                    }
                }
            }
            if (dist.isEmpty()) {
                for (int mod = 1; mod <= maxModules; mod++) dist.put(mod, 6);
            }
        }

        String genId = "GEN-" + subjectId + "-" + System.currentTimeMillis();
        Map<String, Object> summary = buildAndPersistStageASets(db, user, subjectId, bankId, dist, genId);
        audit(db, user.id(), "HOD_QUESTION_SET_GENERATED", "subject_generation:" + subjectId, Json.stringify(summary));
        return v1Success(summary, "Generated " + summary.get("generatedSetCount") + " strictly disjoint question sets");
    }

    static String getV1HodQuestionSets(Connection db, User user, long subjectId) throws SQLException {
        user.require("HOD", "COE", "PRINCIPAL", "ADMIN");
        List<Map<String, Object>> revisions = new ArrayList<>();
        try (var st = sql(db, """
                SELECT detail FROM audit
                WHERE action = 'HOD_QUESTION_SET_PUBLISHED' AND entity = ?
                ORDER BY id DESC
                """, "subject_publication:" + subjectId); var rs = st.executeQuery()) {
            while (rs.next()) {
                Object parsed = Json.parse(rs.getString(1));
                if (parsed instanceof Map<?, ?> map) {
                    Map<String, Object> rev = new LinkedHashMap<>();
                    for (Map.Entry<?, ?> e : map.entrySet()) rev.put(String.valueOf(e.getKey()), e.getValue());
                    revisions.add(rev);
                }
            }
        }
        return v1Success(revisions, "Question publication revisions loaded");
    }

    static String publishV1HodQuestionSets(Connection db, User user, long subjectId, Form form) throws SQLException {
        user.require("HOD");
        String subDeptStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!subDeptStr.isBlank(), 404, "Subject not found");
        Long deptId = user.departmentId();
        check(deptId != null && deptId.equals(Long.parseLong(subDeptStr)), 403, "Access denied: Subject does not belong to your department");

        String bankIdStr = one(db, "SELECT id FROM question_bank WHERE subject_id=? AND department_id=? ORDER BY id DESC LIMIT 1", subjectId, deptId);
        check(!bankIdStr.isEmpty(), 400, "No question bank found for this subject. Upload questions first.");
        long bankId = Long.parseLong(bankIdStr);

        int maxModules = Integer.parseInt(one(db, "SELECT coalesce(module_count, 5) FROM subject WHERE id=?", subjectId));

        // Try loading latest generated blueprint summary, else saved blueprint, else 6 Qs per module
        Map<Integer, Integer> dist = new LinkedHashMap<>();
        String latestGen = one(db, "SELECT detail FROM audit WHERE action='HOD_QUESTION_SET_GENERATED' AND entity=? ORDER BY id DESC LIMIT 1", "subject_generation:" + subjectId);
        if (!latestGen.isBlank()) {
            Object parsed = Json.parse(latestGen);
            if (parsed instanceof Map<?, ?> m && m.get("moduleDistribution") instanceof Map<?, ?> dm) {
                for (int mod = 1; mod <= maxModules; mod++) {
                    Object v = dm.get(String.valueOf(mod));
                    if (v == null) v = dm.get(mod);
                    dist.put(mod, v != null ? (int) Math.floor(Double.parseDouble(String.valueOf(v))) : 0);
                }
            }
        }
        if (dist.isEmpty()) {
            String savedDistJson = one(db, "SELECT module_distribution::text FROM paper_blueprint WHERE subject_id=?", subjectId);
            if (!savedDistJson.isBlank()) {
                Object parsed = Json.parse(savedDistJson);
                if (parsed instanceof Map<?, ?> sm) {
                    for (int mod = 1; mod <= maxModules; mod++) {
                        Object v = sm.get(String.valueOf(mod));
                        if (v == null) v = sm.get(mod);
                        dist.put(mod, v != null ? (int) Math.floor(Double.parseDouble(String.valueOf(v))) : 0);
                    }
                }
            }
        }
        if (dist.isEmpty()) {
            for (int mod = 1; mod <= maxModules; mod++) dist.put(mod, 6);
        }

        String genId = form.get("generationId").isBlank() ? ("GEN-" + subjectId + "-" + System.currentTimeMillis()) : form.get("generationId");
        String notes = form.get("notes");
        Map<String, Object> summary = buildAndPersistStageASets(db, user, subjectId, bankId, dist, genId);
        if (summary.get("setStatuses") instanceof List<?> stList) {
            for (Object item : stList) {
                if (item instanceof Map<?, ?> m) {
                    @SuppressWarnings("unchecked")
                    Map<String, Object> stMap = (Map<String, Object>) m;
                    stMap.put("publicationStatus", "Published");
                }
            }
        }

        int prevPubCount = Integer.parseInt(one(db, "SELECT count(*) FROM audit WHERE action='HOD_QUESTION_SET_PUBLISHED' AND entity=?", "subject_publication:" + subjectId));
        String revNumber = "R" + (prevPubCount + 1);

        run(db, "UPDATE question_bank SET state='FINALIZED', revision_number=?, finalized_at=clock_timestamp(), finalized_by=? WHERE id=?",
                prevPubCount + 1, user.id(), bankId);
        run(db, "UPDATE generated_paper SET status='READY' WHERE bank_id=?", bankId);

        String subCode = one(db, "SELECT coalesce(code, 'SUB') FROM subject WHERE id=?", subjectId);
        String subName = one(db, "SELECT coalesce(name, 'Subject') FROM subject WHERE id=?", subjectId);
        String semStr = one(db, "SELECT coalesce(semester, 5) FROM subject WHERE id=?", subjectId);
        int sem = semStr.isBlank() ? 5 : Integer.parseInt(semStr);

        Map<String, Object> blueprintObj = new LinkedHashMap<>();
        blueprintObj.put("totalQuestions", summary.get("questionsPerSet"));
        blueprintObj.put("totalQuestionsPerSet", summary.get("questionsPerSet"));
        blueprintObj.put("moduleDistribution", summary.get("moduleDistribution"));

        Map<String, Object> revision = new LinkedHashMap<>();
        revision.put("id", "PUB-" + subjectId + "-" + (prevPubCount + 1));
        revision.put("generationId", genId);
        revision.put("subjectId", String.valueOf(subjectId));
        revision.put("subjectCode", subCode);
        revision.put("subjectName", subName);
        revision.put("departmentId", String.valueOf(deptId));
        revision.put("semesterNumber", sem);
        revision.put("revisionNumber", revNumber);
        revision.put("questionBankRevisionId", summary.get("questionBankRevisionId"));
        revision.put("blueprintRevisionId", summary.get("blueprintRevisionId"));
        revision.put("blueprint", blueprintObj);
        revision.put("poolQuestionCount", summary.get("poolQuestionCount"));
        revision.put("setsGeneratedCount", summary.get("generatedSetCount"));
        revision.put("totalUniqueQuestionsAllocated", summary.get("totalUniqueQuestionsAllocated"));
        revision.put("setStatuses", summary.get("setStatuses"));
        revision.put("status", "Published");
        revision.put("publishedBy", user.username());
        revision.put("publishedAt", Instant.now().toString());
        revision.put("notes", notes);

        audit(db, user.id(), "HOD_QUESTION_SET_PUBLISHED", "subject_publication:" + subjectId, Json.stringify(revision));
        audit(db, user.id(), "PUBLISH_QUESTION_SETS", "question_bank:" + bankId, "Published " + summary.get("generatedSetCount") + " Disjoint Question Sets (" + revNumber + ") to COE");

        // Schedule / update examination_session for eligible students of this department & semester
        try {
            String cycleIdStr = one(db, "SELECT id FROM examination_cycle ORDER BY id DESC LIMIT 1");
            long cycleId;
            if (cycleIdStr.isEmpty()) {
                cycleId = insert(db, """
                        INSERT INTO examination_cycle(title, academic_session, cycle_type, created_by)
                        VALUES('Odd Semester Main Examination 2026-27', '2026-27', 'REGULAR', ?)
                        """, user.id());
            } else {
                cycleId = Long.parseLong(cycleIdStr);
            }

            String firstPaperStr = one(db, "SELECT id FROM generated_paper WHERE bank_id=? ORDER BY paper_number ASC LIMIT 1", bankId);
            Long firstPaperId = firstPaperStr.isEmpty() ? null : Long.parseLong(firstPaperStr);

            List<Long> groupIds = new ArrayList<>();
            try (var gst = sql(db, "SELECT id FROM academic_group WHERE department_id=? AND semester=?", deptId, sem);
                 var grs = gst.executeQuery()) {
                while (grs.next()) groupIds.add(grs.getLong(1));
            }
            if (groupIds.isEmpty()) {
                String dCode = one(db, "SELECT code FROM department WHERE id=?", deptId);
                if (dCode.isEmpty()) dCode = "CSE";
                long gid = insert(db, "INSERT INTO academic_group(department_id, department, academic_session, year, study_year, semester, section) VALUES(?,?,?,?,?,?,?)",
                        deptId, dCode, "2026-27", (sem+1)/2, (sem+1)/2, sem, "A");
                groupIds.add(gid);
            }

            long activeSessId = 0;
            for (long gid : groupIds) {
                String existingSess = one(db, "SELECT id FROM examination_session WHERE subject_id=? AND department_id=? AND group_id=? AND status NOT IN ('RETIRED','CANCELLED') ORDER BY id DESC LIMIT 1",
                        subjectId, deptId, gid);
                if (!existingSess.isEmpty()) {
                    activeSessId = Long.parseLong(existingSess);
                    run(db, "UPDATE examination_session SET status='SCHEDULED', selected_paper_id=coalesce(?, selected_paper_id), session_date=CURRENT_DATE, start_time='00:00:00', end_time='23:59:59', duration_minutes=45 WHERE id=?",
                            firstPaperId, activeSessId);
                } else {
                    activeSessId = insert(db, """
                            INSERT INTO examination_session(cycle_id, subject_id, department_id, group_id, session_date, sitting,
                                                           start_time, end_time, duration_minutes, assigned_lab, selected_paper_id,
                                                           status, created_by, total_marks, passing_marks)
                            VALUES(?,?,?,?,CURRENT_DATE,'MORNING','00:00:00','23:59:59',45,'Lab 1',?,'SCHEDULED',?,30,12.00)
                            """, cycleId, subjectId, deptId, gid, firstPaperId, user.id());
                }
            }
            if (activeSessId > 0) {
                LabRuntime.activeSessionId = activeSessId;
            }
        } catch (Exception ex) {
            System.err.println("Warning: auto-scheduling examination_session failed: " + ex.getMessage());
        }

        Map<String, Object> pubEvt = new LinkedHashMap<>();
        pubEvt.put("eventType", "QUESTION_SET_PUBLISHED");
        pubEvt.put("subjectId", subjectId);
        pubEvt.put("subjectCode", subCode);
        pubEvt.put("subjectName", subName);
        pubEvt.put("departmentId", deptId);
        pubEvt.put("revisionNumber", revNumber);
        broadcastCentralEvent("QUESTION_SET_PUBLISHED", pubEvt);

        return v1Success(revision, "Question sets (" + revNumber + ") successfully published to COE");
    }

    static String getV1HodCourseOutcomes(Connection db, User user, long subjectId) throws SQLException {
        user.require("HOD", "COE", "PRINCIPAL", "ADMIN");
        List<Map<String, Object>> revisions = new ArrayList<>();
        try (var st = sql(db, """
                SELECT cor.id, cor.revision_number, cor.file_name, cor.file_size_bytes, cor.file_hash_sha256,
                       cor.uploaded_at, cos.status, cos.academic_session, cos.semester
                FROM course_outcome_revision cor
                JOIN course_outcome_submission cos ON cos.id = cor.submission_id
                WHERE cos.subject_id = ?
                ORDER BY cor.revision_number DESC
                """, subjectId);
             var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> rev = new LinkedHashMap<>();
                rev.put("id", String.valueOf(rs.getLong(1)));
                rev.put("revisionNumber", rs.getInt(2));
                rev.put("fileName", rs.getString(3));
                rev.put("fileSizeBytes", rs.getLong(4));
                rev.put("fileHashSha256", rs.getString(5));
                rev.put("uploadedAt", rs.getTimestamp(6).toInstant().toString());
                rev.put("status", rs.getString(7));
                rev.put("academicSession", rs.getString(8));
                rev.put("semesterNumber", rs.getInt(9));
                revisions.add(rev);
            }
        }
        return v1Success(revisions, "Course outcome revisions loaded");
    }

    static String uploadV1HodCourseOutcomePdf(Connection db, User user, long subjectId, Form form) throws Exception {
        user.require("HOD");
        Long deptId = user.departmentId();
        int sem = form.get("semesterNumber").isBlank() ? 4 : form.number("semesterNumber");

        byte[] pdfBytes = (byte[]) form.values().get("__file_bytes__");
        String filename = (String) form.values().get("__file_name__");
        if (pdfBytes != null && pdfBytes.length > 50 * 1024 * 1024) {
            throw new Problem(400, "Course Outcomes PDF exceeds the 50 MB upload limit.");
        }
        if (pdfBytes != null && pdfBytes.length > 4) {
            String header = new String(Arrays.copyOfRange(pdfBytes, 0, Math.min(pdfBytes.length, 5)), StandardCharsets.ISO_8859_1);
            if (!header.startsWith("%PDF")) {
                throw new Problem(400, "Uploaded file is not a valid PDF document. Header must start with %PDF-.");
            }
        }
        if (pdfBytes == null || pdfBytes.length == 0) {
            pdfBytes = "%PDF-1.4 Default CO Document".getBytes(StandardCharsets.UTF_8);
            filename = "Course_Outcomes.pdf";
        }
        String sha256 = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(pdfBytes));

        String subIdStr = one(db, "SELECT id FROM course_outcome_submission WHERE subject_id=? AND academic_session='2026-27'", subjectId);
        long subId;
        int nextRev = 1;
        if (subIdStr.isEmpty()) {
            subId = insert(db, """
                    INSERT INTO course_outcome_submission(subject_id, department_id, academic_session, semester, current_revision, status, created_by)
                    VALUES(?,?,?,?,1,'Under Review',?)
                    """, subjectId, deptId, "2026-27", sem, user.id());
        } else {
            subId = Long.parseLong(subIdStr);
            nextRev = Integer.parseInt(one(db, "SELECT coalesce(max(revision_number),0)+1 FROM course_outcome_revision WHERE submission_id=?", subId));
            run(db, "UPDATE course_outcome_submission SET current_revision=?, status='Under Review', updated_at=clock_timestamp() WHERE id=?", nextRev, subId);
        }

        long revId = insert(db, """
                INSERT INTO course_outcome_revision(submission_id, revision_number, file_name, file_size_bytes, file_hash_sha256, pdf_blob, uploaded_by)
                VALUES(?,?,?,?,?,?,?)
                """, subId, nextRev, filename, (long) pdfBytes.length, sha256, pdfBytes, user.id());

        // Default Course Outcomes statements CO1 - CO5
        for (int i = 1; i <= 5; i++) {
            run(db, "INSERT INTO course_outcome_statement(revision_id, co_code, description, bloom_level, target_percentage) VALUES(?,?,?,?,?)",
                revId, "CO" + i, "Demonstrate comprehensive proficiency in Module " + i + " concepts", "Apply (L3)", new BigDecimal("70.00"));
        }

        audit(db, user.id(), "UPLOAD_COURSE_OUTCOMES", "course_outcome_submission:" + subId, "Uploaded revision " + nextRev + " (" + filename + ")");

        Map<String, Object> rev = new LinkedHashMap<>();
        rev.put("id", String.valueOf(revId));
        rev.put("revisionNumber", nextRev);
        rev.put("fileName", filename);
        rev.put("fileSizeBytes", pdfBytes.length);
        rev.put("fileHashSha256", sha256);
        rev.put("uploadedAt", Instant.now().toString());
        rev.put("status", "Under Review");

        return v1Success(Map.of("uploadedRevision", rev, "revisions", List.of(rev)), "Course outcomes PDF successfully uploaded");
    }

    static String getV1HodKeyCorrectionsEligible(Connection db, User user) throws SQLException {
        user.require("HOD");
        return rows(db, """
                SELECT es.id, s.code AS subject_code, s.name AS subject_name, es.session_date, es.sitting, es.status
                FROM examination_session es
                JOIN subject s ON s.id = es.subject_id
                WHERE es.department_id = ? AND es.status IN ('RESULTS_IMPORTED', 'APPROVED', 'RELEASED')
                ORDER BY es.session_date DESC
                """, user.departmentId());
    }

    static String getV1HodKeyCorrectionsQuestions(Connection db, User user, long examId) throws SQLException {
        user.require("HOD");
        List<Map<String, Object>> list = new ArrayList<>();
        try (var st = sql(db, """
                SELECT pq.question_id, pq.question_uid, pq.display_position,
                       qbi.prompt, pq.shuffled_options, pq.shuffled_correct, pq.marks
                FROM paper_version_question pq
                JOIN paper_version pv ON pv.id = pq.version_id
                JOIN question_bank_item qbi ON qbi.id = pq.question_id
                WHERE pv.session_id = ? AND pv.version_letter = 'A'
                ORDER BY pq.display_position
                """, examId); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> q = new LinkedHashMap<>();
                String uid = rs.getString(2);
                q.put("questionId", uid);
                q.put("id", String.valueOf(rs.getLong(1)));
                q.put("moduleNumber", 1);
                q.put("questionText", rs.getString(4));
                Array arr = rs.getArray(5);
                String[] opts = arr != null ? (String[]) arr.getArray() : new String[0];
                q.put("optionA", opts.length > 0 ? opts[0] : "");
                q.put("optionB", opts.length > 1 ? opts[1] : "");
                q.put("optionC", opts.length > 2 ? opts[2] : "");
                q.put("optionD", opts.length > 3 ? opts[3] : "");
                int corr = rs.getInt(6);
                String corrLetter = switch (corr) {
                    case 1 -> "A";
                    case 2 -> "B";
                    case 3 -> "C";
                    case 4 -> "D";
                    default -> "A";
                };
                q.put("correctOption", corrLetter);
                q.put("existingCorrectOption", corrLetter);
                list.add(q);
            }
        }
        return v1Success(list, "Examination questions loaded");
    }

    static String getV1HodKeyCorrectionsHistory(Connection db, User user) throws SQLException {
        user.require("HOD", "COE", "PRINCIPAL", "ADMIN");
        List<Map<String, Object>> list = new ArrayList<>();
        try (var st = sql(db, """
                SELECT akc.id, akc.session_id, akc.question_uid, akc.question_text,
                       akc.original_correct, akc.proposed_correct, akc.reason, akc.status,
                       akc.submitted_at, s.code AS subject_code, s.name AS subject_name,
                       akc.decided_at, akc.decision_reason,
                       d.id AS dept_id, d.code AS dept_code, ag.semester,
                       u.full_name AS submitted_by_name,
                       dec_u.full_name AS decided_by_name
                FROM answer_key_correction akc
                JOIN examination_session es ON es.id = akc.session_id
                JOIN subject s ON s.id = akc.subject_id
                JOIN department d ON d.id = es.department_id
                JOIN academic_group ag ON ag.id = es.group_id
                JOIN account u ON u.id = akc.submitted_by
                LEFT JOIN account dec_u ON dec_u.id = akc.decided_by
                WHERE akc.submitted_by = ? OR ? IN ('COE','PRINCIPAL','ADMIN')
                ORDER BY akc.id DESC
                """, user.id(), user.role()); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> m = new LinkedHashMap<>();
                long id = rs.getLong(1);
                long sessId = rs.getLong(2);
                String qUid = rs.getString(3);
                String qText = rs.getString(4);
                String origCorrect = rs.getString(5);
                String propCorrect = rs.getString(6);
                String reason = rs.getString(7);
                String rawStatus = rs.getString(8);
                java.sql.Timestamp submittedAt = rs.getTimestamp(9);
                String subjCode = rs.getString(10);
                String subjName = rs.getString(11);
                java.sql.Timestamp decidedAt = rs.getTimestamp(12);
                String decReason = rs.getString(13);
                long deptId = rs.getLong(14);
                String deptCode = rs.getString(15);
                int sem = rs.getInt(16);
                String subByName = rs.getString(17);
                String decByName = rs.getString(18);

                m.put("id", String.valueOf(id));
                m.put("examinationId", String.valueOf(sessId));
                m.put("departmentId", String.valueOf(deptId));
                m.put("departmentCode", deptCode);
                m.put("semesterNumber", sem);
                m.put("subjectCode", subjCode);
                m.put("subjectName", subjName);
                m.put("questionId", qUid);
                m.put("questionText", qText != null ? qText : "");
                m.put("existingCorrectOption", origCorrect != null ? origCorrect : "A");
                m.put("proposedCorrectOption", propCorrect);
                m.put("reason", reason);
                m.put("requestedBy", subByName != null ? subByName : "HOD");
                m.put("requestedAt", submittedAt != null ? submittedAt.toInstant().toString() : Instant.now().toString());

                String mappedStatus = switch (rawStatus != null ? rawStatus : "PENDING") {
                    case "APPROVED" -> "Approved & Recalculated";
                    case "REJECTED" -> "Rejected";
                    default -> "Pending COE Review";
                };
                m.put("status", mappedStatus);
                if (decByName != null) m.put("decidedBy", decByName);
                if (decidedAt != null) m.put("decidedAt", decidedAt.toInstant().toString());
                if (decReason != null) m.put("coeDecisionNote", decReason);

                list.add(m);
            }
        }
        return v1Success(list, "Key corrections history");
    }

    static String submitV1HodKeyCorrection(Connection db, User user, Form form) throws SQLException {
        user.require("HOD");
        long examId = form.id("examinationId");
        
        long examDeptId = Long.parseLong(one(db, "SELECT department_id FROM examination_session WHERE id=?", examId));
        check(user.departmentId().equals(examDeptId), 403, "Access denied: You are only authorized to dispute examinations for your department");

        String lriStatus = one(db, "SELECT status FROM lab_result_import WHERE session_id=?", examId);
        check(!"RELEASED".equalsIgnoreCase(lriStatus), 400, "Cannot submit answer-key correction for an already-released examination");

        long subjectId = Long.parseLong(one(db, "SELECT subject_id FROM examination_session WHERE id=?", examId));
        String qId = form.need("questionId");
        String proposed = form.need("proposedCorrectOption").toUpperCase(Locale.ROOT);
        String reason = form.get("reason").isBlank() ? "Disputed Option Formulation" : form.get("reason");

        String qUid = "";
        try {
            long numericId = Long.parseLong(qId);
            qUid = one(db, "SELECT question_uid FROM question_bank_item WHERE id=?", numericId);
        } catch (NumberFormatException ignored) {}
        if (qUid.isEmpty()) {
            qUid = one(db, "SELECT question_uid FROM question_bank_item WHERE question_uid=?", qId);
        }
        if (qUid.isEmpty()) qUid = "Q-" + qId;
        String prompt = one(db, "SELECT prompt FROM question_bank_item WHERE question_uid=?", qUid);
        if (prompt.isEmpty()) prompt = "Examination Question " + qId;

        // Determine original correct option accurately from question_bank_item
        String origOpt = "A";
        String correctVal = one(db, "SELECT correct FROM question_bank_item WHERE question_uid=?", qUid);
        if (!correctVal.isEmpty()) {
            try {
                int cInt = Integer.parseInt(correctVal);
                origOpt = switch (cInt) {
                    case 1 -> "A";
                    case 2 -> "B";
                    case 3 -> "C";
                    case 4 -> "D";
                    default -> "A";
                };
            } catch (Exception ignored) {}
        }

        long id = insert(db, """
                INSERT INTO answer_key_correction(session_id, subject_id, question_uid, question_text, original_correct, proposed_correct, reason, status, submitted_by)
                VALUES(?,?,?,?,?,?,?,'PENDING',?)
                """, examId, subjectId, qUid, prompt, origOpt, proposed, reason, user.id());

        audit(db, user.id(), "SUBMIT_KEY_CORRECTION", "answer_key_correction:" + id, "Submitted dispute on " + qUid + " -> " + proposed);
        Map<String, Object> retObj = new LinkedHashMap<>();
        retObj.put("id", String.valueOf(id));
        retObj.put("examinationId", String.valueOf(examId));
        retObj.put("questionId", qUid);
        retObj.put("existingCorrectOption", origOpt);
        retObj.put("proposedCorrectOption", proposed);
        retObj.put("status", "Pending COE Review");
        broadcastCentralEvent("KEY_CORRECTION_SUBMITTED", Map.of("eventType", "KEY_CORRECTION_SUBMITTED", "examinationId", examId));
        return v1Success(retObj, "Key correction request submitted to COE");
    }

    static String getV1HodExaminations(Connection db, User user) throws SQLException {
        user.require("HOD");
        Long deptId = user.departmentId();
        check(deptId != null, 403, "Department scope required");
        List<Map<String, Object>> list = new ArrayList<>();
        try (var st = sql(db, """
                SELECT es.id, s.code AS subject_code, s.name AS subject_name, es.session_date, es.sitting,
                       es.assigned_lab, es.status, es.duration_minutes,
                       d.code AS dept_code, ag.semester, ag.academic_session, ag.section,
                       es.subject_id
                FROM examination_session es
                JOIN subject s ON s.id = es.subject_id
                JOIN department d ON d.id = es.department_id
                JOIN academic_group ag ON ag.id = es.group_id
                WHERE es.department_id = ?
                ORDER BY es.session_date DESC, es.id DESC
                """, deptId); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> e = new LinkedHashMap<>();
                e.put("id", String.valueOf(rs.getLong(1)));
                e.put("departmentId", String.valueOf(deptId));
                e.put("departmentCode", rs.getString(9) != null ? rs.getString(9) : "CSE");
                e.put("academicYearId", rs.getString(11) != null ? rs.getString(11) : "2026-27");
                e.put("academicYear", rs.getString(11) != null ? rs.getString(11) : "2026-27");
                e.put("semesterNumber", rs.getInt(10));
                e.put("subjectId", String.valueOf(rs.getLong(13)));
                e.put("subjectCode", rs.getString(2));
                e.put("subjectName", rs.getString(3));
                String sec = rs.getString(12);
                List<String> sections = (sec != null && !sec.isBlank()) ? List.of(sec) : List.of("A");
                e.put("participatingSections", sections);
                e.put("applicableSections", sections);
                e.put("examDate", rs.getString(4) != null ? rs.getString(4) : "2026-11-17");
                e.put("maxMarks", 100);

                String rawStatus = rs.getString(7);
                String examStatus = switch (rawStatus != null ? rawStatus : "") {
                    case "SCHEDULED", "FROZEN" -> "Scheduled";
                    case "PACKAGE_EXPORTED" -> "In Progress";
                    case "RESULTS_IMPORTED", "APPROVED", "RELEASED" -> "Exam Completed";
                    case "CANCELLED" -> "Cancelled";
                    default -> "Scheduled";
                };
                String resultStatus = switch (rawStatus != null ? rawStatus : "") {
                    case "RELEASED" -> "Released";
                    case "APPROVED", "RESULTS_IMPORTED" -> "Awaiting COE Approval";
                    default -> "Not Imported";
                };
                e.put("examStatus", examStatus);
                e.put("resultStatus", resultStatus);
                e.put("status", examStatus);
                e.put("labReadiness", "Ready");
                e.put("sittings", List.of());
                list.add(e);
            }
        }
        return v1Success(list, "Examinations loaded");
    }

    static String getV1HodResults(Connection db, User user, Form form) throws SQLException {
        user.require("HOD");
        Long deptId = user.departmentId();
        check(deptId != null, 403, "Department scope required");
        
        // Enforce department-level authorization: prevent accessing another department
        if (form != null && form.get("departmentId") != null && !form.get("departmentId").isBlank()) {
            long requestedDeptId = Long.parseLong(form.get("departmentId"));
            check(deptId.equals(requestedDeptId), 403, "Access denied: You are only authorized to access your assigned department");
        }
        
        String deptCode = one(db, "SELECT code FROM department WHERE id = ?", deptId);

        Map<String, Object> filterOptions = new LinkedHashMap<>();
        filterOptions.put("academicYears", List.of(Map.of("id", "2026-27", "name", "2026-2027", "code", "2026-27", "status", "Active", "startDate", "2026-08-01", "endDate", "2027-06-30")));
        filterOptions.put("semesters", List.of(1, 2, 3, 4, 5, 6, 7, 8));
        
        // Distinct sections from released exams
        List<String> sections = new ArrayList<>();
        try (var st = sql(db, """
                SELECT DISTINCT coalesce(srs.original_section, ag.section, 'A') AS sec
                FROM examination_session es
                JOIN academic_group ag ON ag.id = es.group_id
                JOIN lab_result_import lri ON lri.session_id = es.id
                LEFT JOIN session_roster_snapshot srs ON srs.session_id = es.id
                WHERE es.department_id = ? AND lri.status = 'RELEASED'
                ORDER BY sec
                """, deptId); var rs = st.executeQuery()) {
            while (rs.next()) {
                String s = rs.getString(1);
                if (s != null && !s.isBlank() && !sections.contains(s)) sections.add(s);
            }
        }
        if (sections.isEmpty()) sections.addAll(List.of("A", "B", "C"));
        filterOptions.put("sections", sections);

        List<Map<String, Object>> examOptions = new ArrayList<>();
        try (var st = sql(db, """
                SELECT DISTINCT es.id, s.code, ag.semester, ag.academic_session
                FROM examination_session es
                JOIN subject s ON s.id=es.subject_id
                JOIN academic_group ag ON ag.id=es.group_id
                JOIN lab_result_import lri ON lri.session_id=es.id
                WHERE es.department_id=? AND lri.status = 'RELEASED'
                ORDER BY es.id DESC
                """, deptId);
             var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> opt = new LinkedHashMap<>();
                opt.put("id", String.valueOf(rs.getLong(1)));
                opt.put("label", rs.getString(2) + " (Sem " + rs.getInt(3) + ")");
                opt.put("semesterNumber", rs.getInt(3));
                opt.put("academicYearId", rs.getString(4) != null ? rs.getString(4) : "2026-27");
                examOptions.add(opt);
            }
        }
        filterOptions.put("examinations", examOptions);

        // Filters
        String fExamId = form != null ? (form.get("examinationId") != null ? form.get("examinationId") : form.get("sessionId")) : null;
        String fSem = form != null ? form.get("semesterNumber") : null;
        String fSec = form != null ? form.get("section") : null;
        String fSearch = form != null ? form.get("search") : null;

        StringBuilder sql = new StringBuilder("""
                SELECT ssr.usn, ssr.full_name, ssr.assigned_version, ssr.score, ssr.passed,
                       ssr.correct_count, ssr.incorrect_count, ssr.unanswered_count,
                       s.code AS subject_code, s.name AS subject_name, es.session_date,
                       coalesce(srs.original_section, ag.section, 'A') AS student_section,
                       ag.semester, ag.academic_session, es.id AS exam_id,
                       s.id AS sub_id, lri.released_at, ssr.submission_status, es.total_marks
                FROM student_session_result ssr
                JOIN examination_session es ON es.id = ssr.session_id
                JOIN subject s ON s.id = es.subject_id
                JOIN academic_group ag ON ag.id = es.group_id
                JOIN lab_result_import lri ON lri.session_id = es.id
                LEFT JOIN session_roster_snapshot srs ON srs.session_id = es.id AND srs.usn = ssr.usn
                WHERE es.department_id = ? AND lri.status = 'RELEASED'
                """);
        List<Object> args = new ArrayList<>();
        args.add(deptId);

        if (fExamId != null && !fExamId.isBlank() && !"ALL".equalsIgnoreCase(fExamId)) {
            sql.append(" AND es.id = ? ");
            args.add(Long.parseLong(fExamId));
        }
        if (fSem != null && !fSem.isBlank() && !"ALL".equalsIgnoreCase(fSem)) {
            sql.append(" AND ag.semester = ? ");
            args.add(Integer.parseInt(fSem));
        }
        if (fSec != null && !fSec.isBlank() && !"ALL".equalsIgnoreCase(fSec)) {
            sql.append(" AND coalesce(srs.original_section, ag.section, 'A') = ? ");
            args.add(fSec);
        }
        if (fSearch != null && !fSearch.isBlank()) {
            sql.append(" AND (lower(ssr.usn) LIKE ? OR lower(ssr.full_name) LIKE ?) ");
            String q = "%" + fSearch.trim().toLowerCase(Locale.ROOT) + "%";
            args.add(q);
            args.add(q);
        }
        sql.append(" ORDER BY ssr.score DESC, ssr.usn ");

        List<Map<String, Object>> results = new ArrayList<>();
        try (var st = sql(db, sql.toString(), args.toArray()); var rs = st.executeQuery()) {
            while (rs.next()) {
                String usn = rs.getString(1);
                String fullName = rs.getString(2);
                BigDecimal score = rs.getBigDecimal(4);
                boolean passed = rs.getBoolean(5);
                String subCode = rs.getString(9);
                String subName = rs.getString(10);
                String studentSection = rs.getString(12);
                int semester = rs.getInt(13);
                String academicSession = rs.getString(14);
                long examId = rs.getLong(15);
                long subId = rs.getLong(16);
                java.sql.Timestamp releasedAt = rs.getTimestamp(17);
                String subStatus = rs.getString(18);
                BigDecimal totalMarks = rs.getBigDecimal(19);

                boolean isAbsent = "ABSENT".equalsIgnoreCase(subStatus);
                String att = isAbsent ? "Absent" : "Present";
                String outcome = isAbsent ? "Absent" : (passed ? "Pass" : "Fail");
                Double maxM = totalMarks != null ? totalMarks.doubleValue() : 100.0;
                Double marksObt = isAbsent ? null : (score != null ? score.doubleValue() : 0.0);
                Double pct = isAbsent ? null : (marksObt != null ? Math.round((marksObt / maxM * 100.0) * 10.0) / 10.0 : 0.0);

                Map<String, Object> r = new LinkedHashMap<>();
                r.put("id", usn + "-" + examId);
                r.put("examinationId", String.valueOf(examId));
                r.put("academicYearId", academicSession != null ? academicSession : "2026-27");
                r.put("departmentId", String.valueOf(deptId));
                r.put("departmentCode", deptCode != null ? deptCode : "CSE");
                r.put("semesterNumber", semester);
                r.put("originalSection", studentSection != null ? studentSection : "A");
                r.put("subjectId", String.valueOf(subId));
                r.put("subjectCode", subCode);
                r.put("subjectName", subName);
                r.put("usn", usn);
                r.put("studentName", fullName);
                r.put("maxMarks", maxM);
                r.put("marksObtained", marksObt);
                r.put("percentage", pct);
                r.put("attendance", att);
                r.put("resultOutcome", outcome);
                r.put("coeReleaseStatus", "Released");
                r.put("releasedAt", releasedAt != null ? releasedAt.toInstant().toString() : Instant.now().toString());
                results.add(r);
            }
        }

        Map<String, Object> data = new LinkedHashMap<>();
        data.put("filterOptions", filterOptions);
        data.put("results", results);
        return v1Success(data, "Department results loaded");
    }

    static String getV1HodAuditLogs(Connection db, User user) throws SQLException {
        user.require("HOD");
        Long deptId = user.departmentId();
        check(deptId != null, 403, "HOD department scope required");
        List<Map<String, Object>> logs = new ArrayList<>();
        try (var st = sql(db, """
                SELECT a.id, a.happened, a.action, a.entity, a.detail,
                       coalesce(acc.full_name, acc.username, 'System') AS actor_name,
                       acc.role AS actor_role, acc.employee_id,
                       d.id AS dept_id, coalesce(d.code, 'INSTITUTION') AS dept_code
                FROM audit a
                LEFT JOIN account acc ON acc.id = a.actor
                LEFT JOIN department d ON d.id = acc.department_id
                WHERE a.actor = ? OR acc.department_id = ?
                ORDER BY a.id DESC LIMIT 100
                """, user.id(), deptId); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> log = new LinkedHashMap<>();
                log.put("id", String.valueOf(rs.getLong(1)));
                log.put("timestamp", rs.getTimestamp(2).toInstant().toString());
                log.put("actorName", rs.getString(6));
                log.put("actorEmployeeId", rs.getString(8) != null ? rs.getString(8) : "EMP-SYS");
                log.put("actorRole", rs.getString(7) != null ? rs.getString(7) : "HOD");
                log.put("actionCategory", rs.getString(3));
                log.put("activityDescription", rs.getString(5));
                log.put("departmentId", String.valueOf(deptId));
                log.put("departmentCode", rs.getString(10));
                log.put("status", "Verified");
                logs.add(log);
            }
        }
        List<Map<String, Object>> departments = new ArrayList<>();
        try (var st = sql(db, "SELECT id, code, name FROM department WHERE id=?", deptId); var rs = st.executeQuery()) {
            if (rs.next()) {
                departments.add(Map.of("id", String.valueOf(rs.getLong(1)), "code", rs.getString(2), "name", rs.getString(3), "status", "Active"));
            }
        }
        Map<String, Object> res = new LinkedHashMap<>();
        res.put("logs", logs);
        res.put("departments", departments);
        return v1Success(res, "HOD audit logs loaded");
    }

    // =========================================================================
    // STAGE 2: COE ENDPOINTS
    // =========================================================================

    static String getV1InstitutionDepartments(Connection db, User user) throws SQLException {
        user.require("COE", "PRINCIPAL", "ADMIN");
        return rows(db, """
                SELECT d.code, d.name, coalesce(a.full_name, 'HOD') AS hod_name,
                       (SELECT coalesce(json_agg(distinct ag.section), '[]') FROM academic_group ag WHERE ag.department_id=d.id) AS sections
                FROM department d
                LEFT JOIN account a ON a.department_id = d.id AND a.role = 'HOD' AND a.status = 'ACTIVE'
                WHERE d.status = 'ACTIVE'
                ORDER BY d.code
                """);
    }

    static String getV1InstitutionSemesters(Connection db, User user) throws SQLException {
        user.require("COE", "PRINCIPAL", "ADMIN");
        List<Map<String, Object>> list = new ArrayList<>();
        for (int i = 1; i <= 8; i++) {
            list.add(Map.of("semesterNumber", i, "label", "Semester " + i, "isEven", i % 2 == 0));
        }
        return v1Success(list, "Semesters loaded");
    }

    static String getV1InstitutionEligibility(Connection db, User user, Form form) throws SQLException {
        if (user != null) user.require("COE", "PRINCIPAL", "ADMIN");
        String deptParam = form.get("departmentId").isBlank() ? form.get("department") : form.get("departmentId");
        long deptId = 1L;
        String deptCode = "CSE";
        if (!deptParam.isBlank()) {
            try {
                deptId = Long.parseLong(deptParam);
                deptCode = one(db, "SELECT code FROM department WHERE id=?", deptId);
                if (deptCode.isEmpty()) deptCode = "CSE";
            } catch (NumberFormatException nfe) {
                deptCode = deptParam.toUpperCase(Locale.ROOT);
                String idStr = one(db, "SELECT id FROM department WHERE upper(code)=? OR upper(name)=? ORDER BY id ASC LIMIT 1", deptCode, deptCode);
                if (!idStr.isEmpty()) deptId = Long.parseLong(idStr);
            }
        }
        int sem = 4;
        String semParam = form.get("semesterId").isBlank() ? form.get("semester") : form.get("semesterId");
        if (!semParam.isBlank()) {
            try { sem = Integer.parseInt(semParam); } catch (Exception ignored) {}
        }

        List<String> sectionList = new ArrayList<>();
        try (var st = sql(db, "SELECT DISTINCT section FROM academic_group WHERE department_id=? AND semester=? ORDER BY section", deptId, sem);
             var rs = st.executeQuery()) {
            while (rs.next()) {
                if (rs.getString(1) != null && !rs.getString(1).isBlank()) {
                    sectionList.add(rs.getString(1).trim());
                }
            }
        } catch (Exception ignored) {}

        List<Map<String, Object>> students = new ArrayList<>();
        try (var st = sql(db, """
                SELECT sr.id, sr.usn, sr.full_name, ag.section, d.code
                FROM student_roster sr
                JOIN academic_group ag ON ag.id = sr.group_id
                JOIN department d ON d.id = ag.department_id
                WHERE ag.department_id = ? AND ag.semester = ? AND sr.status = 'ACTIVE'
                ORDER BY sr.usn
                """, deptId, sem); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> s = new LinkedHashMap<>();
                s.put("studentId", String.valueOf(rs.getLong(1)));
                s.put("usn", rs.getString(2));
                s.put("studentName", rs.getString(3));
                s.put("originalSection", rs.getString(4));
                s.put("department", rs.getString(5));
                s.put("semester", sem);
                s.put("eligibilityStatus", "Eligible");
                students.add(s);
            }
        } catch (Exception ignored) {}

        int eligible = students.size();

        Map<String, Object> data = new LinkedHashMap<>();
        data.put("department", deptCode);
        data.put("departmentId", String.valueOf(deptId));
        data.put("semester", sem);
        data.put("eligibleCount", eligible);
        data.put("eligibleCandidatesCount", eligible);
        data.put("sections", sectionList);
        data.put("students", students);
        data.put("status", eligible > 0 ? "Eligible" : "No Enrolled Students");
        return v1Success(data, "Eligibility calculated");
    }

    static List<Map<String, Object>> loadCoeQuestionSetsForSubject(
            Connection db, long subId, String subCode, String deptCode, int sem, Long selectedPaperId, Long currentExamId) throws SQLException {
        List<Map<String, Object>> sets = new ArrayList<>();
        String bankIdStr = one(db, """
                SELECT id FROM question_bank
                WHERE subject_id = ?
                ORDER BY CASE WHEN state = 'FINALIZED' THEN 0 ELSE 1 END, id DESC
                LIMIT 1
                """, subId);
        if (bankIdStr.isBlank()) return sets;
        long bankId = Long.parseLong(bankIdStr);
        String bankState = one(db, "SELECT coalesce(state, 'DRAFT') FROM question_bank WHERE id=?", bankId);
        boolean hasPublishedAudit = !one(db,
                "SELECT id FROM audit WHERE action='HOD_QUESTION_SET_PUBLISHED' AND entity=? ORDER BY id DESC LIMIT 1",
                "subject_publication:" + subId).isBlank();
        boolean isPublished = "FINALIZED".equalsIgnoreCase(bankState) || hasPublishedAudit;

        try (var st = sql(db, """
                SELECT p.id, p.paper_number, p.title, p.status,
                       (SELECT count(*) FROM generated_paper_question gpq WHERE gpq.paper_id = p.id) AS q_count
                FROM generated_paper p
                WHERE p.bank_id = ?
                ORDER BY p.paper_number ASC
                """, bankId); var rs = st.executeQuery()) {
            while (rs.next()) {
                long paperId = rs.getLong(1);
                int paperNum = rs.getInt(2);
                String pStatus = rs.getString(4);
                int qCount = rs.getInt(5);
                if (qCount <= 0) qCount = 30;

                // Check active sitting usage across all non-cancelled examinations
                Long sittingExamId = null;
                String sittingName = null;
                try (var sitSt = sql(db, """
                        SELECT esit.session_id, esit.sitting_name
                        FROM examination_sitting esit
                        JOIN examination_session es ON es.id = esit.session_id
                        WHERE esit.selected_paper_id = ?
                          AND coalesce(es.is_cancelled, false) = false
                          AND es.status != 'CANCELLED'
                          AND esit.status != 'CANCELLED'
                        LIMIT 1
                        """, paperId); var sitRs = sitSt.executeQuery()) {
                    if (sitRs.next()) {
                        sittingExamId = sitRs.getLong(1);
                        sittingName = sitRs.getString(2);
                    }
                }

                // If scheduled for ANOTHER examination, remove it completely from available sets
                if (sittingExamId != null && (currentExamId == null || !sittingExamId.equals(currentExamId))) {
                    continue;
                }
                // If not tied to an active sitting but marked SCHEDULED/CONSUMED/RETIRED, exclude unless part of currentExam
                if (sittingExamId == null && !"READY".equalsIgnoreCase(pStatus) && !"AVAILABLE".equalsIgnoreCase(pStatus)) {
                    continue;
                }

                String selStatus = "Available";
                if (sittingExamId != null && currentExamId != null && sittingExamId.equals(currentExamId)) {
                    selStatus = "Selected (" + ("AFTERNOON".equalsIgnoreCase(sittingName) ? "Afternoon Sitting" : "Morning Sitting") + ")";
                } else if (selectedPaperId != null && selectedPaperId == paperId) {
                    selStatus = "Selected (Morning Sitting)";
                }

                Map<String, Object> item = new LinkedHashMap<>();
                item.put("setId", String.valueOf(paperId));
                item.put("setNumber", "Set " + paperNum);
                item.put("subjectId", String.valueOf(subId));
                item.put("subjectCode", subCode);
                item.put("department", deptCode);
                item.put("semester", sem);
                item.put("isActive", true);
                item.put("publicationStatus", isPublished ? "Published by HOD" : "Not Published");
                item.put("numberOfQuestions", qCount);
                item.put("questionBankRevisionId", "QBR-" + bankId);
                item.put("blueprintRevisionId", "BPR-" + qCount);
                item.put("moduleDistributionVerified", true);
                item.put("generationStatus", isPublished ? "Generated by Backend" : "Awaiting HOD Publication");
                item.put("selectionStatus", selStatus);
                sets.add(item);
            }
        }
        return sets;
    }

    static List<Map<String, Object>> loadCoeQuestionSetsForSubject(
            Connection db, long subId, String subCode, String deptCode, int sem, Long selectedPaperId) throws SQLException {
        return loadCoeQuestionSetsForSubject(db, subId, subCode, deptCode, sem, selectedPaperId, null);
    }

    static String getV1InstitutionSubjects(Connection db, User user, Form form) throws SQLException {
        user.require("COE", "PRINCIPAL", "ADMIN");
        String deptFilter = form.get("departmentId").isBlank() ? form.get("department") : form.get("departmentId");
        String semFilter = form.get("semesterId").isBlank() ? form.get("semester") : form.get("semesterId");
        boolean publishedOnly = "true".equalsIgnoreCase(form.get("publishedOnly"));

        Integer semNumFilter = null;
        if (!semFilter.isBlank()) {
            try { semNumFilter = Integer.parseInt(semFilter.trim()); } catch (Exception ignored) {}
        }

        List<Map<String, Object>> result = new ArrayList<>();
        try (var st = sql(db, """
                SELECT s.id, s.code, s.name, coalesce(s.semester, 5) AS sem,
                       coalesce(d.id, 0) AS dept_id, coalesce(d.code, 'CSE') AS dept_code
                FROM subject s
                LEFT JOIN department d ON d.id = s.department_id
                ORDER BY s.semester ASC, s.code ASC
                """); var rs = st.executeQuery()) {
            while (rs.next()) {
                long subId = rs.getLong(1);
                String code = rs.getString(2);
                String name = rs.getString(3);
                int sem = rs.getInt(4);
                long deptId = rs.getLong(5);
                String deptCode = rs.getString(6);

                if (!deptFilter.isBlank()) {
                    String f = deptFilter.trim();
                    if (!deptCode.equalsIgnoreCase(f) && !String.valueOf(deptId).equals(f)) {
                        continue;
                    }
                }
                if (semNumFilter != null && sem != semNumFilter) {
                    continue;
                }

                String bankIdStr = one(db, """
                        SELECT id FROM question_bank
                        WHERE subject_id = ?
                        ORDER BY CASE WHEN state = 'FINALIZED' THEN 0 ELSE 1 END, id DESC
                        LIMIT 1
                        """, subId);
                String bankState = bankIdStr.isBlank() ? "" : one(db, "SELECT coalesce(state,'DRAFT') FROM question_bank WHERE id=?", Long.parseLong(bankIdStr));
                String finalizedAt = bankIdStr.isBlank() ? "" : one(db, "SELECT coalesce(to_char(finalized_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), '') FROM question_bank WHERE id=?", Long.parseLong(bankIdStr));

                String pubAuditDetail = one(db,
                        "SELECT detail FROM audit WHERE action='HOD_QUESTION_SET_PUBLISHED' AND entity=? ORDER BY id DESC LIMIT 1",
                        "subject_publication:" + subId);
                String pubAuditTime = one(db,
                        "SELECT coalesce(to_char(happened AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), '') FROM audit WHERE action='HOD_QUESTION_SET_PUBLISHED' AND entity=? ORDER BY id DESC LIMIT 1",
                        "subject_publication:" + subId);

                int setsCount = bankIdStr.isBlank() ? 0
                        : Integer.parseInt(one(db, "SELECT count(*) FROM generated_paper WHERE bank_id=?", Long.parseLong(bankIdStr)));

                boolean hodPublished = "FINALIZED".equalsIgnoreCase(bankState) || !pubAuditDetail.isBlank();
                if (publishedOnly && !hodPublished) {
                    continue;
                }

                int qPerSet = 30;
                String qbRevId = bankIdStr.isBlank() ? "" : ("QBR-" + bankIdStr);
                String bpRevId = "BPR-30";
                String publishedAt = !pubAuditTime.isBlank() ? pubAuditTime : finalizedAt;
                String revisionNumber = "";

                if (!pubAuditDetail.isBlank()) {
                    try {
                        Object parsed = Json.parse(pubAuditDetail);
                        if (parsed instanceof Map<?, ?> revMap) {
                            if (revMap.get("blueprint") instanceof Map<?, ?> bp && bp.get("totalQuestions") != null) {
                                int parsedQ = (int) Math.floor(Double.parseDouble(String.valueOf(bp.get("totalQuestions"))));
                                if (parsedQ > 0) qPerSet = parsedQ;
                            }
                            if (revMap.get("questionBankRevisionId") != null) {
                                qbRevId = String.valueOf(revMap.get("questionBankRevisionId"));
                            }
                            if (revMap.get("blueprintRevisionId") != null) {
                                bpRevId = String.valueOf(revMap.get("blueprintRevisionId"));
                            }
                            if (revMap.get("publishedAt") != null && !String.valueOf(revMap.get("publishedAt")).isBlank()) {
                                publishedAt = String.valueOf(revMap.get("publishedAt"));
                            }
                            if (revMap.get("revisionNumber") != null) {
                                revisionNumber = String.valueOf(revMap.get("revisionNumber"));
                            }
                            if (setsCount == 0 && revMap.get("setsGeneratedCount") != null) {
                                setsCount = (int) Math.floor(Double.parseDouble(String.valueOf(revMap.get("setsGeneratedCount"))));
                            }
                        }
                    } catch (Exception ignored) {}
                } else if (!bankIdStr.isBlank()) {
                    String qCountStr = one(db, """
                            SELECT count(*) FROM generated_paper_question gpq
                            JOIN generated_paper gp ON gp.id = gpq.paper_id
                            WHERE gp.bank_id = ?
                            GROUP BY gp.id ORDER BY gp.paper_number ASC LIMIT 1
                            """, Long.parseLong(bankIdStr));
                    if (!qCountStr.isBlank()) {
                        int c = Integer.parseInt(qCountStr);
                        if (c > 0) qPerSet = c;
                    }
                    bpRevId = "BPR-" + qPerSet;
                }

                Map<String, Object> item = new LinkedHashMap<>();
                item.put("id", String.valueOf(subId));
                item.put("code", code);
                item.put("name", name);
                item.put("department", deptCode);
                item.put("departmentId", deptCode);
                item.put("semester", sem);
                item.put("semesterId", sem);
                item.put("hodPublished", hodPublished);
                if (!publishedAt.isBlank()) item.put("publishedAt", publishedAt);
                item.put("questionCountPerSet", qPerSet);
                item.put("marksPerQuestion", 1);
                item.put("maximumMarks", qPerSet);
                if (!qbRevId.isBlank()) item.put("questionBankRevisionId", qbRevId);
                item.put("blueprintRevisionId", bpRevId);
                item.put("publishedSetsCount", setsCount);
                if (!revisionNumber.isBlank()) item.put("revisionNumber", revisionNumber);
                result.add(item);
            }
        }
        return v1Success(result, "Subjects loaded");
    }

    static Map<String, Object> buildCoeExaminationRow(
            Connection db, long eid, long subId, String subCode, String subName,
            String deptCode, String deptName, int sem, String examDate, String startTime,
            int duration, double maxMarks, double passMarks, String lab, String status,
            String sittingCode, Long selectedPaperId) throws SQLException {

        // Participating sections
        List<String> partSections = new ArrayList<>();
        try (var st = sql(db, "SELECT participating_sections FROM examination_session WHERE id=?", eid);
             var rs = st.executeQuery()) {
            if (rs.next() && rs.getArray(1) != null) {
                String[] arr = (String[]) rs.getArray(1).getArray();
                partSections.addAll(Arrays.asList(arr));
            }
        } catch (Exception ignored) {}
        if (partSections.isEmpty()) partSections.add("A");

        List<Map<String, Object>> qSets = subId > 0
                ? loadCoeQuestionSetsForSubject(db, subId, subCode, deptCode, sem, selectedPaperId, eid)
                : List.of();
        boolean hodPublished = qSets.stream().anyMatch(s -> "Published by HOD".equals(s.get("publicationStatus")));

        // Load all students for the examination session from session_roster_snapshot
        List<Map<String, Object>> examStudents = new ArrayList<>();
        try (var st = sql(db, """
                SELECT srs.student_id, srs.usn, srs.full_name, coalesce(srs.original_section, 'A'),
                       srs.sitting_name, srs.assigned_version, coalesce(srs.assigned_lab, '')
                FROM session_roster_snapshot srs
                WHERE srs.session_id = ?
                ORDER BY srs.usn
                """, eid); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> s = new LinkedHashMap<>();
                s.put("studentId", String.valueOf(rs.getLong(1)));
                s.put("usn", rs.getString(2));
                s.put("studentName", rs.getString(3));
                s.put("originalSection", rs.getString(4));
                s.put("department", deptCode);
                s.put("semester", sem);
                s.put("eligibilityStatus", "Eligible");
                String sitName = rs.getString(5);
                s.put("assignedSitting", "AFTERNOON".equalsIgnoreCase(sitName) ? "Afternoon Sitting" : "Morning Sitting");
                s.put("assignedVersion", rs.getString(6));
                s.put("assignedLab", rs.getString(7));
                examStudents.add(s);
            }
        }

        // Load all configured sittings from examination_sitting
        List<Map<String, Object>> sittingsList = new ArrayList<>();
        try (var st = sql(db, """
                SELECT id, sitting_name, to_char(exam_date, 'YYYY-MM-DD') AS exam_date_str,
                       to_char(start_time, 'HH24:MI') AS start_time_str, duration_minutes,
                       assigned_lab, lab_capacity, student_count, selected_paper_id,
                       status, package_revision, package_id, package_status,
                       transfer_status, verification_status, lab_receipt_confirmed, signature_verified
                FROM examination_sitting
                WHERE session_id = ?
                ORDER BY CASE WHEN sitting_name = 'MORNING' THEN 0 ELSE 1 END
                """, eid); var rs = st.executeQuery()) {
            while (rs.next()) {
                String sitNameDb = rs.getString("sitting_name");
                String sitDisplayName = "AFTERNOON".equalsIgnoreCase(sitNameDb) ? "Afternoon Sitting" : "Morning Sitting";
                String sitId = "SIT-" + eid + "-" + ("AFTERNOON".equalsIgnoreCase(sitNameDb) ? "A" : "M");
                String sitDate = rs.getString("exam_date_str");
                String sitStartTime = rs.getString("start_time_str");
                int sitDur = rs.getInt("duration_minutes");
                String sitLabId = rs.getString("assigned_lab");
                int sitLabCap = rs.getInt("lab_capacity");
                Object sitPaperObj = rs.getObject("selected_paper_id");
                Long sitPaperId = sitPaperObj != null ? ((Number) sitPaperObj).longValue() : null;
                String sitStatus = rs.getString("status");
                int pkgRev = rs.getInt("package_revision");
                String pkgId = rs.getString("package_id");
                String pkgPrep = rs.getString("package_status");
                String pkgTransfer = rs.getString("transfer_status");
                String pkgVerif = rs.getString("verification_status");
                boolean labAcked = rs.getBoolean("lab_receipt_confirmed");
                boolean sigVerif = rs.getBoolean("signature_verified");

                String sitLabName = "LAB-CSE-01".equals(sitLabId) ? "Computer Science Lab 301" :
                                    "LAB-AI-01".equals(sitLabId) ? "AI & Machine Learning Lab 402" :
                                    "LAB-ISE-01".equals(sitLabId) ? "Information Science Lab 201" : sitLabId;

                // Assigned student USNs for this sitting
                List<String> assignedUsns = new ArrayList<>();
                for (Map<String, Object> stMap : examStudents) {
                    if (sitDisplayName.equals(stMap.get("assignedSitting"))) {
                        assignedUsns.add((String) stMap.get("usn"));
                    }
                }

                // Selected set label
                String sitSetNumber = null;
                if (sitPaperId != null && sitPaperId > 0) {
                    String pNum = one(db, "SELECT paper_number FROM generated_paper WHERE id=?", sitPaperId);
                    if (!pNum.isBlank()) sitSetNumber = "Set " + pNum;
                }

                // Versions generated for this sitting
                List<Map<String, Object>> versions = new ArrayList<>();
                try (var vst = sql(db, """
                        SELECT version_letter, to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"')
                        FROM paper_version
                        WHERE session_id = ? AND sitting_name = ?
                        ORDER BY version_letter
                        """, eid, sitNameDb); var vrs = vst.executeQuery()) {
                    while (vrs.next()) {
                        Map<String, Object> v = new LinkedHashMap<>();
                        v.put("version", vrs.getString(1));
                        v.put("status", "Generated (Shuffled Order, Stable Question IDs)");
                        v.put("generatedAt", vrs.getString(2));
                        versions.add(v);
                    }
                }
                boolean versionsGenerated = !versions.isEmpty();
                if (!versionsGenerated) {
                    for (String letter : List.of("A", "B", "C", "D")) {
                        Map<String, Object> v = new LinkedHashMap<>();
                        v.put("version", letter);
                        v.put("status", "Pending Set Selection");
                        versions.add(v);
                    }
                }

                if (pkgId == null || pkgId.isBlank()) {
                    pkgId = "PKG-2026-" + eid + "-" + ("AFTERNOON".equalsIgnoreCase(sitNameDb) ? "A" : "M") + "-R" + pkgRev;
                }

                boolean isPkgReady = !"CANCELLED".equals(sitStatus) && ("READY".equals(sitStatus) || labAcked);
                boolean isPkgExported = "PACKAGE_EXPORTED".equals(sitStatus) || isPkgReady;

                Map<String, Object> pkgInfo = new LinkedHashMap<>();
                pkgInfo.put("packageId", pkgId);
                pkgInfo.put("packageRevision", pkgRev);
                pkgInfo.put("preparationStatus", isPkgExported ? "Completed" : pkgPrep);
                pkgInfo.put("securityStatus", isPkgExported ? "Package Secured" : "Pending");
                pkgInfo.put("transferStatus", isPkgReady ? "Received" : pkgTransfer);
                pkgInfo.put("verificationReadinessStatus", isPkgReady ? "Ready for Examination" : pkgVerif);
                pkgInfo.put("labReceiptConfirmed", labAcked);
                pkgInfo.put("signatureVerified", sigVerif);
                pkgInfo.put("integrityValidated", sigVerif);
                pkgInfo.put("statusMessage", isPkgReady ? "Package verified and ready on Lab Server" :
                                            isPkgExported ? "Package signed and sent, awaiting Lab Server acknowledgement" :
                                            sitPaperId != null ? "Ready for package preparation" : "Awaiting set selection and package preparation");

                Map<String, Object> sitMap = new LinkedHashMap<>();
                sitMap.put("sittingId", sitId);
                sitMap.put("sittingName", sitDisplayName);
                sitMap.put("examDate", sitDate != null ? sitDate : examDate);
                sitMap.put("labId", sitLabId != null ? sitLabId : lab);
                sitMap.put("labName", sitLabName);
                sitMap.put("labCapacity", sitLabCap > 0 ? sitLabCap : 60);
                sitMap.put("studentCount", assignedUsns.size());
                sitMap.put("startTime", sitStartTime != null ? sitStartTime : startTime);
                sitMap.put("durationMinutes", sitDur > 0 ? sitDur : duration);
                sitMap.put("assignedStudentUsns", assignedUsns);
                if (sitPaperId != null && sitPaperId > 0) {
                    sitMap.put("selectedSetId", String.valueOf(sitPaperId));
                }
                if (sitSetNumber != null) {
                    sitMap.put("selectedSetNumber", sitSetNumber);
                }
                sitMap.put("versionsGenerated", versionsGenerated);
                sitMap.put("versions", versions);

                List<Map<String, Object>> versionAllocations = new ArrayList<>();
                try (var vast = sql(db, """
                        SELECT student_id, usn, assigned_version
                        FROM session_roster_snapshot
                        WHERE session_id = ? AND sitting_name = ?
                        ORDER BY usn
                        """, eid, sitNameDb); var vars = vast.executeQuery()) {
                    while (vars.next()) {
                        String vLet = vars.getString(3);
                        if (vLet != null && !vLet.isBlank()) {
                            Map<String, Object> va = new LinkedHashMap<>();
                            va.put("examinationId", String.valueOf(eid));
                            va.put("sittingId", sitId);
                            va.put("studentId", String.valueOf(vars.getLong(1)));
                            va.put("usn", vars.getString(2));
                            va.put("numberedSetId", sitPaperId != null ? String.valueOf(sitPaperId) : "1");
                            va.put("versionId", vLet);
                            va.put("allocationRevision", pkgRev);
                            va.put("assignedAt", Instant.now().toString());
                            va.put("status", "Assigned");
                            versionAllocations.add(va);
                        }
                    }
                }
                sitMap.put("versionAllocations", versionAllocations);
                sitMap.put("packageInfo", pkgInfo);
                sitMap.put("status", isPkgReady ? "READY" : sitStatus);

                List<Map<String, Object>> sitExaminers = new ArrayList<>();
                try (var exSt = sql(db, "SELECT examiner_name, employee_id, designation, assigned_lab, contact_number, is_frozen FROM sitting_examiner WHERE session_id=? AND sitting_name=? ORDER BY id ASC", eid, sitNameDb);
                     var exRs = exSt.executeQuery()) {
                    while (exRs.next()) {
                        Map<String, Object> ex = new LinkedHashMap<>();
                        ex.put("examinerName", exRs.getString(1));
                        ex.put("employeeId", exRs.getString(2));
                        ex.put("designation", exRs.getString(3));
                        ex.put("assignedLab", exRs.getString(4));
                        ex.put("contactNumber", exRs.getString(5));
                        ex.put("isFrozen", exRs.getBoolean(6));
                        sitExaminers.add(ex);
                    }
                }
                sitMap.put("examiners", sitExaminers);

                sittingsList.add(sitMap);
            }
        }

        // If no sitting rows were in examination_sitting, construct default Morning sitting
        if (sittingsList.isEmpty()) {
            Map<String, Object> defaultSit = new LinkedHashMap<>();
            defaultSit.put("sittingId", "SIT-" + eid + "-M");
            defaultSit.put("sittingName", "Morning Sitting");
            defaultSit.put("examDate", examDate);
            defaultSit.put("labId", lab);
            defaultSit.put("labName", lab);
            defaultSit.put("labCapacity", 60);
            defaultSit.put("studentCount", examStudents.size());
            defaultSit.put("startTime", startTime);
            defaultSit.put("durationMinutes", duration);
            defaultSit.put("assignedStudentUsns", examStudents.stream().map(s -> (String) s.get("usn")).toList());
            if (selectedPaperId != null && selectedPaperId > 0) {
                defaultSit.put("selectedSetId", String.valueOf(selectedPaperId));
                String pNum = one(db, "SELECT paper_number FROM generated_paper WHERE id=?", selectedPaperId);
                if (!pNum.isBlank()) defaultSit.put("selectedSetNumber", "Set " + pNum);
            }
            defaultSit.put("versionsGenerated", false);
            defaultSit.put("versions", List.of());
            defaultSit.put("packageInfo", Map.of(
                    "packageId", "PKG-2026-" + eid + "-M-R1",
                    "packageRevision", 1,
                    "preparationStatus", "Not Prepared",
                    "securityStatus", "Pending",
                    "transferStatus", "Not Sent",
                    "verificationReadinessStatus", "Verification Pending",
                    "statusMessage", "Awaiting set selection and package preparation"
            ));
            sittingsList.add(defaultSit);
        }

        int totalQ = !qSets.isEmpty() && qSets.get(0).get("numberOfQuestions") instanceof Number n
                ? n.intValue()
                : (int) Math.max(1, Math.round(maxMarks));

        boolean isFrozen = "FROZEN".equals(status) || "SCHEDULED".equals(status) || "PACKAGE_EXPORTED".equals(status) || "APPROVED".equals(status) || "RELEASED".equals(status) || "COMPLETED".equals(status)
                || sittingsList.stream().anyMatch(s -> {
                    String sitStatus = (String) ((Map<String, Object>) s).getOrDefault("status", "");
                    return "FROZEN".equals(sitStatus) || "SCHEDULED".equals(sitStatus) || "READY".equals(sitStatus);
                });

        Map<String, Object> exam = new LinkedHashMap<>();
        exam.put("id", String.valueOf(eid));
        exam.put("examCode", "EXAM-" + subCode + "-" + eid);
        exam.put("subjectId", String.valueOf(subId));
        exam.put("subjectCode", subCode);
        exam.put("subjectName", subName);
        exam.put("department", deptCode);
        exam.put("departmentName", deptName);
        exam.put("semester", sem);
        exam.put("combinedSections", partSections);
        exam.put("examDate", examDate);
        exam.put("startTime", startTime);
        exam.put("durationMinutes", duration);
        exam.put("totalQuestions", totalQ);
        exam.put("marksPerQuestion", 1);
        exam.put("maximumMarks", maxMarks);
        exam.put("passingMarks", passMarks);
        exam.put("selectedLabIds", List.of(lab));
        exam.put("hodQuestionSetsPublished", hodPublished);
        exam.put("questionSets", qSets);
        boolean allReady = !"CANCELLED".equals(status) && !sittingsList.isEmpty() && sittingsList.stream().allMatch(s -> "READY".equals(((Map<String, Object>) s).get("status")));
        exam.put("status", allReady ? "READY" : status);
        exam.put("snapshotId", "SNAP-" + eid);
        exam.put("isFinalizedAndFrozen", isFrozen);
        List<Map<String, Object>> allExaminers = new ArrayList<>();
        try (var exSt = sql(db, "SELECT sitting_name, examiner_name, employee_id, designation, assigned_lab, contact_number, is_frozen FROM sitting_examiner WHERE session_id=? ORDER BY id ASC", eid);
             var exRs = exSt.executeQuery()) {
            while (exRs.next()) {
                Map<String, Object> ex = new LinkedHashMap<>();
                ex.put("sittingName", exRs.getString(1));
                ex.put("examinerName", exRs.getString(2));
                ex.put("employeeId", exRs.getString(3));
                ex.put("designation", exRs.getString(4));
                ex.put("assignedLab", exRs.getString(5));
                ex.put("contactNumber", exRs.getString(6));
                ex.put("isFrozen", exRs.getBoolean(7));
                allExaminers.add(ex);
            }
        }
        exam.put("examiners", allExaminers);
        exam.put("sittings", sittingsList);
        exam.put("students", examStudents);
        return exam;
    }

    static String getV1CoeScheduledExaminations(Connection db, User user) throws SQLException {
        if (user != null) user.require("COE", "PRINCIPAL", "ADMIN");
        List<Map<String, Object>> list = new ArrayList<>();
        try (var st = sql(db, """
                SELECT es.id, coalesce(es.subject_id, 0), coalesce(s.code, 'CS401'), coalesce(s.name, 'Examination Subject'),
                       coalesce(d.code, 'CSE'), coalesce(d.name, 'Computer Science and Engineering'),
                       coalesce(ag.semester, s.semester, 5),
                       es.session_date, es.start_time, es.duration_minutes,
                       coalesce(es.total_marks, 30.00), coalesce(es.passing_marks, 12.00),
                       coalesce(es.assigned_lab, 'LAB-CSE-01'), es.status, es.sitting, es.selected_paper_id
                FROM examination_session es
                LEFT JOIN subject s ON s.id = es.subject_id
                LEFT JOIN department d ON d.id = es.department_id
                LEFT JOIN academic_group ag ON ag.id = es.group_id
                ORDER BY es.session_date DESC, es.id DESC
                """); var rs = st.executeQuery()) {
            while (rs.next()) {
                long eid = rs.getLong(1);
                long subId = rs.getLong(2);
                String lab = rs.getString(13) != null ? rs.getString(13) : "LAB-CSE-01";
                Object selPaperObj = rs.getObject(16);
                Long selPaperId = selPaperObj != null ? ((Number) selPaperObj).longValue() : null;
                list.add(buildCoeExaminationRow(
                        db, eid, subId, rs.getString(3), rs.getString(4),
                        rs.getString(5), rs.getString(6), rs.getInt(7),
                        rs.getString(8), rs.getString(9), rs.getInt(10),
                        rs.getBigDecimal(11).doubleValue(), rs.getBigDecimal(12).doubleValue(),
                        lab, rs.getString(14), rs.getString(15), selPaperId));
            }
        }
        return v1Success(list, "Scheduled examinations loaded");
    }

    static String getV1LabServers(Connection db, User user) throws SQLException {
        List<Map<String, Object>> list = new ArrayList<>();
        try (var st = sql(db, "SELECT id, code, name, building_location, capacity, status FROM laboratory WHERE status != 'ARCHIVED' ORDER BY id ASC");
             var rs = st.executeQuery()) {
            while (rs.next()) {
                long labId = rs.getLong(1);
                String code = rs.getString(2);
                String name = rs.getString(3);
                String loc = rs.getString(4);
                int cap = rs.getInt(5);
                String status = rs.getString(6);

                Map<String, Object> lab = new LinkedHashMap<>();
                lab.put("id", code);
                lab.put("numericId", labId);
                lab.put("labCode", code);
                lab.put("labName", name);
                lab.put("name", name);
                lab.put("serverIdentifier", "SRV-" + code);
                lab.put("department", code.contains("-") ? code.split("-")[1] : "INSTITUTION");
                lab.put("capacity", cap);
                lab.put("buildingLocation", loc);
                lab.put("status", status);
                lab.put("connectionStatus", "Connected");

                List<String> pcs = new ArrayList<>();
                for (int i = 1; i <= Math.min(cap, 20); i++) {
                    pcs.add(String.format("PC-%02d", i));
                }
                lab.put("registeredWorkstationIds", pcs);
                list.add(lab);
            }
        }
        if (list.isEmpty()) {
            list.add(Map.of("id", "LAB-CSE-01", "labName", "Computer Science Lab 301", "capacity", 60, "buildingLocation", "CS Block", "status", "ACTIVE", "registeredWorkstationIds", List.of("PC-01")));
        }
        return v1Success(list, "Active laboratory server nodes");
    }

    static String createV1Laboratory(Connection db, User user, Form form) throws Exception {
        user.require("COE", "ADMIN", "PRINCIPAL");
        String name = form.need("name").trim();
        int capacity = form.number("capacity");
        check(capacity > 0, 400, "Laboratory capacity must be greater than zero");

        String code = form.get("code").trim().toUpperCase(Locale.ROOT);
        if (code.isBlank()) {
            String slug = name.replaceAll("[^A-Za-z0-9]", "").toUpperCase(Locale.ROOT);
            if (slug.length() > 8) slug = slug.substring(0, 8);
            if (slug.isBlank()) slug = "LAB";
            long count = Long.parseLong(one(db, "SELECT count(*) FROM laboratory")) + 1;
            code = slug + "-" + String.format("%02d", count);
            while (!one(db, "SELECT id FROM laboratory WHERE upper(code)=?", code).isEmpty()) {
                count++;
                code = slug + "-" + String.format("%02d", count);
            }
        } else {
            String exists = one(db, "SELECT id FROM laboratory WHERE upper(code)=?", code);
            check(exists.isEmpty(), 409, "Laboratory with code " + code + " already exists");
        }

        String location = form.get("buildingLocation").isBlank() ? form.get("location").trim() : form.get("buildingLocation").trim();
        if (location.isBlank()) location = "Campus Examination Wing";

        long labId = insert(db, "INSERT INTO laboratory(code, name, building_location, capacity, status) VALUES(?,?,?,?,'ACTIVE')",
                code, name, location, capacity);

        audit(db, user.id(), "CREATE_LABORATORY", "laboratory:" + labId, "Created laboratory " + code + " (" + name + ") with capacity " + capacity);
        run(db, "INSERT INTO laboratory_history(laboratory_id, action, new_state, performed_by) VALUES(?, 'CREATED', ?::jsonb, ?)",
                labId, Json.stringify(Map.of("code", code, "name", name, "capacity", capacity, "location", location)), user.id());

        Map<String, Object> res = new LinkedHashMap<>();
        res.put("id", code);
        res.put("numericId", labId);
        res.put("labCode", code);
        res.put("labName", name);
        res.put("capacity", capacity);
        res.put("buildingLocation", location);
        res.put("status", "ACTIVE");
        return v1Success(res, "Laboratory created successfully");
    }

    static String updateV1Laboratory(Connection db, User user, long labId, Form form) throws Exception {
        user.require("COE", "ADMIN", "PRINCIPAL");
        String code = form.get("code").trim().toUpperCase(Locale.ROOT);
        String name = form.get("name").trim();
        String location = form.get("buildingLocation").isBlank() ? form.get("location").trim() : form.get("buildingLocation").trim();
        int capacity = form.get("capacity").isBlank() ? 0 : form.number("capacity");
        String status = form.get("status").trim().toUpperCase(Locale.ROOT);

        String oldRow = one(db, "SELECT row_to_json(l)::text FROM laboratory l WHERE id=?", labId);
        check(!oldRow.isEmpty(), 404, "Laboratory not found");

        if (!code.isBlank()) {
            String dup = one(db, "SELECT id FROM laboratory WHERE upper(code)=? AND id != ?", code, labId);
            check(dup.isEmpty(), 409, "Laboratory code already in use");
            run(db, "UPDATE laboratory SET code=?, updated_at=clock_timestamp() WHERE id=?", code, labId);
        }
        if (!name.isBlank()) run(db, "UPDATE laboratory SET name=?, updated_at=clock_timestamp() WHERE id=?", name, labId);
        if (!location.isBlank()) run(db, "UPDATE laboratory SET building_location=?, updated_at=clock_timestamp() WHERE id=?", location, labId);
        if (capacity > 0) run(db, "UPDATE laboratory SET capacity=?, updated_at=clock_timestamp() WHERE id=?", capacity, labId);
        if (!status.isBlank() && List.of("ACTIVE", "INACTIVE", "ARCHIVED").contains(status)) {
            run(db, "UPDATE laboratory SET status=?, updated_at=clock_timestamp() WHERE id=?", status, labId);
        }

        String newRow = one(db, "SELECT row_to_json(l)::text FROM laboratory l WHERE id=?", labId);
        run(db, "INSERT INTO laboratory_history(laboratory_id, action, previous_state, new_state, performed_by) VALUES(?, 'UPDATED', ?::jsonb, ?::jsonb, ?)",
                labId, oldRow, newRow, user.id());
        audit(db, user.id(), "UPDATE_LABORATORY", "laboratory:" + labId, "Updated laboratory details");

        return v1Success(Json.parse(newRow), "Laboratory updated successfully");
    }

    static String getV1LaboratoryHistory(Connection db, User user, long labId) throws SQLException {
        user.require("COE", "ADMIN", "PRINCIPAL");
        List<Map<String, Object>> hist = new ArrayList<>();
        try (var st = sql(db, """
                SELECT lh.id, lh.action, lh.previous_state, lh.new_state, lh.recorded_at,
                       coalesce(a.full_name, a.username, 'System') AS actor_name
                FROM laboratory_history lh
                LEFT JOIN account a ON a.id = lh.performed_by
                WHERE lh.laboratory_id = ?
                ORDER BY lh.id DESC
                """, labId); var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> h = new LinkedHashMap<>();
                h.put("id", rs.getLong(1));
                h.put("action", rs.getString(2));
                h.put("previousState", rs.getString(3));
                h.put("newState", rs.getString(4));
                h.put("recordedAt", rs.getTimestamp(5).toInstant().toString());
                h.put("actorName", rs.getString(6));
                hist.add(h);
            }
        }
        return v1Success(hist, "Laboratory history retrieved");
    }

    static String mapStr(Map<?, ?> m, String key, String def) {
        if (m == null) return def;
        Object v = m.get(key);
        return (v != null && !String.valueOf(v).isBlank()) ? String.valueOf(v).trim() : def;
    }

    static String saveV1CoeExaminers(Connection db, User user, long examId, Form form) throws Exception {
        user.require("COE", "ADMIN");
        String status = one(db, "SELECT status FROM examination_session WHERE id=?", examId);
        check(!status.equals("FROZEN") && !status.equals("PACKAGE_EXPORTED") && !status.equals("RELEASED"),
                400, "Cannot modify examiners after examination schedule is frozen");

        List<?> list = form.list("examiners");
        for (Object item : list) {
            if (item instanceof Map<?, ?> m) {
                String sitName = mapStr(m, "sittingName", "MORNING").toUpperCase(Locale.ROOT);
                String eName = mapStr(m, "examinerName", mapStr(m, "name", ""));
                String eId = mapStr(m, "employeeId", mapStr(m, "id", "EMP-" + System.currentTimeMillis()));
                String eDesig = mapStr(m, "designation", "Examiner");
                String eLab = mapStr(m, "assignedLab", "LAB-CSE-01");
                String eContact = mapStr(m, "contactNumber", "");
                if (!eName.isBlank()) {
                    run(db, """
                            INSERT INTO sitting_examiner(session_id, sitting_name, examiner_name, employee_id, designation, assigned_lab, contact_number)
                            VALUES(?,?,?,?,?,?,?)
                            ON CONFLICT(session_id, sitting_name, employee_id) DO UPDATE SET
                                examiner_name=excluded.examiner_name,
                                designation=excluded.designation,
                                assigned_lab=excluded.assigned_lab,
                                contact_number=excluded.contact_number,
                                updated_at=clock_timestamp()
                            """, examId, sitName, eName, eId, eDesig, eLab, eContact);
                }
            }
        }
        audit(db, user.id(), "COE_EXAMINERS_ASSIGNED", "examination_session:" + examId, "Assigned " + list.size() + " examiners to examination.");
        return v1Success(fetchCoeExaminationDto(db, examId), "Examiners saved successfully");
    }

    static Map<String, Object> fetchArchiveData(Connection db, long eid, String sitName) throws SQLException {
        if (sitName.endsWith("-M") || sitName.contains("MORN")) sitName = "MORNING";
        else if (sitName.endsWith("-A") || sitName.contains("AFT")) sitName = "AFTERNOON";

        String subCode = "CS301";
        String subName = "Examination Paper";
        String deptCode = "CSE";
        String deptName = "Computer Science and Engineering";
        int sem = 5;
        String acadSession = "2025-2026";
        String examDate = "";
        String dur = "60";
        String marks = "30";
        String passingMarks = "12";
        String assignedLab = "LAB-CSE-01";
        String sessStatus = "COMPLETED";
        int setNum = 1;
        String paperTitle = "Paper Set 1";
        int revNum = 1;
        long selPaperId = 0L;

        try (var st = sql(db, """
                SELECT esit.selected_paper_id, coalesce(gp.paper_number, 1), coalesce(gp.title, 'Paper Set ' || coalesce(gp.paper_number, 1)),
                       s.code, s.name, coalesce(d.code, 'CSE'), coalesce(d.name, 'Computer Science and Engineering'),
                       coalesce(s.semester, 5), '2025-2026',
                       coalesce(es.session_date::text, ''), coalesce(es.duration_minutes::text, '60'),
                       coalesce(es.total_marks::text, '30'), coalesce(es.passing_marks::text, '12'),
                       coalesce(es.assigned_lab, 'LAB-CSE-01'), es.status, coalesce(qb.revision_number, 1),
                       es.selected_paper_id
                FROM examination_sitting esit
                JOIN examination_session es ON es.id = esit.session_id
                JOIN subject s ON s.id = es.subject_id
                LEFT JOIN department d ON d.id = coalesce(es.department_id, s.department_id)
                LEFT JOIN generated_paper gp ON gp.id = coalesce(esit.selected_paper_id, es.selected_paper_id)
                LEFT JOIN question_bank qb ON qb.id = gp.bank_id
                WHERE esit.session_id = ? AND esit.sitting_name = ?
                """, eid, sitName); var rs = st.executeQuery()) {
            if (rs.next()) {
                selPaperId = rs.getObject(1) == null ? (rs.getObject(17) == null ? 0L : rs.getLong(17)) : rs.getLong(1);
                setNum = rs.getInt(2);
                paperTitle = rs.getString(3);
                subCode = rs.getString(4);
                subName = rs.getString(5);
                deptCode = rs.getString(6);
                deptName = rs.getString(7);
                sem = rs.getInt(8);
                acadSession = rs.getString(9);
                examDate = rs.getString(10);
                dur = rs.getString(11);
                marks = rs.getString(12);
                passingMarks = rs.getString(13);
                assignedLab = rs.getString(14);
                sessStatus = rs.getString(15);
                revNum = rs.getInt(16);
            }
        }
        if (selPaperId == 0L) {
            try {
                String sStr = one(db, "SELECT coalesce(selected_paper_id, 0) FROM examination_session WHERE id=?", eid);
                if (!sStr.isBlank()) selPaperId = Long.parseLong(sStr);
            } catch (Exception ignored) {}
        }

        List<Map<String, Object>> questions = new ArrayList<>();
        List<Map<String, Object>> answerKey = new ArrayList<>();
        if (selPaperId > 0) {
            try (var st = sql(db, """
                    SELECT gpq.paper_position, coalesce(qbi.question_uid, 'Q' || gpq.paper_position),
                           qbi.module_number, qbi.prompt, qbi.options, qbi.correct, coalesce(qbi.marks, 1.0),
                           coalesce(qbi.explanation, '')
                    FROM generated_paper_question gpq
                    JOIN question_bank_item qbi ON qbi.id = gpq.question_id
                    WHERE gpq.paper_id = ?
                    ORDER BY gpq.paper_position ASC
                    """, selPaperId); var rs = st.executeQuery()) {
                int seq = 1;
                while (rs.next()) {
                    int pos = rs.getInt(1);
                    String qUid = rs.getString(2);
                    int mod = rs.getInt(3);
                    String prompt = rs.getString(4);
                    java.sql.Array arr = rs.getArray(5);
                    String[] opts = arr != null ? (String[]) arr.getArray() : new String[0];
                    int correctInt = rs.getInt(6);
                    double qMarks = rs.getDouble(7);
                    String explanation = rs.getString(8);

                    String optA = opts.length > 0 ? opts[0] : "";
                    String optB = opts.length > 1 ? opts[1] : "";
                    String optC = opts.length > 2 ? opts[2] : "";
                    String optD = opts.length > 3 ? opts[3] : "";

                    String correctLetter = switch (correctInt) {
                        case 1 -> "A";
                        case 2 -> "B";
                        case 3 -> "C";
                        case 4 -> "D";
                        default -> "A";
                    };
                    String correctText = (correctInt >= 1 && correctInt <= opts.length) ? opts[correctInt - 1] : optA;

                    Map<String, Object> q = new LinkedHashMap<>();
                    q.put("serialNumber", seq);
                    q.put("moduleNumber", mod);
                    q.put("originalQuestionNumber", qUid);
                    q.put("prompt", prompt);
                    q.put("optionA", optA);
                    q.put("optionB", optB);
                    q.put("optionC", optC);
                    q.put("optionD", optD);
                    q.put("correctAnswer", correctLetter);
                    q.put("correctAnswerText", correctText);
                    q.put("marks", qMarks > 0 ? qMarks : 1.0);
                    q.put("questionType", "Multiple Choice (MCQ)");
                    q.put("explanation", explanation);
                    questions.add(q);

                    Map<String, Object> ak = new LinkedHashMap<>();
                    ak.put("questionNumber", seq);
                    ak.put("moduleNumber", mod);
                    ak.put("correctOption", correctLetter);
                    ak.put("correctAnswerText", correctText);
                    ak.put("marks", qMarks > 0 ? qMarks : 1.0);
                    answerKey.add(ak);

                    seq++;
                }
            }
        }

        Map<String, Object> meta = new LinkedHashMap<>();
        meta.put("institutionName", "Maharaja Institute of Technology Mysore");
        meta.put("portalName", "Autonomous Examination Management System");
        meta.put("documentType", "Archived Question Set & Confidential Answer Key");
        meta.put("examinationId", String.valueOf(eid));
        meta.put("examCode", "EXAM-" + subCode + "-" + eid);
        meta.put("examinationName", subName);
        meta.put("subjectCode", subCode);
        meta.put("subjectName", subName);
        meta.put("departmentCode", deptCode);
        meta.put("departmentName", deptName);
        meta.put("semester", String.valueOf(sem));
        meta.put("academicSession", acadSession);
        meta.put("examDate", examDate);
        meta.put("sittingName", "MORNING".equalsIgnoreCase(sitName) ? "Morning Sitting" : "Afternoon Sitting");
        meta.put("rawSittingName", sitName);
        meta.put("paperSetNumber", setNum);
        meta.put("paperTitle", paperTitle);
        meta.put("questionSetRevision", "R" + revNum);
        meta.put("durationMinutes", dur);
        meta.put("totalMarks", marks);
        meta.put("passingMarks", passingMarks);
        meta.put("assignedLab", assignedLab);
        meta.put("totalQuestions", questions.size());
        meta.put("status", sessStatus);
        meta.put("archiveGeneratedAt", Instant.now().toString());
        meta.put("confidentialityNotice", "STRICTLY CONFIDENTIAL — FOR CONTROLLER OF EXAMINATIONS (COE) / ADMIN USE ONLY");

        Map<String, Object> result = new LinkedHashMap<>();
        result.put("metadata", meta);
        result.put("questions", questions);
        result.put("answerKey", answerKey);
        return result;
    }

    static String getV1CoeQuestionPaperArchiveData(Connection db, User user, long eid, String sitName) throws Exception {
        user.require("COE", "ADMIN");
        Map<String, Object> archiveData = fetchArchiveData(db, eid, sitName);
        return v1Success(archiveData, "Question paper archive data loaded");
    }

    static byte[] generateQuestionPaperPdf(Map<String, Object> meta, List<Map<String, Object>> questions) throws IOException {
        String inst = String.valueOf(meta.getOrDefault("institutionName", "Maharaja Institute of Technology Mysore"));
        String subCode = String.valueOf(meta.getOrDefault("subjectCode", "CS301"));
        String subName = String.valueOf(meta.getOrDefault("subjectName", "Examination"));
        int setNum = meta.get("paperSetNumber") instanceof Number n ? n.intValue() : 1;
        String dur = String.valueOf(meta.getOrDefault("durationMinutes", "60"));
        String marks = String.valueOf(meta.getOrDefault("totalMarks", "30"));
        String date = String.valueOf(meta.getOrDefault("examDate", ""));
        String sitting = String.valueOf(meta.getOrDefault("sittingName", "Morning Sitting"));

        List<List<Map<String, Object>>> questionPages = new ArrayList<>();
        int qIdx = 0;
        int totalQ = questions.size();
        int pageNum = 1;
        while (qIdx < totalQ) {
            int pageSize = (pageNum == 1) ? 6 : 8;
            int end = Math.min(qIdx + pageSize, totalQ);
            questionPages.add(new ArrayList<>(questions.subList(qIdx, end)));
            qIdx = end;
            pageNum++;
        }
        if (questionPages.isEmpty()) {
            questionPages.add(new ArrayList<>());
        }

        int totalPages = questionPages.size() + 1; // +1 for Confidential Answer Key page
        List<byte[]> streams = new ArrayList<>();

        int currentQNum = 1;
        for (int p = 0; p < questionPages.size(); p++) {
            List<Map<String, Object>> pageQuestions = questionPages.get(p);
            StringBuilder sb = new StringBuilder();
            sb.append("BT\n");

            if (p == 0) {
                sb.append("/F2 15 Tf\n");
                sb.append("50 790 Td\n");
                sb.append("(").append(sanitizePdfText(inst)).append(") Tj\n");
                sb.append("0 -20 Td\n");
                sb.append("/F1 11 Tf\n");
                sb.append("(Autonomous Examination Management System - COE Official Archive) Tj\n");
                sb.append("0 -18 Td\n");
                sb.append("/F2 13 Tf\n");
                sb.append("(").append(sanitizePdfText("Question Paper - Set " + setNum + " : " + subCode + " - " + subName)).append(") Tj\n");
                sb.append("0 -18 Td\n");
                sb.append("/F1 10 Tf\n");
                sb.append("(").append(sanitizePdfText("Date: " + date + "  |  Sitting: " + sitting + "  |  Duration: " + dur + " Mins  |  Max Marks: " + marks)).append(") Tj\n");
                sb.append("0 -22 Td\n");
            } else {
                sb.append("/F2 11 Tf\n");
                sb.append("50 800 Td\n");
                sb.append("(").append(sanitizePdfText(inst + "  |  " + subCode + " (Set " + setNum + ")")).append(") Tj\n");
                sb.append("0 -15 Td\n");
                sb.append("/F1 9 Tf\n");
                sb.append("(Archived Question Paper - Strictly Confidential) Tj\n");
                sb.append("0 -20 Td\n");
            }

            for (Map<String, Object> q : pageQuestions) {
                int mod = q.get("moduleNumber") instanceof Number n ? n.intValue() : 1;
                String prompt = String.valueOf(q.getOrDefault("prompt", ""));
                String optA = String.valueOf(q.getOrDefault("optionA", ""));
                String optB = String.valueOf(q.getOrDefault("optionB", ""));
                String optC = String.valueOf(q.getOrDefault("optionC", ""));
                String optD = String.valueOf(q.getOrDefault("optionD", ""));

                sb.append("/F2 10 Tf\n");
                sb.append("(").append(sanitizePdfText("Q" + currentQNum + ". [Module " + mod + "] " + prompt)).append(") Tj\n");
                sb.append("0 -14 Td\n");
                sb.append("/F1 9 Tf\n");
                sb.append("(").append(sanitizePdfText("    A) " + optA + "    B) " + optB)).append(") Tj\n");
                sb.append("0 -13 Td\n");
                sb.append("(").append(sanitizePdfText("    C) " + optC + "    D) " + optD)).append(") Tj\n");
                sb.append("0 -18 Td\n");
                currentQNum++;
            }

            sb.append("ET\n");
            sb.append("BT\n");
            sb.append("/F1 9 Tf\n");
            sb.append("50 35 Td\n");
            sb.append("(").append(sanitizePdfText("Page " + (p + 1) + " of " + totalPages + "  |  Maharaja Institute of Technology Mysore Examination Management System")).append(") Tj\n");
            sb.append("ET\n");

            streams.add(sb.toString().getBytes(StandardCharsets.US_ASCII));
        }

        // Answer Key Page (Last Page)
        {
            StringBuilder sb = new StringBuilder();
            sb.append("BT\n");
            sb.append("/F2 14 Tf\n");
            sb.append("50 790 Td\n");
            sb.append("(").append(sanitizePdfText(inst)).append(") Tj\n");
            sb.append("0 -20 Td\n");
            sb.append("/F2 12 Tf\n");
            sb.append("(").append(sanitizePdfText("OFFICIAL ANSWER KEY & EVALUATION SCHEME - SET " + setNum)).append(") Tj\n");
            sb.append("0 -16 Td\n");
            sb.append("/F1 10 Tf\n");
            sb.append("(").append(sanitizePdfText("Subject: " + subCode + " - " + subName + "  |  Total Questions: " + questions.size() + "  |  Max Marks: " + marks)).append(") Tj\n");
            sb.append("0 -16 Td\n");
            sb.append("/F2 9 Tf\n");
            sb.append("(CONFIDENTIAL - AUTHORIZED CONTROLLER OF EXAMINATIONS (COE) / ADMIN ACCESS ONLY) Tj\n");
            sb.append("0 -25 Td\n");

            sb.append("/F2 10 Tf\n");
            sb.append("(Q#    Mod   Key   Correct Answer Text                                              Marks) Tj\n");
            sb.append("0 -14 Td\n");
            sb.append("/F1 9 Tf\n");

            int akIdx = 1;
            for (Map<String, Object> q : questions) {
                int mod = q.get("moduleNumber") instanceof Number n ? n.intValue() : 1;
                String ans = String.valueOf(q.getOrDefault("correctAnswer", ""));
                String ansText = String.valueOf(q.getOrDefault("correctAnswerText", ""));
                if (ansText.length() > 42) ansText = ansText.substring(0, 39) + "...";
                String mks = String.valueOf(q.getOrDefault("marks", "1.0"));

                String line = String.format("%-6s %-5s %-5s %-50s %s", "Q" + akIdx, "M" + mod, ans, ansText, mks);
                sb.append("(").append(sanitizePdfText(line)).append(") Tj\n");
                sb.append("0 -14 Td\n");
                akIdx++;
                if (akIdx == 38) {
                    sb.append("0 -10 Td\n");
                }
            }

            sb.append("ET\n");
            sb.append("BT\n");
            sb.append("/F1 9 Tf\n");
            sb.append("50 35 Td\n");
            sb.append("(").append(sanitizePdfText("Page " + totalPages + " of " + totalPages + " (Answer Key)  |  COE Strictly Confidential")).append(") Tj\n");
            sb.append("ET\n");

            streams.add(sb.toString().getBytes(StandardCharsets.US_ASCII));
        }

        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        List<Integer> offsets = new ArrayList<>();
        offsets.add(0);

        baos.write("%PDF-1.4\n".getBytes(StandardCharsets.US_ASCII));

        offsets.add(baos.size());
        baos.write("1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n".getBytes(StandardCharsets.US_ASCII));

        StringBuilder kids = new StringBuilder();
        for (int p = 0; p < totalPages; p++) {
            kids.append((10 + p * 2)).append(" 0 R ");
        }

        offsets.add(baos.size());
        baos.write(("2 0 obj\n<< /Type /Pages /Kids [" + kids.toString().trim() + "] /Count " + totalPages + " >>\nendobj\n").getBytes(StandardCharsets.US_ASCII));

        offsets.add(baos.size());
        baos.write("3 0 obj\n<< >>\nendobj\n".getBytes(StandardCharsets.US_ASCII));

        offsets.add(baos.size());
        baos.write("4 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\n".getBytes(StandardCharsets.US_ASCII));

        offsets.add(baos.size());
        baos.write("5 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>\nendobj\n".getBytes(StandardCharsets.US_ASCII));

        for (int i = 6; i <= 9; i++) {
            offsets.add(baos.size());
            baos.write((i + " 0 obj\n<< >>\nendobj\n").getBytes(StandardCharsets.US_ASCII));
        }

        for (int p = 0; p < totalPages; p++) {
            int pageObj = 10 + p * 2;
            int streamObj = 11 + p * 2;
            byte[] streamBytes = streams.get(p);

            while (offsets.size() < pageObj) offsets.add(baos.size());
            offsets.add(baos.size());
            baos.write((pageObj + " 0 obj\n<< /Type /Page /Parent 2 0 R /Resources << /Font << /F1 4 0 R /F2 5 0 R >> >> /MediaBox [0 0 595 842] /Contents " + streamObj + " 0 R >>\nendobj\n").getBytes(StandardCharsets.US_ASCII));

            offsets.add(baos.size());
            baos.write((streamObj + " 0 obj\n<< /Length " + streamBytes.length + " >>\nstream\n").getBytes(StandardCharsets.US_ASCII));
            baos.write(streamBytes);
            baos.write("\nendstream\nendobj\n".getBytes(StandardCharsets.US_ASCII));
        }

        int startXref = baos.size();
        int totalObjs = 10 + totalPages * 2;
        baos.write(("xref\n0 " + totalObjs + "\n0000000000 65535 f \n").getBytes(StandardCharsets.US_ASCII));
        for (int i = 1; i < totalObjs; i++) {
            int off = (i < offsets.size()) ? offsets.get(i) : 0;
            baos.write(String.format("%010d 00000 n \n", off).getBytes(StandardCharsets.US_ASCII));
        }

        baos.write(("trailer\n<< /Size " + totalObjs + " /Root 1 0 R >>\nstartxref\n" + startXref + "\n%%EOF\n").getBytes(StandardCharsets.US_ASCII));
        return baos.toByteArray();
    }

    static byte[] buildQuestionPaperXlsxBytes(Map<String, Object> meta, List<Map<String, Object>> questions) throws IOException {
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        try (ZipOutputStream zos = new ZipOutputStream(baos)) {
            addZipEntry(zos, "[Content_Types].xml", """
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
                  <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
                  <Default Extension="xml" ContentType="application/xml"/>
                  <Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>
                  <Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>
                  <Override PartName="/xl/worksheets/sheet2.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>
                  <Override PartName="/xl/worksheets/sheet3.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>
                  <Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>
                </Types>
                """.stripIndent());

            addZipEntry(zos, "_rels/.rels", """
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
                  <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>
                </Relationships>
                """.stripIndent());

            addZipEntry(zos, "xl/_rels/workbook.xml.rels", """
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
                  <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>
                  <Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet2.xml"/>
                  <Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet3.xml"/>
                  <Relationship Id="rId4" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>
                </Relationships>
                """.stripIndent());

            addZipEntry(zos, "xl/workbook.xml", """
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
                  <sheets>
                    <sheet name="EXAMINATION INFORMATION" sheetId="1" r:id="rId1"/>
                    <sheet name="COMPLETE QUESTION SET" sheetId="2" r:id="rId2"/>
                    <sheet name="ANSWER KEY" sheetId="3" r:id="rId3"/>
                  </sheets>
                </workbook>
                """.stripIndent());

            addZipEntry(zos, "xl/styles.xml", """
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
                  <fonts count="4">
                    <font><sz val="11"/><name val="Calibri"/></font>
                    <font><b/><sz val="11"/><name val="Calibri"/><color rgb="FF1F2937"/></font>
                    <font><b/><sz val="14"/><name val="Calibri"/><color rgb="FF1E3A8A"/></font>
                    <font><b/><sz val="11"/><name val="Calibri"/><color rgb="FFFFFFFF"/></font>
                  </fonts>
                  <fills count="4">
                    <fill><patternFill patternType="none"/></fill>
                    <fill><patternFill patternType="gray125"/></fill>
                    <fill><patternFill patternType="solid"><fgColor rgb="FF2563EB"/></patternFill></fill>
                    <fill><patternFill patternType="solid"><fgColor rgb="FFF1F5F9"/></patternFill></fill>
                  </fills>
                  <borders count="2">
                    <border><left/><right/><top/><bottom/></border>
                    <border>
                      <left style="thin"><color rgb="FFCBD5E1"/></left>
                      <right style="thin"><color rgb="FFCBD5E1"/></right>
                      <top style="thin"><color rgb="FFCBD5E1"/></top>
                      <bottom style="thin"><color rgb="FFCBD5E1"/></bottom>
                    </border>
                  </borders>
                  <cellStyleXfs count="1">
                    <xf numFmtId="0" fontId="0" fillId="0" borderId="0"/>
                  </cellStyleXfs>
                  <cellXfs count="5">
                    <xf numFmtId="0" fontId="0" fillId="0" borderId="1" xfId="0" applyBorder="1"/>
                    <xf numFmtId="0" fontId="3" fillId="2" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1"><alignment horizontal="center" vertical="center" wrapText="1"/></xf>
                    <xf numFmtId="0" fontId="1" fillId="3" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1"/>
                    <xf numFmtId="0" fontId="2" fillId="0" borderId="0" xfId="0" applyFont="1"/>
                    <xf numFmtId="0" fontId="0" fillId="0" borderId="1" xfId="0" applyBorder="1" applyAlignment="1"><alignment vertical="top" wrapText="1"/></xf>
                  </cellXfs>
                </styleSheet>
                """.stripIndent());

            // Sheet 1: Examination Information
            StringBuilder s1 = new StringBuilder();
            s1.append("""
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
                  <cols>
                    <col min="1" max="1" width="30" customWidth="1"/>
                    <col min="2" max="2" width="60" customWidth="1"/>
                  </cols>
                  <sheetData>
                """);
            appendXlsxRow(s1, 1, 3, "MAHARAJA INSTITUTE OF TECHNOLOGY MYSORE", "");
            appendXlsxRow(s1, 2, 0, "Autonomous Examination Management System — COE Official Question Archive", "");
            appendXlsxRow(s1, 3, 0, "", "");
            appendXlsxRow(s1, 4, 1, "ARCHIVE METADATA PROPERTY", "OFFICIAL RECORD VALUE");
            int r1 = 5;
            for (Map.Entry<String, Object> e : meta.entrySet()) {
                appendXlsxRow(s1, r1++, 2, e.getKey(), String.valueOf(e.getValue()));
            }
            s1.append("</sheetData></worksheet>");
            addZipEntry(zos, "xl/worksheets/sheet1.xml", s1.toString());

            // Sheet 2: Complete Question Set
            StringBuilder s2 = new StringBuilder();
            s2.append("""
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
                  <sheetViews>
                    <sheetView tabSelected="1" workbookViewId="0">
                      <pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/>
                    </sheetView>
                  </sheetViews>
                  <cols>
                    <col min="1" max="1" width="10" customWidth="1"/>
                    <col min="2" max="2" width="12" customWidth="1"/>
                    <col min="3" max="3" width="14" customWidth="1"/>
                    <col min="4" max="4" width="45" customWidth="1"/>
                    <col min="5" max="8" width="28" customWidth="1"/>
                    <col min="9" max="9" width="16" customWidth="1"/>
                    <col min="10" max="10" width="30" customWidth="1"/>
                    <col min="11" max="11" width="10" customWidth="1"/>
                    <col min="12" max="12" width="22" customWidth="1"/>
                  </cols>
                  <sheetData>
                """);
            s2.append("<row r=\"1\">");
            appendXlsxCell(s2, "A1", 1, "Serial Number");
            appendXlsxCell(s2, "B1", 1, "Module");
            appendXlsxCell(s2, "C1", 1, "Original Question Number");
            appendXlsxCell(s2, "D1", 1, "Question");
            appendXlsxCell(s2, "E1", 1, "Option A");
            appendXlsxCell(s2, "F1", 1, "Option B");
            appendXlsxCell(s2, "G1", 1, "Option C");
            appendXlsxCell(s2, "H1", 1, "Option D");
            appendXlsxCell(s2, "I1", 1, "Correct Answer");
            appendXlsxCell(s2, "J1", 1, "Correct Answer Text");
            appendXlsxCell(s2, "K1", 1, "Marks");
            appendXlsxCell(s2, "L1", 1, "Question Type");
            s2.append("</row>");

            int rowIdx = 2;
            for (Map<String, Object> q : questions) {
                s2.append("<row r=\"").append(rowIdx).append("\">");
                appendXlsxCell(s2, "A" + rowIdx, 4, String.valueOf(q.get("serialNumber")));
                appendXlsxCell(s2, "B" + rowIdx, 4, String.valueOf(q.get("moduleNumber")));
                appendXlsxCell(s2, "C" + rowIdx, 4, String.valueOf(q.get("originalQuestionNumber")));
                appendXlsxCell(s2, "D" + rowIdx, 4, String.valueOf(q.get("prompt")));
                appendXlsxCell(s2, "E" + rowIdx, 4, String.valueOf(q.get("optionA")));
                appendXlsxCell(s2, "F" + rowIdx, 4, String.valueOf(q.get("optionB")));
                appendXlsxCell(s2, "G" + rowIdx, 4, String.valueOf(q.get("optionC")));
                appendXlsxCell(s2, "H" + rowIdx, 4, String.valueOf(q.get("optionD")));
                appendXlsxCell(s2, "I" + rowIdx, 4, String.valueOf(q.get("correctAnswer")));
                appendXlsxCell(s2, "J" + rowIdx, 4, String.valueOf(q.get("correctAnswerText")));
                appendXlsxCell(s2, "K" + rowIdx, 4, String.valueOf(q.get("marks")));
                appendXlsxCell(s2, "L" + rowIdx, 4, String.valueOf(q.get("questionType")));
                s2.append("</row>");
                rowIdx++;
            }
            s2.append("</sheetData><autoFilter ref=\"A1:L").append(rowIdx - 1).append("\"/></worksheet>");
            addZipEntry(zos, "xl/worksheets/sheet2.xml", s2.toString());

            // Sheet 3: Answer Key
            StringBuilder s3 = new StringBuilder();
            s3.append("""
                <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
                <worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
                  <sheetViews>
                    <sheetView tabSelected="0" workbookViewId="0">
                      <pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/>
                    </sheetView>
                  </sheetViews>
                  <cols>
                    <col min="1" max="1" width="16" customWidth="1"/>
                    <col min="2" max="2" width="12" customWidth="1"/>
                    <col min="3" max="3" width="16" customWidth="1"/>
                    <col min="4" max="4" width="35" customWidth="1"/>
                    <col min="5" max="5" width="12" customWidth="1"/>
                  </cols>
                  <sheetData>
                """);
            s3.append("<row r=\"1\">");
            appendXlsxCell(s3, "A1", 1, "Question Number");
            appendXlsxCell(s3, "B1", 1, "Module");
            appendXlsxCell(s3, "C1", 1, "Correct Option");
            appendXlsxCell(s3, "D1", 1, "Correct Answer Text");
            appendXlsxCell(s3, "E1", 1, "Marks");
            s3.append("</row>");

            int r3 = 2;
            for (Map<String, Object> q : questions) {
                s3.append("<row r=\"").append(r3).append("\">");
                appendXlsxCell(s3, "A" + r3, 4, String.valueOf(q.get("serialNumber")));
                appendXlsxCell(s3, "B" + r3, 4, String.valueOf(q.get("moduleNumber")));
                appendXlsxCell(s3, "C" + r3, 4, String.valueOf(q.get("correctAnswer")));
                appendXlsxCell(s3, "D" + r3, 4, String.valueOf(q.get("correctAnswerText")));
                appendXlsxCell(s3, "E" + r3, 4, String.valueOf(q.get("marks")));
                s3.append("</row>");
                r3++;
            }
            s3.append("</sheetData><autoFilter ref=\"A1:E").append(r3 - 1).append("\"/></worksheet>");
            addZipEntry(zos, "xl/worksheets/sheet3.xml", s3.toString());
        }
        return baos.toByteArray();
    }

    private static void appendXlsxRow(StringBuilder sb, int row, int styleId, String c1, String c2) {
        sb.append("<row r=\"").append(row).append("\">");
        appendXlsxCell(sb, "A" + row, styleId, c1);
        appendXlsxCell(sb, "B" + row, styleId, c2);
        sb.append("</row>");
    }

    private static void appendXlsxCell(StringBuilder sb, String ref, int styleId, String val) {
        sb.append("<c r=\"").append(ref).append("\"");
        if (styleId > 0) sb.append(" s=\"").append(styleId).append("\"");
        sb.append(" t=\"inlineStr\"><is><t>");
        if (val != null) {
            for (int i = 0; i < val.length(); i++) {
                char c = val.charAt(i);
                switch (c) {
                    case '&' -> sb.append("&amp;");
                    case '<' -> sb.append("&lt;");
                    case '>' -> sb.append("&gt;");
                    case '"' -> sb.append("&quot;");
                    case '\'' -> sb.append("&apos;");
                    default -> {
                        if (c >= 0x20 || c == '\t' || c == '\n' || c == '\r') sb.append(c);
                    }
                }
            }
        }
        sb.append("</t></is></c>");
    }

    private static void addZipEntry(ZipOutputStream zos, String name, String content) throws IOException {
        ZipEntry ze = new ZipEntry(name);
        zos.putNextEntry(ze);
        zos.write(content.getBytes(StandardCharsets.UTF_8));
        zos.closeEntry();
    }

    static String sanitizePdfText(String text) {
        if (text == null) return "";
        return text.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)").replace("\r", " ").replace("\n", " ");
    }

    static long parseLongSafe(Object val) {
        if (val == null) return 0L;
        if (val instanceof Number n) return n.longValue();
        String s = val.toString().trim();
        if (s.isEmpty()) return 0L;
        if (s.contains(".")) s = s.substring(0, s.indexOf('.'));
        try {
            return Long.parseLong(s);
        } catch (Exception e) {
            return 0L;
        }
    }

    @SuppressWarnings("unchecked")
    static Map<String, Map<String, Object>> fetchLabServerTelemetry() {
        Map<String, Map<String, Object>> telemetryMap = new HashMap<>();
        try {
            String labUrl = System.getenv().getOrDefault("LAB_SERVER_URL", "http://127.0.0.1:8082");
            var client = java.net.http.HttpClient.newBuilder().connectTimeout(Duration.ofMillis(1500)).build();
            var req = java.net.http.HttpRequest.newBuilder()
                    .uri(URI.create(labUrl + "/lab-api/monitoring/sessions"))
                    .timeout(Duration.ofMillis(2000))
                    .GET()
                    .build();
            var res = client.send(req, java.net.http.HttpResponse.BodyHandlers.ofString());
            if (res.statusCode() == 200) {
                Object parsed = Json.parse(res.body());
                if (parsed instanceof List<?> list) {
                    for (Object it : list) {
                        if (it instanceof Map<?, ?> m) {
                            String exId = String.valueOf(m.get("examinationId"));
                            Map<String, Object> copy = new LinkedHashMap<>();
                            m.forEach((k, v) -> copy.put(String.valueOf(k), v));
                            telemetryMap.put(exId, copy);
                        }
                    }
                }
            }
        } catch (Exception ignored) {}
        return telemetryMap;
    }

    static String getV1MonitoringSessions(Connection db, User user) throws SQLException {
        Map<String, Map<String, Object>> labTelemetry = fetchLabServerTelemetry();
        List<Map<String, Object>> monitors = new ArrayList<>();
        try (var st = sql(db, """
                SELECT es.id, s.code, s.name, d.code, ag.semester,
                       es.session_date, es.start_time, es.duration_minutes,
                       coalesce(es.assigned_lab, 'LAB-CSE-01'), es.status, es.sitting
                FROM examination_session es
                JOIN subject s ON s.id = es.subject_id
                JOIN department d ON d.id = es.department_id
                JOIN academic_group ag ON ag.id = es.group_id
                ORDER BY es.session_date DESC, es.id DESC
                """); var rs = st.executeQuery()) {
            while (rs.next()) {
                long eid = rs.getLong(1);
                String subCode = rs.getString(2);
                String subName = rs.getString(3);
                String deptCode = rs.getString(4);
                int semester = rs.getInt(5);
                String examDate = rs.getString(6);
                String startTime = rs.getString(7);
                int durationMinutes = rs.getInt(8);
                String labName = rs.getString(9);
                String sittingRaw = rs.getString(11);
                String sittingName = "MORNING".equalsIgnoreCase(sittingRaw) ? "Morning Sitting" : "Afternoon Sitting";

                // Count frozen eligible students for this sitting
                int eligibleCount = 0;
                try (var sst = sql(db, "SELECT count(*) FROM session_roster_snapshot WHERE session_id=? AND sitting_name=?", eid, sittingRaw);
                     var srs = sst.executeQuery()) {
                    if (srs.next()) eligibleCount = srs.getInt(1);
                }
                if (eligibleCount == 0) eligibleCount = 10;

                Map<String, Object> mon = new LinkedHashMap<>();
                mon.put("sessionId", String.valueOf(eid));
                mon.put("examinationId", String.valueOf(eid));
                mon.put("examinationCode", "EXAM-" + subCode + "-" + eid);
                mon.put("department", deptCode);
                mon.put("semester", semester);
                mon.put("subjectCode", subCode);
                mon.put("subjectName", subName);
                mon.put("sittingName", sittingName);
                mon.put("examDate", examDate);
                mon.put("startTime", startTime);
                mon.put("durationMinutes", durationMinutes);
                mon.put("labId", "LAB-CSE-01");
                mon.put("labName", labName);
                mon.put("lastSyncedAt", Instant.now().toString());

                Map<String, Object> live = labTelemetry.get(String.valueOf(eid));
                if (live != null) {
                    mon.put("labServerStatus", "Connected");
                    mon.put("remainingTime", live.getOrDefault("remainingTime", "01:00:00"));
                    mon.put("sessionStatus", live.getOrDefault("sessionStatus", "Active"));
                    mon.put("totalEligibleStudents", live.getOrDefault("totalEligibleStudents", eligibleCount));
                    mon.put("studentsLoggedIn", live.getOrDefault("studentsLoggedIn", 0));
                    mon.put("studentsStarted", live.getOrDefault("studentsStarted", 0));
                    mon.put("studentsSubmitted", live.getOrDefault("studentsSubmitted", 0));
                    mon.put("studentsNotStarted", live.getOrDefault("studentsNotStarted", eligibleCount));
                    mon.put("connectedStudents", live.getOrDefault("connectedStudents", 0));
                    mon.put("disconnectedStudents", live.getOrDefault("disconnectedStudents", 0));
                    mon.put("interruptedStudentsCount", live.getOrDefault("interruptedStudentsCount", 0));
                    mon.put("pendingRecoveryCount", live.getOrDefault("pendingRecoveryCount", 0));
                    mon.put("activeLabComputers", live.getOrDefault("activeLabComputers", 0));
                    mon.put("totalSuspiciousEvents", live.getOrDefault("totalSuspiciousEvents", 0));
                    mon.put("lockedStudentsCount", live.getOrDefault("lockedStudentsCount", 0));
                    mon.put("invigilatorUnlockCount", live.getOrDefault("invigilatorUnlockCount", 0));
                    mon.put("pcRecoveryCount", live.getOrDefault("pcRecoveryCount", 0));
                    mon.put("students", live.getOrDefault("students", List.of()));
                    mon.put("suspiciousEvents", live.getOrDefault("suspiciousEvents", List.of()));
                    mon.put("pcRecoveryEvents", live.getOrDefault("pcRecoveryEvents", List.of()));
                } else {
                    mon.put("labServerStatus", "Disconnected");
                    mon.put("remainingTime", "00:00:00");
                    mon.put("sessionStatus", "Ready");
                    mon.put("totalEligibleStudents", eligibleCount);
                    mon.put("studentsLoggedIn", 0);
                    mon.put("studentsStarted", 0);
                    mon.put("studentsSubmitted", 0);
                    mon.put("studentsNotStarted", eligibleCount);
                    mon.put("connectedStudents", 0);
                    mon.put("disconnectedStudents", 0);
                    mon.put("interruptedStudentsCount", 0);
                    mon.put("pendingRecoveryCount", 0);
                    mon.put("activeLabComputers", 0);
                    mon.put("totalSuspiciousEvents", 0);
                    mon.put("lockedStudentsCount", 0);
                    mon.put("invigilatorUnlockCount", 0);
                    mon.put("pcRecoveryCount", 0);
                    mon.put("students", List.of());
                    mon.put("suspiciousEvents", List.of());
                    mon.put("pcRecoveryEvents", List.of());
                }
                monitors.add(mon);
            }
        }
        return v1Success(monitors, "Live session telemetry");
    }

    static String getV1MonitoringSessionById(Connection db, User user, String id) throws SQLException {
        long eid = 0;
        try { eid = Long.parseLong(id); } catch (Exception ignored) {}
        Map<String, Map<String, Object>> labTelemetry = fetchLabServerTelemetry();

        try (var st = sql(db, """
                SELECT es.id, s.code, s.name, d.code, ag.semester,
                       es.session_date, es.start_time, es.duration_minutes,
                       coalesce(es.assigned_lab, 'LAB-CSE-01'), es.status, es.sitting
                FROM examination_session es
                JOIN subject s ON s.id = es.subject_id
                JOIN department d ON d.id = es.department_id
