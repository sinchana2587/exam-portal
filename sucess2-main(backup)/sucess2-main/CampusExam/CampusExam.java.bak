        }
        if (path.equals("hod/audit-logs") && method.equals("GET")) {
            return getV1HodAuditLogs(db, user);
        }

        // 4. COE routes
        if (path.startsWith("coe/")) path = path.substring(4);
        if ((path.equals("institution/departments") || path.equals("departments") || path.equals("principal/departments")) && method.equals("GET")) {
            return getV1InstitutionDepartments(db, user);
        }
        if (path.equals("institution/semesters") && method.equals("GET")) {
            return getV1InstitutionSemesters(db, user);
        }
        if ((path.startsWith("institution/eligibility") || path.startsWith("examinations/eligibility")) && method.equals("GET")) {
            return getV1InstitutionEligibility(db, user, form);
        }
        if (path.startsWith("institution/subjects") && method.equals("GET")) {
            return getV1InstitutionSubjects(db, user, form);
        }
        if ((path.equals("institution/published-question-sets") || path.equals("coe/published-question-sets")) && method.equals("GET")) {
            return getV1InstitutionPublishedQuestionSets(db, user);
        }
        if ((path.equals("examinations/scheduled") || path.equals("examinations")) && method.equals("GET")) {
            return getV1CoeScheduledExaminations(db, user);
        }
        if (path.equals("examinations/schedule") && method.equals("POST")) {
            return createV1CoeScheduledExamination(db, user, form);
        }
        if (path.startsWith("examinations/") && (path.endsWith("/confirm-schedule") || path.endsWith("/freeze")) && method.equals("POST")) {
            String suffix = path.endsWith("/confirm-schedule") ? "/confirm-schedule" : "/freeze";
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - suffix.length()));
            return confirmV1CoeExaminationSchedule(db, user, eid);
        }
        if (path.startsWith("examinations/") && path.endsWith("/question-sets") && method.equals("GET")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - "/question-sets".length()));
            return getV1CoeExaminationQuestionSets(db, user, eid);
        }
        if (path.startsWith("examinations/") && path.endsWith("/select-set") && method.equals("POST")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - "/select-set".length()));
            return selectV1CoeExaminationSet(db, user, eid, form);
        }
        if (path.startsWith("examinations/") && (path.endsWith("/prepare-and-send-package") || path.contains("/export-package")) && method.equals("POST")) {
            String sub = path.substring("examinations/".length());
            long eid = Long.parseLong(sub.substring(0, sub.indexOf('/')));
            if (path.contains("/sittings/")) {
                String sit = path.substring(path.indexOf("/sittings/") + "/sittings/".length());
                if (sit.contains("/")) sit = sit.substring(0, sit.indexOf('/'));
                form.values().put("sittingName", sit);
            }
            return prepareAndSendV1CoePackage(db, user, eid, form);
        }
        if (path.startsWith("examinations/") && (path.endsWith("/retry-transfer") || path.endsWith("/retry-package-transfer")) && method.equals("POST")) {
            String sub = path.substring("examinations/".length());
            long eid = Long.parseLong(sub.substring(0, sub.indexOf('/')));
            return retryV1CoePackageTransfer(db, user, eid, form);
        }
        if (path.startsWith("examinations/") && (path.endsWith("/sittings") || path.endsWith("/allocation")) && method.equals("PUT")) {
            String sub = path.substring("examinations/".length());
            long eid = Long.parseLong(sub.substring(0, sub.indexOf('/')));
            return updateV1CoeSittingAllocation(db, user, eid, form);
        }
        if (path.startsWith("examinations/") && path.endsWith("/settings") && method.equals("PUT")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - "/settings".length()));
            return updateV1CoeExaminationSettings(db, user, eid, form);
        }
        if (path.startsWith("examinations/") && path.endsWith("/cancel") && method.equals("POST")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - "/cancel".length()));
            return cancelV1CoeExamination(db, user, eid, form);
        }
        if (path.equals("examinations/unlock-credentials") && method.equals("GET")) {
            return getV1CoeUnlockCredentials(db, user);
        }
        if (path.startsWith("examinations/") && path.contains("/sittings/") && path.contains("/unlock-credential") && method.equals("POST")) {
            String rest = path.substring("examinations/".length());
            String[] segs = rest.split("/sittings/|/unlock-credential");
            long eid = Long.parseLong(segs[0]);
            String sitRaw = segs[1].toUpperCase(Locale.ROOT);
            String sit = sitRaw.contains("AFTERNOON") || sitRaw.endsWith("-A") ? "AFTERNOON" : "MORNING";
            if (path.endsWith("/revoke")) {
                return revokeV1CoeSessionUnlockCredential(db, user, eid, sit);
            }
            return generateV1CoeSessionUnlockCredential(db, user, eid, sit);
        }
        if (path.startsWith("examinations/") && path.endsWith("/question-paper-archive") && method.equals("GET")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - "/question-paper-archive".length()));
            return getV1CoeQuestionPaperArchive(db, user, eid);
        }
        if (path.startsWith("examinations/") && path.contains("/question-paper-archive/data") && method.equals("GET")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.indexOf("/question-paper-archive/data")).replaceAll("/sittings/.*", ""));
            String sitName = "MORNING";
            if (path.contains("/sittings/")) {
                String sPart = path.substring(path.indexOf("/sittings/") + "/sittings/".length());
                sitName = sPart.substring(0, sPart.indexOf("/"));
            }
            return getV1CoeQuestionPaperArchiveData(db, user, eid, sitName);
        }
        if (path.startsWith("examinations/") && path.contains("/question-paper-archive/download-excel") && method.equals("GET")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.indexOf("/question-paper-archive/download-excel")).replaceAll("/sittings/.*", ""));
            String sitName = "MORNING";
            if (path.contains("/sittings/")) {
                String sPart = path.substring(path.indexOf("/sittings/") + "/sittings/".length());
                sitName = sPart.substring(0, sPart.indexOf("/"));
            }
            user.require("COE", "ADMIN");
            return "__QUESTION_PAPER_XLSX__:" + eid + ":" + sitName;
        }
        if (path.startsWith("examinations/") && path.contains("/question-paper-archive/download") && method.equals("GET")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.indexOf("/question-paper-archive/download")).replaceAll("/sittings/.*", ""));
            String sitName = "MORNING";
            if (path.contains("/sittings/")) {
                String sPart = path.substring(path.indexOf("/sittings/") + "/sittings/".length());
                sitName = sPart.substring(0, sPart.indexOf("/"));
            }
            user.require("COE", "ADMIN");
            return "__QUESTION_PAPER_PDF__:" + eid + ":" + sitName;
        }
        if (path.startsWith("examinations/") && method.equals("PUT")) {
            long eid = Long.parseLong(path.substring("examinations/".length()));
            return updateV1CoeExaminationSettings(db, user, eid, form);
        }
        if (path.matches("^examinations/\\d+$") && method.equals("GET")) {
            long eid = Long.parseLong(path.substring("examinations/".length()));
            return getV1CoeExaminationById(db, user, eid);
        }
        if (path.startsWith("examinations/") && path.endsWith("/examiners") && method.equals("POST")) {
            long eid = Long.parseLong(path.substring("examinations/".length(), path.length() - "/examiners".length()));
            return saveV1CoeExaminers(db, user, eid, form);
        }
        if (path.startsWith("examinations/") && method.equals("DELETE")) {
            long eid = Long.parseLong(path.substring("examinations/".length()));
            return deleteV1CoeExamination(db, user, eid);
        }
        if (path.equals("audit/logs") && method.equals("GET")) {
            return getV1CoeAuditLogs(db, user);
        }
        if ((path.equals("labs/servers") || path.equals("institution/laboratories") || path.equals("laboratories")) && method.equals("GET")) {
            return getV1LabServers(db, user);
        }
        if ((path.equals("institution/laboratories") || path.equals("laboratories") || path.equals("labs")) && method.equals("POST")) {
            return createV1Laboratory(db, user, form);
        }
        if ((path.startsWith("institution/laboratories/") || path.startsWith("laboratories/")) && path.endsWith("/history") && method.equals("GET")) {
            String sub = path.startsWith("institution/laboratories/")
                    ? path.substring("institution/laboratories/".length(), path.length() - "/history".length())
                    : path.substring("laboratories/".length(), path.length() - "/history".length());
            Long labId = null;
            try {
                labId = Long.parseLong(sub);
            } catch (Exception ignored) {
                String idStr = one(db, "SELECT id FROM laboratory WHERE upper(code)=? OR upper(name)=?", sub.toUpperCase(Locale.ROOT), sub.toUpperCase(Locale.ROOT));
                if (!idStr.isBlank()) labId = Long.parseLong(idStr);
            }
            check(labId != null, 404, "Laboratory not found: " + sub);
            return getV1LaboratoryHistory(db, user, labId);
        }
        if ((path.startsWith("institution/laboratories/") || path.startsWith("laboratories/")) && (method.equals("PATCH") || method.equals("PUT"))) {
            String sub = path.startsWith("institution/laboratories/")
                    ? path.substring("institution/laboratories/".length())
                    : path.substring("laboratories/".length());
            Long labId = null;
            try {
                labId = Long.parseLong(sub);
            } catch (Exception ignored) {
                String idStr = one(db, "SELECT id FROM laboratory WHERE upper(code)=? OR upper(name)=?", sub.toUpperCase(Locale.ROOT), sub.toUpperCase(Locale.ROOT));
                if (!idStr.isBlank()) labId = Long.parseLong(idStr);
            }
            check(labId != null, 404, "Laboratory not found: " + sub);
            return updateV1Laboratory(db, user, labId, form);
        }
        if (path.equals("monitoring/sessions") && method.equals("GET")) {
            return getV1MonitoringSessions(db, user);
        }
        if (path.startsWith("monitoring/sessions/") && !path.contains("/unlock-event") && method.equals("GET")) {
            return getV1MonitoringSessionById(db, user, path.substring("monitoring/sessions/".length()));
        }
        if (path.startsWith("labs/") && path.contains("/package-receipt") && method.equals("GET")) {
            return v1Success(Map.of("alreadyReceived", true, "verified", true), "Receipt verified");
        }
        if (path.startsWith("labs/") && path.contains("/workstation-bind") && method.equals("POST")) {
            return v1Success(Map.of("binding", Map.of("workstationId", form.get("pcId") != null ? form.get("pcId") : "PC-01", "studentUsn", form.get("studentUsn") != null ? form.get("studentUsn") : "4MH24CS001"), "assignedVersion", "A"), "Workstation bound");
        }
        if (path.startsWith("labs/") && path.contains("/pc-recovery") && method.equals("POST")) {
            return v1Success(Map.of("status", "Recovered", "success", true), "Workstation recovered");
        }
        if (path.startsWith("labs/") && path.contains("/verify-unlock") && method.equals("POST")) {
            return v1Success(Map.of("verified", true, "unlocked", true), "Invigilator unlock verified");
        }
        if (path.startsWith("monitoring/sessions/") && path.endsWith("/unlock-event") && method.equals("POST")) {
            return v1Success(Map.of("acknowledged", true), "Unlock event recorded");
        }
        if (path.equals("results/examinations") && method.equals("GET")) {
            return getV1CoeResultExaminations(db, user);
        }
        if (path.equals("results/answer-key-corrections") && method.equals("GET")) {
            return getV1CoeAnswerKeyCorrections(db, user);
        }
        if (path.startsWith("results/answer-key-corrections/") && (path.endsWith("/decide") || path.endsWith("/review")) && method.equals("POST")) {
            long cid = Long.parseLong(path.substring("results/answer-key-corrections/".length(), path.length() - (path.endsWith("/decide") ? "/decide".length() : "/review".length())));
            return decideV1CoeAnswerKeyCorrection(db, user, cid, form);
        }
        if ((path.equals("results/verify-upload") || path.equals("coe/results/verify-upload")) && method.equals("POST")) {
            return verifyV1ResultUpload(db, user, form);
        }
        if ((path.equals("import-results") || path.equals("coe/import-results") || path.equals("results/import-results")) && method.equals("POST")) {
            return importLabResults(db, user, form);
        }
        if ((path.equals("approve-results") || path.equals("coe/approve-results") || path.equals("results/approve-results")) && method.equals("POST")) {
            return approveResults(db, user, form);
        }
        if ((path.equals("release-results") || path.equals("coe/release-results") || path.equals("results/release-results")) && method.equals("POST")) {
            return releaseResults(db, user, form);
        }
        if ((path.equals("results/import-verified") || path.equals("coe/results/import-verified") || path.equals("coe/results/import-signed") || path.equals("results/import-signed") || path.equals("results/import-package") || path.equals("coe/results/import-package")) && method.equals("POST")) {
            return importV1VerifiedResults(db, user, form);
        }
        if ((path.startsWith("results/") || path.startsWith("coe/results/")) && path.endsWith("/approve") && method.equals("POST")) {
            String sub = path.startsWith("coe/results/") ? path.substring("coe/results/".length()) : path.substring("results/".length());
            long rid = Long.parseLong(sub.substring(0, sub.length() - "/approve".length()));
            return approveV1CoeResult(db, user, rid);
        }
        if ((path.startsWith("results/") || path.startsWith("coe/results/")) && path.endsWith("/release") && method.equals("POST")) {
            String sub = path.startsWith("coe/results/") ? path.substring("coe/results/".length()) : path.substring("results/".length());
            long rid = Long.parseLong(sub.substring(0, sub.length() - "/release".length()));
            return releaseV1CoeResult(db, user, rid);
        }
        if ((path.startsWith("results/") || path.startsWith("coe/results/")) && path.endsWith("/approve-release") && method.equals("POST")) {
            String sub = path.startsWith("coe/results/") ? path.substring("coe/results/".length()) : path.substring("results/".length());
            long rid = Long.parseLong(sub.substring(0, sub.length() - "/approve-release".length()));
            return approveAndReleaseV1CoeResult(db, user, rid);
        }
        if (path.equals("course-outcomes") && method.equals("GET")) {
            return getV1CoeCourseOutcomes(db, user, form);
        }
        if (path.startsWith("course-outcomes/") && path.endsWith("/review") && method.equals("POST")) {
            long cid = Long.parseLong(path.substring("course-outcomes/".length(), path.length() - "/review".length()));
            return reviewV1CoeCourseOutcome(db, user, cid, form);
        }
        if (path.startsWith("course-outcomes/") && path.contains("/revisions/") && path.endsWith("/document") && method.equals("GET")) {
            String[] parts = path.split("/");
            long subId = Long.parseLong(parts[1]);
            int revNum = Integer.parseInt(parts[3]);
            String revRowId = one(db, "SELECT id FROM course_outcome_revision WHERE submission_id = ? AND revision_number = ?", subId, revNum);
            if (revRowId.isEmpty()) {
                revRowId = one(db, "SELECT id FROM course_outcome_revision WHERE submission_id = ? ORDER BY revision_number DESC LIMIT 1", subId);
            }
            check(!revRowId.isEmpty(), 404, "Revision document not found");
            return "__BINARY_RESPONSE__:" + revRowId;
        }
        if (path.startsWith("course-outcomes/") && method.equals("GET")) {
            long cid = Long.parseLong(path.substring("course-outcomes/".length()));
            return getV1CoeCourseOutcomeById(db, user, cid);
        }

        throw new Problem(404, "Endpoint not found: " + path);
    }

}
