    static String getV1HodSubjects(Connection db, User user, Form form) throws SQLException {
        user.require("HOD", "PRINCIPAL", "COE", "ADMIN");
        Long deptId = user.role().equalsIgnoreCase("HOD") ? user.departmentId() : (form.get("departmentId").isBlank() ? null : form.id("departmentId"));
        String semStr = form.get("semesterNumber");

        String query = "SELECT s.id, s.code, s.name, s.semester AS \"semesterNumber\", s.department_id AS \"departmentId\", '2026-27' AS \"academicYearId\", s.module_count AS \"moduleCount\", s.status, s.applicable_sections FROM subject s WHERE 1=1";
        List<Object> args = new ArrayList<>();
        if (deptId != null) { query += " AND s.department_id = ?"; args.add(deptId); }
        if (!semStr.isBlank()) { query += " AND s.semester = ?"; args.add(Integer.parseInt(semStr)); }
        query += " ORDER BY s.semester, s.code";

        List<Map<String, Object>> list = new ArrayList<>();
        try (var st = sql(db, query, args.toArray());
             var rs = st.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> sub = new LinkedHashMap<>();
                sub.put("id", String.valueOf(rs.getLong(1)));
                sub.put("code", rs.getString(2));
                sub.put("name", rs.getString(3));
                sub.put("semesterNumber", rs.getInt(4));
                sub.put("departmentId", String.valueOf(rs.getLong(5)));
                sub.put("academicYearId", rs.getString(6) != null ? rs.getString(6) : "2026-27");
                sub.put("moduleCount", rs.getInt(7));

                List<String> secList = new ArrayList<>();
                Array arr = rs.getArray(9);
                if (arr != null) {
                    Object obj = arr.getArray();
                    if (obj instanceof String[] sa) {
                        secList.addAll(Arrays.asList(sa));
                    } else if (obj instanceof Object[] oa) {
                        for (Object o : oa) if (o != null) secList.add(o.toString());
                    }
                }
                if (secList.isEmpty()) {
                    secList = List.of("All Sections");
                }
                sub.put("applicableSections", secList);
                String rawStatus = rs.getString(8);
                sub.put("status", "ARCHIVED".equalsIgnoreCase(rawStatus) ? "Archived" : "Active");
                list.add(sub);
            }
        }
        return v1Success(list, "Subjects loaded");
    }

    static String createV1HodSubject(Connection db, User user, Form form) throws SQLException {
        user.require("HOD", "PRINCIPAL", "ADMIN");
        Long deptId = user.departmentId();
        if (deptId == null && !form.get("departmentId").isBlank()) {
            deptId = form.id("departmentId");
        }
        check(deptId != null, 403, "Authenticated department scope is required");

        String code = form.need("code").trim();
        String name = form.need("name").trim();
        int sem = form.number("semesterNumber");
        check(sem >= 1 && sem <= 8, 400, "Semester must be between 1 and 8");

        int moduleCount = 5;
        if (!form.get("moduleCount").isBlank()) {
            moduleCount = form.number("moduleCount");
            check(moduleCount >= 1 && moduleCount <= 12, 400, "Module count must be between 1 and 12");
        }

        // Enforce uniqueness within department and semester
        String duplicate = one(db, "SELECT id FROM subject WHERE department_id = ? AND semester = ? AND UPPER(code) = ?", deptId, sem, code);
        check(duplicate.isEmpty(), 409, "Subject code " + code + " already exists in this department for semester " + sem);

        List<String> secList = List.of("All Sections");
        Array secArray = db.createArrayOf("text", secList.toArray());

        long subId = insert(db, """
                INSERT INTO subject(code, name, department_id, semester, module_count, status, applicable_sections)
                VALUES (?, ?, ?, ?, ?, 'ACTIVE', ?)
                """, code, name, deptId, sem, moduleCount, secArray);

        Map<String, Object> sub = new LinkedHashMap<>();
        sub.put("id", String.valueOf(subId));
        sub.put("code", code);
        sub.put("name", name);
        sub.put("semesterNumber", sem);
        sub.put("departmentId", String.valueOf(deptId));
        sub.put("academicYearId", "2026-27");
        sub.put("moduleCount", moduleCount);
        sub.put("applicableSections", secList);
        sub.put("status", "Active");

        audit(db, user.id(), "CREATE_SUBJECT", "subject:" + subId, "Created " + code + " - " + name + " (Modules: " + moduleCount + ", Sem: " + sem + ")");
        return v1Success(sub, "Subject created successfully");
    }

    static String updateV1HodSubject(Connection db, User user, long subjectId, Form form) throws SQLException {
        user.require("HOD", "PRINCIPAL", "ADMIN");
        String deptIdStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!deptIdStr.isEmpty(), 404, "Subject not found");
        if (user.role().equalsIgnoreCase("HOD")) {
            user.checkDepartment(Long.parseLong(deptIdStr));
        }
        long deptId = Long.parseLong(deptIdStr);
        int sem = Integer.parseInt(one(db, "SELECT semester FROM subject WHERE id=?", subjectId));

        String code = form.need("code").trim();
        String name = form.need("name").trim();
        int moduleCount = 5;
        if (!form.get("moduleCount").isBlank()) {
            moduleCount = form.number("moduleCount");
            check(moduleCount >= 1 && moduleCount <= 12, 400, "Module count must be between 1 and 12");
        } else {
            String existingMc = one(db, "SELECT module_count FROM subject WHERE id = ?", subjectId);
            if (!existingMc.isEmpty()) moduleCount = Integer.parseInt(existingMc);
        }

        String duplicate = one(db, "SELECT id FROM subject WHERE department_id = ? AND semester = ? AND UPPER(code) = ? AND id != ?", deptId, sem, code, subjectId);
        check(duplicate.isEmpty(), 409, "Subject code " + code + " already exists in this department for semester " + sem);

        run(db, "UPDATE subject SET code=?, name=?, module_count=? WHERE id=?", code, name, moduleCount, subjectId);
        audit(db, user.id(), "UPDATE_SUBJECT", "subject:" + subjectId, "Updated " + code + " - " + name + " (Modules: " + moduleCount + ")");
        Map<String, Object> sub = new LinkedHashMap<>();
        sub.put("id", String.valueOf(subjectId));
        sub.put("code", code);
        sub.put("name", name);
        sub.put("semesterNumber", sem);
        sub.put("moduleCount", moduleCount);
        sub.put("departmentId", String.valueOf(deptId));
        return v1Success(sub, "Subject updated successfully");
    }

    static String toggleV1HodSubjectStatus(Connection db, User user, long subjectId, Form form) throws SQLException {
        user.require("HOD", "PRINCIPAL", "ADMIN");
        String deptIdStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!deptIdStr.isEmpty(), 404, "Subject not found");
        if (user.role().equalsIgnoreCase("HOD")) {
            user.checkDepartment(Long.parseLong(deptIdStr));
        }

        String reqStatus = form.need("status").trim().toUpperCase(Locale.ROOT);
        String nextStatus = reqStatus.equalsIgnoreCase("ARCHIVED") ? "ARCHIVED" : "ACTIVE";
        run(db, "UPDATE subject SET status = ? WHERE id = ?", nextStatus, subjectId);
        audit(db, user.id(), "TOGGLE_SUBJECT_STATUS", "subject:" + subjectId, "Changed subject status to " + nextStatus);
        Map<String, Object> sub = new LinkedHashMap<>();
        sub.put("id", String.valueOf(subjectId));
        sub.put("status", nextStatus.equalsIgnoreCase("ARCHIVED") ? "Archived" : "Active");
        return v1Success(sub, "Subject status updated to " + nextStatus);
    }

    static String deleteV1HodSubject(Connection db, User user, long subjectId) throws SQLException {
        user.require("HOD", "PRINCIPAL", "ADMIN");
        String deptIdStr = one(db, "SELECT department_id FROM subject WHERE id=?", subjectId);
        check(!deptIdStr.isEmpty(), 404, "Subject not found");
        if (user.role().equalsIgnoreCase("HOD")) {
            user.checkDepartment(Long.parseLong(deptIdStr));
        }

        String subCode = one(db, "SELECT code FROM subject WHERE id=?", subjectId);

        // Safe lifecycle transition: Set status to ARCHIVED. ZERO PHYSICAL DELETION.
        run(db, "UPDATE subject SET status = 'ARCHIVED' WHERE id = ?", subjectId);
        audit(db, user.id(), "ARCHIVE_SUBJECT", "subject:" + subjectId, "Archived subject " + subCode + ". Historical examination records preserved.");
        return v1Success(Map.of("deletedId", String.valueOf(subjectId), "id", String.valueOf(subjectId), "code", subCode, "status", "Archived", "deleted", false, "archived", true), "Subject archived successfully. Historical examination records preserved.");
    }

    static String normalizeDobString(String dob) {
        if (dob == null) return "";
        dob = dob.trim().replaceAll("[T\\s].*$", "").trim();
        if (dob.matches("^\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}$")) {
            String[] parts = dob.split("[-/]");
            return String.format("%04d-%02d-%02d", Integer.parseInt(parts[0]), Integer.parseInt(parts[1]), Integer.parseInt(parts[2]));
        }
        if (dob.matches("^\\d{1,2}[-/]\\d{1,2}[-/]\\d{4}$")) {
            String[] parts = dob.split("[-/]");
            return String.format("%04d-%02d-%02d", Integer.parseInt(parts[2]), Integer.parseInt(parts[1]), Integer.parseInt(parts[0]));
        }
        return dob;
    }

