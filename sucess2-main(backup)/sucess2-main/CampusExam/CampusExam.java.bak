    // --- DATABASE UTILS ---
    static Connection connect() throws SQLException {
        return DriverManager.getConnection(env("DB_URL", "jdbc:postgresql://localhost:5432/campusexam_test"),
            env("DB_USER", "campusexam"), env("DB_PASSWORD", "password"));
    }

    static String env(String key, String fallback) { return System.getenv().getOrDefault(key, fallback); }

    public static void main(String[] args) throws Exception {
        if (args.length > 0 && "--init-keys".equals(args[0])) {
            Crypto.init();
            System.out.println("[Setup] Cryptographic keys verified and initialized successfully.");
            return;
        }
        Crypto.init();
        // Database connection and isolation check
        try (Connection db = connect()) {
            try (Statement st = db.createStatement(); ResultSet rs = st.executeQuery("SELECT current_database()")) {
                if (rs.next()) {
                    String currentDb = rs.getString(1);
                    String expectedDb = env("DB_NAME", env("EXPECTED_DB", "campusexam_test"));
                    boolean allowAnyDb = "true".equalsIgnoreCase(env("ALLOW_ANY_DB", "false"));
                    if (!allowAnyDb && !expectedDb.equalsIgnoreCase(currentDb)) {
                        System.err.println("FATAL STARTUP CHECK FAILED: Connected to '" + currentDb + "' instead of expected '" + expectedDb + "'! Set DB_NAME=" + currentDb + " or ALLOW_ANY_DB=true to override. Aborting.");
                        System.exit(1);
                    }
                    System.out.println("[Startup] Database isolation confirmed: Connected to '" + currentDb + "'");
                }
            }
            if ("true".equalsIgnoreCase(env("BOOTSTRAP_OFFICIAL_ACCOUNTS", "false"))) {
                try {
                    bootstrapOfficialAccounts(db);
                    System.out.println("[Startup] Official accounts bootstrap completed.");
                } catch (Exception e) {
                    System.out.println("[Startup] Notice: Core accounts bootstrap - " + e.getMessage());
                }
            } else {
                System.out.println("[Startup] Official accounts bootstrap skipped.");
            }
        }
        int port = Integer.parseInt(env("PORT", "8081"));
        int backlog = Integer.parseInt(env("SERVER_BACKLOG", "1024"));
        int threads = Integer.parseInt(env("SERVER_THREADS", "32"));
        HttpServer server = HttpServer.create(new InetSocketAddress(env("BIND", "127.0.0.1"), port), backlog);
        server.createContext("/api/", CampusExam::handle);
        server.createContext("/lab-api/", CampusExam::handle);
        server.createContext("/monitoring/", CampusExam::handle);
        server.createContext("/labs/", CampusExam::handle);
        server.createContext("/", CampusExam::handleStatic);
        server.setExecutor(Executors.newFixedThreadPool(threads));
        Executors.newSingleThreadScheduledExecutor().scheduleWithFixedDelay(CampusExam::expire, 0, 2, TimeUnit.SECONDS);
        server.start();
        System.out.println("MIT Mysore Examination System listening on " + server.getAddress());
    }

    static void handleStatic(HttpExchange exchange) throws IOException {
        String path = exchange.getRequestURI().getPath();
        if (path.equals("/") || path.equals("/index.html")) {
            byte[] bytes = Files.readAllBytes(Path.of("index.html"));
            exchange.getResponseHeaders().set("Content-Type", "text/html; charset=utf-8");
            exchange.sendResponseHeaders(200, bytes.length);
            try (var out = exchange.getResponseBody()) { out.write(bytes); }
        } else if (path.equals("/app.html")) {
            byte[] bytes = Files.readAllBytes(Path.of("app.html"));
            exchange.getResponseHeaders().set("Content-Type", "text/html; charset=utf-8");
            exchange.sendResponseHeaders(200, bytes.length);
            try (var out = exchange.getResponseBody()) { out.write(bytes); }
        } else {
            exchange.sendResponseHeaders(404, -1);
        }
    }

    // --- CENTRAL SSE REAL-TIME SYSTEM ---
    public static class CentralSseClient {
        final HttpExchange exchange;
        final OutputStream os;
        final Long userId;
        final String role;
        final Long departmentId;
        final String username;
        volatile boolean closed = false;

        CentralSseClient(HttpExchange exchange, OutputStream os, Long userId, String role, Long departmentId, String username) {
            this.exchange = exchange;
            this.os = os;
            this.userId = userId;
            this.role = role;
            this.departmentId = departmentId;
            this.username = username;
        }

        synchronized boolean send(String event, String data) {
            if (closed) return false;
            try {
                StringBuilder sb = new StringBuilder();
                if (event != null && !event.isEmpty()) {
                    sb.append("event: ").append(event).append("\n");
                }
                sb.append("data: ").append(data.replace("\r", "").replace("\n", "\ndata: ")).append("\n\n");
                os.write(sb.toString().getBytes(StandardCharsets.UTF_8));
                os.flush();
                return true;
            } catch (Exception e) {
                closed = true;
                try { exchange.close(); } catch (Exception ignored) {}
                return false;
            }
        }

        synchronized boolean sendComment(String comment) {
            if (closed) return false;
            try {
                os.write((": " + comment + "\n\n").getBytes(StandardCharsets.UTF_8));
                os.flush();
                return true;
            } catch (Exception e) {
                closed = true;
                try { exchange.close(); } catch (Exception ignored) {}
                return false;
            }
        }
    }

    public static final List<CentralSseClient> centralSseClients = new CopyOnWriteArrayList<>();

    static {
        Thread sseHeartbeat = new Thread(() -> {
            while (true) {
                try {
                    Thread.sleep(15000);
                    for (CentralSseClient c : centralSseClients) {
                        if (!c.sendComment("keepalive")) {
                            centralSseClients.remove(c);
                        }
                    }
                } catch (InterruptedException e) {
                    break;
                } catch (Exception ignored) {}
            }
        }, "central-sse-heartbeat");
        sseHeartbeat.setDaemon(true);
        sseHeartbeat.start();
    }

    public static void broadcastCentralEvent(String eventType, Map<String, Object> payload) {
        if (payload == null) payload = new LinkedHashMap<>();
        Map<String, Object> copy = new LinkedHashMap<>(payload);
        if (!copy.containsKey("type")) copy.put("type", eventType);
        if (!copy.containsKey("eventType")) copy.put("eventType", eventType);
        if (!copy.containsKey("timestamp")) copy.put("timestamp", Instant.now().toString());
        String json = Json.stringify(copy);
        List<CentralSseClient> dead = new ArrayList<>();
        for (CentralSseClient c : centralSseClients) {
            boolean ok1 = c.send(eventType, json);
            boolean ok2 = c.send("message", json);
            if (!ok1 && !ok2) {
                dead.add(c);
            }
        }
        centralSseClients.removeAll(dead);
    }

    static void handleCentralSseStream(Connection db, HttpExchange exchange, Form form) {
        try {
            exchange.getResponseHeaders().set("Access-Control-Allow-Origin", "*");
            exchange.getResponseHeaders().set("Access-Control-Allow-Methods", "GET, OPTIONS");
            exchange.getResponseHeaders().set("Access-Control-Allow-Headers", "*");
            exchange.getResponseHeaders().set("Content-Type", "text/event-stream; charset=UTF-8");
            exchange.getResponseHeaders().set("Cache-Control", "no-cache, no-transform");
            exchange.getResponseHeaders().set("Connection", "keep-alive");
            exchange.getResponseHeaders().set("X-Accel-Buffering", "no");

            String rawToken = null;
            String authHdr = exchange.getRequestHeaders().getFirst("Authorization");
            if (authHdr != null && authHdr.regionMatches(true, 0, "Bearer ", 0, 7)) {
                rawToken = authHdr.substring(7).trim();
            }
            if (rawToken == null || rawToken.isBlank()) {
                rawToken = form.get("token").trim();
            }
            if (rawToken == null || rawToken.isBlank()) {
                String query = exchange.getRequestURI().getRawQuery();
                if (query != null) {
                    for (String pair : query.split("&")) {
                        String[] kv = pair.split("=", 2);
                        if (kv.length == 2 && kv[0].equalsIgnoreCase("token")) {
                            rawToken = URLDecoder.decode(kv[1], StandardCharsets.UTF_8).trim();
                            break;
                        }
                    }
                }
            }

            Long userId = null;
            String role = "ANONYMOUS";
            Long deptId = null;
            String username = "guest";

            if (rawToken != null && rawToken.matches("[a-fA-F0-9]{64}")) {
                try {
                    String digest = digest(rawToken);
                    User u = authenticate(db, digest);
                    if (u != null) {
                        userId = u.id();
                        role = u.role();
                        deptId = u.departmentId();
                        username = u.username();
                    }
                } catch (Exception ignored) {}
            }

            exchange.sendResponseHeaders(200, 0);
            OutputStream os = exchange.getResponseBody();
            CentralSseClient client = new CentralSseClient(exchange, os, userId, role, deptId, username);
            centralSseClients.add(client);

            Map<String, Object> welcome = new LinkedHashMap<>();
            welcome.put("type", "CONNECTED");
            welcome.put("role", role);
            welcome.put("username", username);
            welcome.put("timestamp", Instant.now().toString());
            String json = Json.stringify(welcome);
            client.send("connected", json);
            client.send("message", json);
        } catch (Exception e) {
            System.err.println("[Central SSE] Connection error: " + e.getMessage());
        }
    }

    static void handle(HttpExchange exchange) throws IOException {
        exchange.getResponseHeaders().set("Access-Control-Allow-Origin", "*");
        exchange.getResponseHeaders().set("Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS");
        exchange.getResponseHeaders().set("Access-Control-Allow-Headers", "Content-Type, Authorization, Accept, X-Requested-With, x-hod-user-id, x-hod-department-id, x-hod-department-code, x-hod-user-name");

        if (exchange.getRequestMethod().equalsIgnoreCase("OPTIONS")) {
            exchange.sendResponseHeaders(204, -1);
            return;
        }

        int status = 200;
        String response = null;
        byte[] binaryResponse = null;
        boolean isV1 = false;
        try {
            String fullPath = exchange.getRequestURI().getPath();
            String path = fullPath;
            if (fullPath.startsWith("/api/")) path = fullPath.substring(5);
            else if (fullPath.startsWith("/lab-api/")) path = fullPath.substring(9);
            else if (fullPath.startsWith("/monitoring/")) path = fullPath.substring(1);
            else if (fullPath.startsWith("/labs/")) path = fullPath.substring(1);
            else if (fullPath.startsWith("/")) path = fullPath.substring(1);
            while (path.endsWith("/") && path.length() > 1) path = path.substring(0, path.length() - 1);
            isV1 = path.startsWith("v1/");
            String method = exchange.getRequestMethod().toUpperCase(Locale.ROOT);
            check(method.equals("GET") || method.equals("POST") || method.equals("PUT") || method.equals("PATCH") || method.equals("DELETE"), 405, "Method not allowed: " + method);

            byte[] body = exchange.getRequestBody().readNBytes(57671680); // support up to 55MB for 50MB PDF uploads
            check(body.length <= 57671679, 413, "Request payload exceeds 50MB upload limit");

            String contentType = exchange.getRequestHeaders().getFirst("Content-Type");
            Form form = parseBody(method, contentType, body, exchange.getRequestURI().getRawQuery());

            if ((path.equals("v1/health") || path.equals("health")) && method.equals("GET")) {
                byte[] resBytes = (isV1 ? v1Success(Map.of("status", "ok"), "System operational") : "{\"status\":\"ok\"}").getBytes(StandardCharsets.UTF_8);
                exchange.getResponseHeaders().set("Content-Type", "application/json; charset=utf-8");
                exchange.sendResponseHeaders(200, resBytes.length);
                exchange.getResponseBody().write(resBytes);
                exchange.getResponseBody().close();
                return;
            }

            try (Connection db = connect()) {
                db.setAutoCommit(false);
                try {
                    if (isV1) {
                        String v1Path = path.substring(3);
                        while (v1Path.endsWith("/") && v1Path.length() > 1) v1Path = v1Path.substring(0, v1Path.length() - 1);
                        if (v1Path.equals("health") && method.equals("GET")) {
                            response = v1Success(Map.of("status", "ok"), "System operational");
                        } else if ((v1Path.equals("events") || v1Path.equals("monitoring/events")) && method.equals("GET")) {
                            handleCentralSseStream(db, exchange, form);
                            response = null;
                            binaryResponse = null;
                            return;
                        } else if ((v1Path.equals("events/broadcast") || v1Path.equals("monitoring/events/broadcast")) && method.equals("POST")) {
                            String evtType = form.get("eventType").isBlank() ? form.get("type") : form.get("eventType");
                            if (evtType.isBlank()) evtType = "CENTRAL_EVENT";
                            Map<String, Object> data = form.obj("data");
                            if (data.isEmpty()) data = new LinkedHashMap<>(form.values);
                            broadcastCentralEvent(evtType, data);
                            response = v1Success(Map.of("broadcasted", true), "Event broadcasted");
                        } else if (v1Path.equals("auth/login") && method.equals("POST")) {
                            response = v1Login(db, form);
                        } else if (v1Path.equals("auth/coe/login") && method.equals("POST")) {
                            response = v1CoeLogin(db, form);
                        } else if (v1Path.equals("student/login") && method.equals("POST")) {
                            response = studentLogin(form);
                        } else if (v1Path.equals("instructor/login") && method.equals("POST")) {
                            response = instructorLogin(db, form);
                        } else if (v1Path.equals("labs/servers") && method.equals("GET")) {
                            response = getV1LabServers(db, null);
                        } else if (v1Path.equals("monitoring/sessions") && method.equals("GET")) {
                            response = getV1MonitoringSessions(db, null);
                        } else if (v1Path.startsWith("monitoring/sessions/") && method.equals("GET")) {
                            response = getV1MonitoringSessionById(db, null, v1Path.substring("monitoring/sessions/".length()));
                        } else if (v1Path.startsWith("labs/") && v1Path.contains("/package-receipt") && method.equals("GET")) {
                            response = getV1LabPackageReceipt(db, v1Path);
                        } else {
                            String labResp = dispatchStudentAndLab(db, method, v1Path, form, exchange);
                            if (labResp != null) {
                                response = labResp;
                            } else {
                                String token = exchange.getRequestHeaders().getFirst("Authorization");
                                check(token != null && token.regionMatches(true, 0, "Bearer ", 0, 7), 401, "Sign in required");
                                String rawToken = token.substring(7).trim();
                                check(rawToken.matches("[a-fA-F0-9]{64}"), 401, "Invalid session token");
                                String digest = digest(rawToken);
                                User user = authenticate(db, digest);
                                response = dispatchV1(db, user, method, v1Path, form, digest, exchange);
                            }
                        }
                    } else {
                        // Unversioned legacy /api/* and Stage 3 student/lab routes
                        if (path.equals("health") && method.equals("GET")) {
                            response = "{\"status\":\"ok\"}";
                        } else if ((path.equals("events") || path.equals("monitoring/events")) && method.equals("GET")) {
                            handleCentralSseStream(db, exchange, form);
                            response = null;
                            binaryResponse = null;
                            return;
                        } else if (path.equals("events/broadcast") && method.equals("POST")) {
                            String evtType = form.get("eventType").isBlank() ? form.get("type") : form.get("eventType");
                            if (evtType.isBlank()) evtType = "CENTRAL_EVENT";
                            Map<String, Object> data = form.obj("data");
                            if (data.isEmpty()) data = new LinkedHashMap<>(form.values);
                            broadcastCentralEvent(evtType, data);
                            response = v1Success(Map.of("broadcasted", true), "Event broadcasted");
                        } else if ((path.equals("login") || path.equals("auth/login")) && method.equals("POST")) {
                            response = path.equals("auth/login") ? v1Login(db, form) : login(db, form);
                        } else if (path.equals("auth/coe/login") && method.equals("POST")) {
                            response = v1CoeLogin(db, form);
                        } else if (path.equals("student/login") && method.equals("POST")) {
                            response = studentLogin(form);
                        } else if (path.equals("instructor/login") && method.equals("POST")) {
                            response = instructorLogin(db, form);
                        } else if (path.equals("labs/servers") && method.equals("GET")) {
                            response = getV1LabServers(db, null);
                        } else if (path.equals("monitoring/sessions") && method.equals("GET")) {
                            response = getV1MonitoringSessions(db, null);
                        } else if (path.startsWith("monitoring/sessions/") && method.equals("GET")) {
                            response = getV1MonitoringSessionById(db, null, path.substring("monitoring/sessions/".length()));
                        } else {
                            String labResp = dispatchStudentAndLab(db, method, path, form, exchange);
                            if (labResp != null) {
                                response = labResp;
                            } else {
                                String token = exchange.getRequestHeaders().getFirst("Authorization");
                                check(token != null && token.matches("Bearer [a-f0-9]{64}"), 401, "Sign in required");
                                String digest = digest(token.substring(7));
                                User user = authenticate(db, digest);
                                response = method.equals("GET") ? dispatchGet(db, user, path, form) : dispatchPost(db, user, path, form, digest);
                            }
                        }
                    }
                    db.commit();
                } catch (Exception failure) {
                    db.rollback();
                    throw failure;
                }
            }
        } catch (Problem failure) {
            status = failure.status;
            String errCode = (failure.code != null && !failure.code.isBlank())
                    ? failure.code
                    : (status == 401 ? "UNAUTHORIZED" : status == 403 ? "FORBIDDEN" : status == 404 ? "NOT_FOUND" : status == 409 ? "CONFLICT" : "BAD_REQUEST");
            response = isV1
                    ? v1Error(errCode, failure.getMessage(), failure.extra)
                    : errorWithCode(errCode, failure.getMessage(), failure.extra);
        } catch (SecurityException failure) {
            status = 403;
            response = isV1 ? v1Error("FORBIDDEN", failure.getMessage()) : error(failure.getMessage());
        } catch (IllegalStateException failure) {
            status = 409;
            response = isV1 ? v1Error("CONFLICT", failure.getMessage()) : error(failure.getMessage());
        } catch (IllegalArgumentException | java.time.DateTimeException failure) {
            status = 400;
            response = isV1 ? v1Error("BAD_REQUEST", "Invalid field value: " + failure.getMessage()) : error("Invalid field value: " + failure.getMessage());
        } catch (SQLException failure) {
            System.err.println("[CampusExam] Database error (" + failure.getSQLState() + "): " + failure.getMessage());
            failure.printStackTrace();
            String state = failure.getSQLState();
            status = "23505".equals(state) ? 409 : state != null && (state.startsWith("22") || state.startsWith("23")) ? 400 : 503;
            String rawMsg = status == 409 ? "Duplicate record or conflict: " + failure.getMessage() : status == 400 ? "Database constraint violation: " + failure.getMessage() : "Database error: " + failure.getMessage();
            String msg = SecuritySanitizer.sanitizeErrorMessage(rawMsg);
            response = isV1 ? v1Error(status == 409 ? "CONFLICT" : status == 400 ? "VALIDATION_ERROR" : "DATABASE_ERROR", msg) : error(msg);
        } catch (Exception failure) {
            status = 500;
            failure.printStackTrace();
            response = isV1 ? v1Error("INTERNAL_ERROR", "Internal server error: " + failure.getMessage()) : error("Internal server error: " + failure.getMessage());
        }

        // Check if a binary response (e.g. PDF download) was prepared
        if (response != null && response.startsWith("__BINARY_RESPONSE__:")) {
            String docIdStr = response.substring("__BINARY_RESPONSE__:".length());
            try (Connection db = connect()) {
                byte[] pdfBytes = null;
                try (var st = sql(db, "SELECT pdf_blob, file_name FROM course_outcome_revision WHERE id = ?", Long.parseLong(docIdStr));
                     var rs = st.executeQuery()) {
                    if (rs.next()) {
                        pdfBytes = rs.getBytes(1);
                        String fname = rs.getString(2);
                        exchange.getResponseHeaders().set("Content-Type", "application/pdf");
                        exchange.getResponseHeaders().set("Content-Disposition", "inline; filename=\"" + fname + "\"");
                    }
                }
                if (pdfBytes != null) {
                    binaryResponse = pdfBytes;
                    response = null;
                } else {
                    response = v1Error("NOT_FOUND", "Document not found");
                    status = 404;
                }
            } catch (Exception e) {
                response = v1Error("DATABASE_ERROR", "Unable to load document: " + e.getMessage());
                status = 500;
            }
        } else if (response != null && (response.startsWith("__QUESTION_PAPER_PDF__:") || response.startsWith("__QUESTION_PAPER_XLSX__:"))) {
            boolean isExcel = response.startsWith("__QUESTION_PAPER_XLSX__:");
            String prefix = isExcel ? "__QUESTION_PAPER_XLSX__:" : "__QUESTION_PAPER_PDF__:";
            String[] parts = response.substring(prefix.length()).split(":");
            long eid = Long.parseLong(parts[0]);
            String sitName = parts.length > 1 ? parts[1].toUpperCase(Locale.ROOT) : "MORNING";
            if (sitName.endsWith("-M") || sitName.contains("MORN")) sitName = "MORNING";
            else if (sitName.endsWith("-A") || sitName.contains("AFT")) sitName = "AFTERNOON";
            try (Connection db = connect()) {
                Map<String, Object> archiveData = fetchArchiveData(db, eid, sitName);
                @SuppressWarnings("unchecked")
                Map<String, Object> meta = (Map<String, Object>) archiveData.get("metadata");
                @SuppressWarnings("unchecked")
                List<Map<String, Object>> questions = (List<Map<String, Object>>) archiveData.get("questions");
                String subCode = String.valueOf(meta.getOrDefault("subjectCode", "CS301"));
                int setNum = meta.get("paperSetNumber") instanceof Number n ? n.intValue() : 1;

                if (isExcel) {
                    byte[] xlsxBytes = buildQuestionPaperXlsxBytes(meta, questions);
                    exchange.getResponseHeaders().set("Content-Type", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
                    exchange.getResponseHeaders().set("Content-Disposition", "attachment; filename=\"" + subCode + "_Set_" + setNum + "_Archive.xlsx\"");
                    binaryResponse = xlsxBytes;
                    response = null;
                } else {
                    byte[] pdfBytes = generateQuestionPaperPdf(meta, questions);
                    exchange.getResponseHeaders().set("Content-Type", "application/pdf");
                    exchange.getResponseHeaders().set("Content-Disposition", "attachment; filename=\"" + subCode + "_Set_" + setNum + "_Archive.pdf\"");
                    binaryResponse = pdfBytes;
                    response = null;
                }
            } catch (Exception e) {
                response = v1Error("EXPORT_GENERATION_ERROR", "Failed to generate question paper archive: " + e.getMessage());
                status = 500;
            }
        }

        if (response == null && binaryResponse == null) {
            return;
        }

        byte[] bytes = binaryResponse != null ? binaryResponse : response.getBytes(StandardCharsets.UTF_8);
        if (binaryResponse == null) {
            exchange.getResponseHeaders().set("Content-Type", "application/json; charset=utf-8");
        }
        exchange.getResponseHeaders().set("Cache-Control", "no-store");
        exchange.getResponseHeaders().set("X-Content-Type-Options", "nosniff");
        exchange.sendResponseHeaders(status, bytes.length);
        try (var output = exchange.getResponseBody()) { output.write(bytes); }
    }

    @SuppressWarnings("unchecked")
    static Form parseBody(String method, String contentType, byte[] body, String rawQuery) {
        Map<String, Object> map = new LinkedHashMap<>();
        if (rawQuery != null && !rawQuery.isEmpty()) {
            for (String part : rawQuery.split("&")) {
                String[] field = part.split("=", 2);
                if (field.length == 2) {
                    map.put(URLDecoder.decode(field[0], StandardCharsets.UTF_8),
                            URLDecoder.decode(field[1], StandardCharsets.UTF_8));
                }
            }
        }
        if (body != null && body.length > 0) {
            map.put("__body_bytes__", body);
            if (contentType != null && contentType.toLowerCase().contains("multipart/form-data")) {
                parseMultipart(body, contentType, map);
            } else if (contentType != null && contentType.toLowerCase().contains("application/json")) {
                String bodyStr = new String(body, StandardCharsets.UTF_8);
                Object parsed = Json.parse(bodyStr);
                if (parsed instanceof Map) map.putAll((Map<String, Object>) parsed);
            } else if (contentType != null && (contentType.toLowerCase().contains("application/octet-stream") || contentType.toLowerCase().contains("application/zip"))) {
                map.put("__file_bytes__", body);
            } else {
                String bodyStr = new String(body, StandardCharsets.UTF_8);
                for (String part : bodyStr.split("&")) {
                    String[] field = part.split("=", 2);
                    if (field.length == 2) {
                        map.put(URLDecoder.decode(field[0], StandardCharsets.UTF_8),
                                URLDecoder.decode(field[1], StandardCharsets.UTF_8));
                    }
                }
            }
        }
        return new Form(map);
    }

    static void parseMultipart(byte[] body, String contentType, Map<String, Object> map) {
        try {
            String boundary = null;
            for (String param : contentType.split(";")) {
                param = param.trim();
                if (param.toLowerCase().startsWith("boundary=")) {
                    boundary = param.substring(9).trim();
                    if (boundary.startsWith("\"") && boundary.endsWith("\"")) {
                        boundary = boundary.substring(1, boundary.length() - 1);
                    }
                }
            }
            if (boundary == null) return;
            byte[] boundaryBytes = ("--" + boundary).getBytes(StandardCharsets.ISO_8859_1);

            List<Integer> positions = new ArrayList<>();
            for (int i = 0; i <= body.length - boundaryBytes.length; i++) {
                boolean match = true;
                for (int j = 0; j < boundaryBytes.length; j++) {
                    if (body[i + j] != boundaryBytes[j]) { match = false; break; }
                }
                if (match) positions.add(i);
            }

            for (int p = 0; p < positions.size() - 1; p++) {
                int start = positions.get(p) + boundaryBytes.length;
                int end = positions.get(p + 1);
                if (start < body.length && body[start] == '\r') start++;
                if (start < body.length && body[start] == '\n') start++;
                if (end > 0 && body[end - 1] == '\n') end--;
                if (end > 0 && body[end - 1] == '\r') end--;
                if (start >= end) continue;

                int headerEnd = -1;
                for (int i = start; i <= end - 4; i++) {
                    if (body[i] == '\r' && body[i+1] == '\n' && body[i+2] == '\r' && body[i+3] == '\n') {
                        headerEnd = i;
                        break;
                    }
                }
                if (headerEnd == -1) continue;

                String headers = new String(body, start, headerEnd - start, StandardCharsets.UTF_8);
                int bodyStart = headerEnd + 4;
                int bodyLen = end - bodyStart;

                String name = null;
                String filename = null;
                Matcher mName = Pattern.compile("name=\"([^\"]+)\"").matcher(headers);
                if (mName.find()) name = mName.group(1);
                Matcher mFile = Pattern.compile("filename=\"([^\"]+)\"").matcher(headers);
                if (mFile.find()) filename = mFile.group(1);

                if (name != null) {
                    if (filename != null) {
                        byte[] fileBytes = new byte[bodyLen];
                        System.arraycopy(body, bodyStart, fileBytes, 0, bodyLen);
                        map.put("__file_bytes__", fileBytes);
                        map.put("__file_name__", filename);
                        map.put(name, filename);
                    } else {
                        String value = new String(body, bodyStart, bodyLen, StandardCharsets.UTF_8);
                        map.put(name, value);
                    }
                }
            }
        } catch (Exception ignored) {}
    }

