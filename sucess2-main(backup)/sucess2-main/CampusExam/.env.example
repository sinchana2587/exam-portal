# College PostgreSQL Server Configuration for CampusExam
# Replace the values below with your college database server details:

# Option A: Full JDBC Connection String
DB_URL=jdbc:postgresql://<COLLEGE_SERVER_IP>:5432/campusexam

# Database Credentials
DB_USER=campusexam
DB_PASSWORD=password

# Optional Admin Credentials
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=password1234
