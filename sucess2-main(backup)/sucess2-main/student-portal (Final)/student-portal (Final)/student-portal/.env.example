# =============================================================================
# MIT Mysore Student Examination Portal - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local or .env for custom workstation configuration.
# Never commit credentials or real private keys to source control.

# Base URL for the Lab Server API (supports localhost or college LAN IP)
# Local development default: http://127.0.0.1:8082
VITE_API_URL="http://127.0.0.1:8082"
VITE_LAB_API_BASE_URL="http://127.0.0.1:8082"

# Request timeout in milliseconds before network timeout error is triggered
VITE_API_TIMEOUT_MS=8000

# API Mode: "integration" connects to live REST endpoints
VITE_API_MODE="integration"
